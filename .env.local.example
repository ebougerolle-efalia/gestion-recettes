# Copier en .env.local et adapter — NE PAS commiter !
APP_ENV=prod
APP_SECRET=CHANGEZ-MOI-32-chars
# PostgreSQL. En local : conteneur docker-compose (port hôte 5433).
DATABASE_URL="postgresql://recettes:recettes@127.0.0.1:5433/recettes?serverVersion=17&charset=utf8"

# Gotenberg (génération PDF) — Docker container
GOTENBERG_DSN=http://localhost:3000

# Webhook GitHub : https://gestion-recettes.bougerolle.ovh/webhook.php
WEBHOOK_SECRET=mon-secret-webhook
