APP_ENV=dev
APP_SECRET=change-me-in-env-local
# PostgreSQL du docker-compose (port hôte 5433) — surchargeable dans .env.local.
DATABASE_URL="postgresql://recettes:recettes@127.0.0.1:5433/recettes?serverVersion=17&charset=utf8"
GOTENBERG_DSN=http://localhost:3000
# Boîte de réception des factures, relevée par « app:invoice-fetch ».
# Vide : le canal courriel est inactif, seul le dépôt manuel fonctionne.
# Forme : imap://utilisateur:motdepasse@serveur:993?encryption=ssl&folder=INBOX&archive=Traitees
INVOICE_MAILBOX_DSN=
