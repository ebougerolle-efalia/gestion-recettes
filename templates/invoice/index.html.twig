{% extends 'base.html.twig' %}
{% block title %}Factures d'achat{% endblock %}
{% block page_title %}Factures d'achat{% endblock %}
{% block page_subtitle %}Réception, validation et historique{% endblock %}

{% block body %}

    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <div class="rounded-2xl border border-trait bg-white px-5 py-3">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-ardoise-faible">À valider</p>
                <p class="text-2xl font-bold {{ pending|length ? 'text-laiton-patine' : 'text-ardoise' }} mt-0.5">{{ pending|length }}</p>
            </div>
            <div class="rounded-2xl border border-trait bg-white px-5 py-3">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-ardoise-faible">À saisir</p>
                <p class="text-2xl font-bold {{ to_capture|length ? 'text-laiton-patine' : 'text-ardoise' }} mt-0.5">{{ to_capture|length }}</p>
            </div>
            <div class="rounded-2xl border border-trait bg-white px-5 py-3">
                <p class="text-[10px] font-semibold uppercase tracking-wider text-ardoise-faible">Traitées</p>
                <p class="text-2xl font-bold text-ardoise mt-0.5">{{ processed|length }}</p>
            </div>
        </div>
        <a href="{{ path('app_invoice_import') }}"
           class="inline-flex items-center gap-2 rounded-xl bg-ardoise hover:bg-ardoise-clair px-5 py-2.5 text-sm font-medium text-white">
            <i class="fas fa-file-import text-[11px]"></i> Importer une facture
        </a>
    </div>

    {% if mailbox %}
        <p class="mb-6 text-[11px] text-ardoise-faible">
            <i class="fas fa-inbox mr-1"></i>
            Réception automatique active sur <span class="font-mono">{{ mailbox }}</span>.
            Les factures envoyées à cette adresse arrivent seules dans cette page.
        </p>
    {% endif %}

    {# ── Quarantaine : reçues mais illisibles pour le moteur ── #}
    {% if to_capture is not empty %}
        <div class="rounded-2xl border border-laiton/40 bg-white mb-6">
            <div class="px-6 py-4 border-b border-laiton/40 flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-laiton"></div>
                <h3 class="font-semibold text-[15px] text-ardoise">Reçues, à saisir</h3>
                <span class="text-[11px] text-ardoise-faible">
                    — pièces conservées, mais sans données Factur-X exploitables
                </span>
            </div>

            <div class="divide-y divide-trait-fin">
                {% for invoice in to_capture %}
                    <div class="flex items-center gap-4 px-6 py-4 hover:bg-laiton-voile/30 transition-colors">
                        <div class="flex-1 min-w-0">
                            <p class="font-medium text-sm text-ardoise">
                                {{ invoice.supplier ? invoice.supplier.name : 'Fournisseur à rattacher' }}
                            </p>
                            <p class="text-[11px] text-ardoise-faible mt-0.5 truncate">
                                {{ invoice.displayReference }}
                                · reçue le {{ invoice.importedAt|date('d/m/Y') }}
                                {% if invoice.senderEmail %} · de {{ invoice.senderEmail }}{% endif %}
                            </p>
                        </div>
                        {% if invoice.hasAttachment %}
                            <a href="{{ path('app_invoice_attachment', {id: invoice.id}) }}" target="_blank"
                               class="text-[11px] text-laiton-patine hover:underline flex-shrink-0">
                                <i class="fas fa-file-pdf mr-1"></i>Voir la pièce
                            </a>
                        {% endif %}
                        <a href="{{ path('app_invoice_capture', {id: invoice.id}) }}"
                           class="inline-flex items-center rounded-full bg-laiton-voile px-3 py-1 text-[10px] font-semibold text-laiton-patine hover:bg-laiton-voile flex-shrink-0">
                            Saisir les lignes
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# ── File d'attente ── #}
    <div class="rounded-2xl border border-trait bg-white mb-6">
        <div class="px-6 py-4 border-b border-trait-fin flex items-center gap-2">
            <div class="w-2 h-2 rounded-full {{ pending|length ? 'bg-laiton' : 'bg-trait' }}"></div>
            <h3 class="font-semibold text-[15px] text-ardoise">En attente de validation</h3>
        </div>

        {% if pending is empty %}
            <p class="px-6 py-8 text-center text-sm text-ardoise-faible">
                Rien en attente. Les factures déposées ici attendent votre arbitrage avant de modifier le moindre prix.
            </p>
        {% else %}
            <div class="divide-y divide-trait-fin">
                {% for invoice in pending %}
                    <a href="{{ path('app_invoice_review', {id: invoice.id}) }}"
                       class="flex items-center gap-4 px-6 py-4 hover:bg-voile/40 transition-colors">
                        <div class="flex-1 min-w-0">
                            <p class="font-medium text-sm text-ardoise">{{ invoice.supplier ? invoice.supplier.name : 'Fournisseur inconnu' }}</p>
                            <p class="text-[11px] text-ardoise-faible mt-0.5">
                                {{ invoice.invoiceId }} · {{ invoice.invoiceDate|date('d/m/Y') }}
                                {% if invoice.source != 'manual' %}
                                    · <span class="text-laiton-patine">{{ invoice.source == 'email' ? 'reçue par mail' : 'plateforme' }}</span>
                                {% endif %}
                            </p>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <p class="text-sm font-semibold text-ardoise">
                                {{ invoice.totalHt ? invoice.totalHt|number_format(2, ',', ' ') ~ ' € HT' : '—' }}
                            </p>
                            <p class="text-[11px] text-ardoise-faible">{{ invoice.lines|length }} ligne(s)</p>
                        </div>
                        <span class="inline-flex items-center rounded-full bg-laiton-voile px-2.5 py-1 text-[10px] font-semibold text-laiton-patine flex-shrink-0">
                            À valider
                        </span>
                        <i class="fas fa-chevron-right text-[10px] text-ardoise-faible flex-shrink-0"></i>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# ── Historique ── #}
    <div class="rounded-2xl border border-trait bg-white">
        <div class="px-6 py-4 border-b border-trait-fin">
            <h3 class="font-semibold text-[15px] text-ardoise"><i class="fas fa-clock-rotate-left text-ardoise-faible mr-2 text-sm"></i>Historique</h3>
        </div>

        {% if processed is empty %}
            <p class="px-6 py-8 text-center text-sm text-ardoise-faible">Aucune facture traitée pour le moment.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-voile/70 text-[11px] uppercase tracking-wider text-ardoise-faible">
                        <tr>
                            <th class="px-6 py-3 text-left font-semibold">Fournisseur</th>
                            <th class="px-4 py-3 text-left font-semibold">N°</th>
                            <th class="px-4 py-3 text-left font-semibold">Date</th>
                            <th class="px-4 py-3 text-right font-semibold">Total HT</th>
                            <th class="px-4 py-3 text-right font-semibold">Lignes</th>
                            <th class="px-6 py-3 text-left font-semibold">Statut</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-trait-fin">
                        {% for invoice in processed %}
                            <tr class="hover:bg-voile/50">
                                <td class="px-6 py-3 font-medium text-ardoise">{{ invoice.supplier ? invoice.supplier.name : 'Fournisseur inconnu' }}</td>
                                <td class="px-4 py-3 text-ardoise-doux font-mono text-xs">{{ invoice.displayReference }}</td>
                                <td class="px-4 py-3 text-ardoise-doux">{{ invoice.invoiceDate|date('d/m/Y') }}</td>
                                <td class="px-4 py-3 text-right text-ardoise">
                                    {{ invoice.totalHt ? invoice.totalHt|number_format(2, ',', ' ') ~ ' €' : '—' }}
                                </td>
                                <td class="px-4 py-3 text-right text-ardoise-doux">{{ invoice.lines|length }}</td>
                                <td class="px-6 py-3">
                                    {% if invoice.applied %}
                                        <span class="inline-flex items-center rounded-full bg-pousse-voile px-2.5 py-1 text-[10px] font-semibold text-pousse">
                                            <i class="fas fa-check text-[8px] mr-1"></i>Prix appliqués
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center rounded-full bg-voile px-2.5 py-1 text-[10px] font-semibold text-ardoise-doux"
                                              title="{{ invoice.note }}">
                                            <i class="fas fa-ban text-[8px] mr-1"></i>Écartée
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

{% endblock %}
