{% extends 'base.html.twig' %}
{% block title %}Import facture fournisseur{% endblock %}
{% block page_title %}Import facture fournisseur{% endblock %}
{% block page_subtitle %}Mise à jour automatique des prix ingrédients{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">

    {# Explication du process #}
    <div class="rounded-2xl border border-laiton/30 bg-voile/50 p-5 mb-6 flex gap-4">
        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-ardoise flex items-center justify-center mt-0.5">
            <i class="fas fa-info text-white text-xs"></i>
        </div>
        <div class="text-sm text-ardoise space-y-1">
            <p class="font-semibold">Comment ça marche ?</p>
            <p>Importez la facture électronique de votre fournisseur. L'appli extrait automatiquement les lignes produits et met à jour les prix de vos ingrédients.</p>
            <p class="text-laiton-patine">Formats acceptés : <strong>PDF Factur-X</strong> (PDF avec XML embarqué) ou <strong>XML CII</strong> (fichier .xml pur)</p>
        </div>
    </div>

    {# Étapes #}
    <div class="grid grid-cols-3 gap-3 mb-8">
        {% for step in [
            {num: '1', label: 'Importer la facture', icon: 'fa-upload',    active: true},
            {num: '2', label: 'Vérifier les correspondances', icon: 'fa-check-double', active: false},
            {num: '3', label: 'Prix mis à jour',    icon: 'fa-tags',      active: false},
        ] %}
        <div class="rounded-xl border {{ step.active ? 'border-laiton/40 bg-voile' : 'border-trait bg-white' }} px-4 py-3 text-center">
            <div class="w-7 h-7 rounded-full {{ step.active ? 'bg-ardoise' : 'bg-trait' }} flex items-center justify-center mx-auto mb-2">
                {# Nom de classe ENTIER dans chaque branche — voir confirm.html.twig :
                   une classe assemblée à l'exécution est invisible au compilateur. #}
                <i class="fas {{ step.icon }} {{ step.active ? 'text-white' : 'text-ardoise-faible' }} text-xs"></i>
            </div>
            <p class="text-xs font-medium {{ step.active ? 'text-ardoise-fort' : 'text-ardoise-faible' }}">{{ step.label }}</p>
        </div>
        {% endfor %}
    </div>

    {# Formulaire d'upload #}
    <div class="rounded-2xl border border-trait bg-white">
        <div class="px-6 py-4 border-b border-trait-fin flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-ardoise"></div>
            <h3 class="font-semibold text-sm text-ardoise">Fichier facture</h3>
        </div>
        <form method="post" enctype="multipart/form-data" class="p-6">
            {# Zone de drop #}
            <label for="invoice_file"
                   class="group relative flex flex-col items-center justify-center w-full h-48
                          rounded-xl border-2 border-dashed border-trait bg-voile
                          hover:border-laiton-patine hover:bg-voile/30 cursor-pointer
                          transition-all duration-150"
                   ondragover="this.classList.add('border-laiton/40','bg-voile')"
                   ondragleave="this.classList.remove('border-laiton/40','bg-voile')">

                <input type="file" id="invoice_file" name="invoice_file"
                       accept=".pdf,.xml,application/pdf,application/xml,text/xml"
                       class="sr-only"
                       onchange="updateDropLabel(this)">

                <div id="drop-label" class="text-center pointer-events-none">
                    <i class="fas fa-file-invoice text-3xl text-ardoise-faible mb-3 block"></i>
                    <p class="text-sm font-medium text-ardoise-doux">Glissez votre facture ici</p>
                    <p class="text-xs text-ardoise-faible mt-1">ou cliquez pour sélectionner</p>
                    <p class="text-xs text-ardoise-faible mt-3">
                        <span class="bg-voile text-ardoise-doux rounded px-2 py-0.5 font-mono">PDF</span>
                        <span class="mx-1 text-ardoise-faible">·</span>
                        <span class="bg-voile text-ardoise-doux rounded px-2 py-0.5 font-mono">XML</span>
                    </p>
                </div>
            </label>

            <div id="file-info" class="hidden mt-3 flex items-center gap-3 bg-pousse-voile border border-pousse/30 rounded-xl px-4 py-3">
                <i class="fas fa-file-check text-pousse"></i>
                <div>
                    <p id="file-name" class="text-sm font-medium text-ardoise"></p>
                    <p id="file-size" class="text-xs text-ardoise-faible"></p>
                </div>
            </div>

            <button type="submit"
                    class="mt-5 w-full inline-flex items-center justify-center gap-2 rounded-xl
                           bg-ardoise hover:bg-ardoise-clair px-6 py-3 text-sm font-semibold text-white
                           transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                    id="submit-btn">
                <i class="fas fa-arrow-right text-[12px]"></i>
                Analyser la facture
            </button>
        </form>
    </div>

    {# Aide contexte Chorus Pro #}
    <div class="mt-6 rounded-2xl border border-laiton/40 bg-laiton-voile/40 p-5">
        <p class="text-xs font-semibold text-laiton-patine mb-2"><i class="fas fa-circle-info mr-1.5"></i>Chorus Pro & réforme 2026</p>
        <p class="text-xs text-laiton-patine leading-relaxed">
            Depuis 2020, les factures envoyées aux collectivités publiques (mairies, hôpitaux) passent par Chorus Pro en format Factur-X.
            À partir de 2026-2027, vos <strong>fournisseurs privés</strong> (grossistes viande, épicerie) devront aussi émettre en Factur-X.
            Vous pourrez alors importer directement leurs factures ici pour mettre à jour vos prix automatiquement.
        </p>
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
function updateDropLabel(input) {
    const file = input.files[0];
    if (!file) return;
    document.getElementById('drop-label').classList.add('hidden');
    const info = document.getElementById('file-info');
    info.classList.remove('hidden');
    info.classList.add('flex');
    document.getElementById('file-name').textContent = file.name;
    document.getElementById('file-size').textContent = (file.size / 1024).toFixed(1) + ' Ko';
}
</script>
{% endblock %}
