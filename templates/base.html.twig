<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gestion Recettes{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .chevron-icon { transition: transform 0.2s; }
        .chevron-icon.open { transform: rotate(90deg); }
    </style>
</head>
<body class="h-full overflow-hidden bg-[#f1f5f9]">
<div class="flex h-full">

    {# ===== SIDEBAR ===== #}
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-[280px] bg-[#1c2434] text-white flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-300">
        <div class="px-7 py-6 border-b border-white/[.06]">
            <a href="{{ path('app_recipe_index') }}" class="block">
                <h1 class="text-xl font-bold tracking-tight">{{ boutique().nomEtablissement ?: 'Gestion Recettes' }}</h1>
                <p class="text-[11px] text-gray-400 mt-0.5">{{ boutique().sousTitre ?: 'Gestion des recettes & coûts' }}</p>
            </a>
        </div>

        <nav class="flex-1 overflow-y-auto px-5 py-5 space-y-1.5">

            {# ── PRODUCTION ── #}
            <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-500 px-3 mb-2">Production</p>

            <a href="{{ path('app_recipe_index') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                {{ app.request.attributes.get('_route') starts with 'app_recipe' ? 'bg-white/[.08] text-white' : 'text-gray-400 hover:text-white hover:bg-white/[.04]' }}">
                <i class="fas fa-clipboard-list w-5 text-center text-[13px]"></i> Recettes
            </a>

            <a href="{{ path('app_ingredient_index') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                {{ app.request.attributes.get('_route') starts with 'app_ingredient' ? 'bg-white/[.08] text-white' : 'text-gray-400 hover:text-white hover:bg-white/[.04]' }}">
                <i class="fas fa-carrot w-5 text-center text-[13px]"></i> Ingrédients
            </a>

            {# ── ACHATS ── #}
            {% if is_granted('ROLE_EDITOR') %}
                <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-500 px-3 mt-5 mb-2">Achats</p>

                <a href="{{ path('app_invoice_import') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                {{ app.request.attributes.get('_route') starts with 'app_invoice' ? 'bg-white/[.08] text-white' : 'text-gray-400 hover:text-white hover:bg-white/[.04]' }}">
                    <i class="fas fa-file-import w-5 text-center text-[13px]"></i> Import facture
                </a>
            {% endif %}

            {# ── ADMINISTRATION ── #}
            {% if is_granted('ROLE_ADMIN') %}
                <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-500 px-3 mt-5 mb-2">Administration</p>

                <a href="{{ path('app_admin_index') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                {{ app.request.attributes.get('_route') == 'app_admin_index' ? 'bg-white/[.08] text-white' : 'text-gray-400 hover:text-white hover:bg-white/[.04]' }}">
                    <i class="fas fa-chart-bar w-5 text-center text-[13px]"></i> Tableau de bord
                </a>
                <a href="{{ path('app_admin_categories') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                {{ app.request.attributes.get('_route') == 'app_admin_categories' ? 'bg-white/[.08] text-white' : 'text-gray-400 hover:text-white hover:bg-white/[.04]' }}">
                    <i class="fas fa-tags w-5 text-center text-[13px]"></i> Catégories
                </a>
                <a href="{{ path('app_admin_families') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                {{ app.request.attributes.get('_route') == 'app_admin_families' ? 'bg-white/[.08] text-white' : 'text-gray-400 hover:text-white hover:bg-white/[.04]' }}">
                    <i class="fas fa-layer-group w-5 text-center text-[13px]"></i> Familles
                </a>
                <a href="{{ path('app_admin_users') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                {{ app.request.attributes.get('_route') == 'app_admin_users' ? 'bg-white/[.08] text-white' : 'text-gray-400 hover:text-white hover:bg-white/[.04]' }}">
                    <i class="fas fa-users w-5 text-center text-[13px]"></i> Utilisateurs
                </a>
                <a href="{{ path('app_admin_parametres') }}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                {{ app.request.attributes.get('_route') == 'app_admin_parametres' ? 'bg-white/[.08] text-white' : 'text-gray-400 hover:text-white hover:bg-white/[.04]' }}">
                    <i class="fas fa-store w-5 text-center text-[13px]"></i> Paramètres
                </a>
            {% endif %}
        </nav>

        <div class="border-t border-white/[.06] px-7 py-4">
            {% if app.user %}
                <p class="text-[12px] text-gray-400">{{ app.user.username }} <span class="text-gray-600">({{ app.user.role }})</span></p>
                <a href="{{ path('app_logout') }}" class="text-[11px] text-red-400 hover:text-red-300">Déconnexion</a>
            {% endif %}
        </div>
    </aside>

    {# Overlay mobile #}
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden" onclick="toggleSidebar()"></div>

    {# ===== MAIN ===== #}
    <div class="flex-1 flex flex-col lg:ml-[280px] h-full overflow-hidden">

        {# Header #}
        <header class="flex-shrink-0 z-40 bg-white border-b border-gray-200/80 px-4 lg:px-8 min-h-[72px] h-[72px] flex items-center justify-between shadow-sm overflow-hidden">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="lg:hidden w-9 h-9 flex items-center justify-center rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50">
                    <i class="fas fa-bars text-sm"></i>
                </button>
                <div>
                    <h1 class="text-lg font-semibold text-[#1c2434] leading-tight">{% block page_title %}{% endblock %}</h1>
                    <p class="text-xs text-gray-400 leading-tight h-4">{% block page_subtitle %}{% endblock %}&nbsp;</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                {% block page_actions %}{% endblock %}
            </div>
        </header>

        {# Content - scrollable #}
        <main class="flex-1 overflow-y-auto p-4 lg:p-7">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 flex items-center gap-3 rounded-xl px-5 py-3.5 text-sm border
                    {{ type == 'success' ? 'bg-green-50 border-green-200 text-green-700' : '' }}
                    {{ type == 'danger'  ? 'bg-red-50 border-red-200 text-red-700'       : '' }}
                    {{ type == 'warning' ? 'bg-amber-50 border-amber-200 text-amber-700' : '' }}
                    {{ type == 'info'    ? 'bg-blue-50 border-blue-200 text-blue-700'    : '' }}
                    flash-msg" onclick="this.remove()">
                        <i class="fas fa-{{ type == 'success' ? 'check-circle' : (type == 'danger' ? 'exclamation-circle' : (type == 'info' ? 'info-circle' : 'exclamation-triangle')) }}"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </div>
</div>

<script>
    function toggleSidebar() {
        const s = document.getElementById('sidebar');
        const o = document.getElementById('sidebarOverlay');
        s.classList.toggle('-translate-x-full');
        o.classList.toggle('hidden');
    }
    document.querySelectorAll('.flash-msg').forEach(el => setTimeout(() => el.remove(), 6000));
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
