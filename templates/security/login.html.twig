<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {# =====================================================================
       NOM DU PRODUIT — à changer ici quand le nom définitif est choisi
       ===================================================================== #}
    {# Nom commercial non arrêté : on affiche la promesse, pas une marque.
       Le jour où le nom est choisi, cette seule valeur est à renseigner. #}
    {% set product_name = "Gestion des recettes & coûts" %}

    <title>{{ product_name }} — Connexion</title>
    {# Police et icônes hébergées ici. La page de connexion est publique : c'est
       celle où l'appel à un tiers ressemblerait le plus au cas jugé à Munich en
       janvier 2022 — une adresse IP transmise aux États-Unis avant même que le
       visiteur n'ait rien demandé. #}
    <link rel="stylesheet" href="{{ asset('assets/vendor/inter/inter.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/vendor/fontawesome/css/fontawesome.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/vendor/fontawesome/css/solid.min.css') }}">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; min-height: 100vh; display: flex; }

        .panel-left {
            width: 52%; min-height: 100vh; background: #eef2fb;
            position: relative; overflow: hidden;
            display: flex; flex-direction: column; justify-content: center;
            padding: 60px 64px;
        }
        .deco-1 { position:absolute; width:500px; height:500px; border-radius:50%; background:rgba(59,130,246,0.07); top:-180px; right:-160px; }
        .deco-2 { position:absolute; width:300px; height:300px; border-radius:50%; background:rgba(59,130,246,0.06); bottom:-100px; left:-80px; }
        .deco-3 { position:absolute; width:120px; height:120px; border-radius:50%; background:rgba(59,130,246,0.08); bottom:120px; right:60px; }

        .brand { position:relative; z-index:1; display:flex; align-items:center; gap:14px; margin-bottom:52px; }
        .brand-icon { width:48px; height:48px; background:#1c2434; color:#E3B558; border-radius:14px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
        .brand-icon svg { width:26px; height:26px; }
        .brand-name { font-size:22px; font-weight:700; color:#1c2434; letter-spacing:-0.3px; display:flex; align-items:center; gap:10px; }
        .brand-tagline { font-size:12px; color:#6b7280; margin-top:2px; }
        /* Version en cours d'évaluation : la mention doit être vue sans être criarde. */
        .alpha-badge { font-size:10px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase;
            color:#8A6118; background:#F5E9CF; border:1px solid #E3CFA0; border-radius:999px; padding:2px 8px; }

        .tagline { position:relative; z-index:1; margin-bottom:40px; }
        .tagline-main { font-size:28px; font-weight:700; color:#1c2434; line-height:1.3; letter-spacing:-0.5px; }
        .tagline-sub { font-size:14px; color:#6b7280; margin-top:12px; line-height:1.65; }

        .features { position:relative; z-index:1; display:flex; flex-direction:column; gap:14px; }
        .feature-item { display:flex; align-items:center; gap:14px; }
        .feature-icon { width:36px; height:36px; border-radius:10px; background:rgba(59,130,246,0.12); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
        .feature-icon i { font-size:13px; color:#3b82f6; }
        .feature-text { font-size:14px; color:#374151; }

        .panel-right { width:48%; min-height:100vh; background:#fff; display:flex; align-items:center; justify-content:center; padding:48px; }
        .login-box { width:100%; max-width:360px; }

        .login-header { text-align:center; margin-bottom:36px; }
        .login-logo { width:52px; height:52px; background:#1c2434; color:#E3B558; border-radius:16px; display:flex; align-items:center; justify-content:center; margin:0 auto 16px; }
        .login-logo svg { width:28px; height:28px; }
        .login-alpha { margin-top:10px; font-size:11px; color:#8A6118; background:#F5E9CF;
            border:1px solid #E3CFA0; border-radius:8px; padding:6px 10px; display:inline-block; }
        .login-title { font-size:22px; font-weight:700; color:#1c2434; }
        .login-subtitle { font-size:14px; color:#9ca3af; margin-top:5px; }

        .form-group { margin-bottom:16px; }
        label { display:block; font-size:13px; font-weight:500; color:#4b5563; margin-bottom:7px; }
        .input-wrap { position:relative; }
        .input-wrap i { position:absolute; left:14px; top:50%; transform:translateY(-50%); font-size:13px; color:#9ca3af; }
        input[type="text"], input[type="password"] {
            width:100%; padding:11px 14px 11px 38px;
            border:1.5px solid #e5e7eb; border-radius:10px;
            font-size:14px; font-family:'Inter',sans-serif; color:#1c2434;
            outline:none; background:#fff; transition:border-color 0.15s, box-shadow 0.15s;
        }
        input[type="text"]:focus, input[type="password"]:focus {
            border-color:#3b82f6; box-shadow:0 0 0 3px rgba(59,130,246,0.1);
        }
        .btn-submit {
            width:100%; padding:13px; background:#3b82f6; color:#fff;
            font-size:14px; font-weight:600; font-family:'Inter',sans-serif;
            border:none; border-radius:10px; cursor:pointer; margin-top:6px; transition:background 0.15s;
        }
        .btn-submit:hover { background:#2563eb; }
        .error-box {
            background:#fef2f2; border:1px solid #fecaca; color:#dc2626;
            padding:11px 14px; border-radius:10px; font-size:13px;
            margin-bottom:18px; display:flex; align-items:center; gap:8px;
        }
        .login-footer { text-align:center; margin-top:28px; font-size:12px; color:#9ca3af; }
        .login-footer strong { color:#6b7280; }

        @media (max-width:900px) {
            body { flex-direction:column; }
            .panel-left { width:100%; min-height:auto; padding:36px 28px 32px; }
            .deco-1,.deco-2,.deco-3 { display:none; }
            .features { display:none; }
            .tagline-main { font-size:20px; }
            .tagline { margin-bottom:0; }
            .panel-right { width:100%; padding:36px 24px; }
        }
    </style>
</head>
<body>

<div class="panel-left">
    <div class="deco-1"></div>
    <div class="deco-2"></div>
    <div class="deco-3"></div>

    <div class="brand">
        <div class="brand-icon">
            {% include 'partials/logo.html.twig' with {size: 26} %}
        </div>
        <div>
            <div class="brand-name">
                {{ product_name }}
                <span class="alpha-badge">Alpha</span>
            </div>
            <div class="brand-tagline">Pour les métiers qui fabriquent au poids</div>
        </div>
    </div>

    <div class="tagline">
        <div class="tagline-main">Calculez vos coûts.<br>Maîtrisez vos marges.</div>
        <div class="tagline-sub">La gestion des recettes pensée pour<br>les artisans qui fabriquent au poids.</div>
    </div>

    <div class="features">
        <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-bolt"></i></div>
            <span class="feature-text">Mercuriale automatique : vos prix se mettent à jour depuis vos factures (Factur-X)</span>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-chart-line"></i></div>
            <span class="feature-text">Marges recalculées en temps réel à chaque variation de prix</span>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-leaf"></i></div>
            <span class="feature-text">Allergènes &amp; valeurs nutritionnelles (Ciqual / Anses)</span>
        </div>
        <div class="feature-item">
            <div class="feature-icon"><i class="fas fa-file-pdf"></i></div>
            <span class="feature-text">Fiches techniques &amp; fiches labo en PDF</span>
        </div>
    </div>
</div>

<div class="panel-right">
    <div class="login-box">
        <div class="login-header">
            <div class="login-logo">
                {% include 'partials/logo.html.twig' with {size: 28} %}
            </div>
            <div class="login-title">Bienvenue</div>
            <div class="login-subtitle">Connectez-vous à votre espace de gestion</div>
            <div class="login-alpha">Version Alpha — en cours d'évaluation, vos retours sont attendus</div>
        </div>

        {% if error %}
            <div class="error-box">
                <i class="fas fa-exclamation-circle"></i>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">
            <div class="form-group">
                <label for="username">Identifiant</label>
                <div class="input-wrap">
                    <i class="fas fa-user"></i>
                    <input type="text" id="username" name="_username"
                           value="{{ last_username }}" required autofocus
                           autocomplete="username" placeholder="Votre identifiant">
                </div>
            </div>
            <div class="form-group">
                <label for="password">Mot de passe</label>
                <div class="input-wrap">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="password" name="_password"
                           required autocomplete="current-password"
                           placeholder="Votre mot de passe">
                </div>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="btn-submit">
                Se connecter &nbsp;<i class="fas fa-arrow-right" style="font-size:11px;"></i>
            </button>
        </form>

        <div class="login-footer">
            <strong>{{ boutique().nomEtablissement }}</strong>{% if boutique().sousTitre %} · {{ boutique().sousTitre }}{% endif %}
        </div>
    </div>
</div>

</body>
</html>
