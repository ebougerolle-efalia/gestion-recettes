<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion — Gestion Recettes</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="h-full flex items-center justify-center bg-[#1c2434]">
    <div class="w-full max-w-sm mx-4">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white">Gestion Recettes</h1>
            <p class="text-gray-400 text-sm mt-2">Pierrick Bougerolle — Charcutier-Traiteur</p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-6 text-center">Connexion</h2>

            {% if error %}
            <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
            {% endif %}

            <form method="post">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Identifiant</label>
                    <input type="text" name="_username" value="{{ last_username }}" required autofocus
                           class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20">
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Mot de passe</label>
                    <input type="password" name="_password" required
                           class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="w-full rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition-colors">
                    Se connecter
                </button>
            </form>
        </div>
    </div>
</body>
</html>
