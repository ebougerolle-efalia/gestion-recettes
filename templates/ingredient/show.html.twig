{% extends 'base.html.twig' %}
{% block title %}{{ ingredient.name }}{% endblock %}
{% block page_title %}{{ ingredient.name }}{% endblock %}
{% block page_subtitle %}{{ ingredient.category ? ingredient.category.name : '' }} · {{ ingredient.baseUnit }}{% endblock %}

{% block body %}
    {% set canEdit = is_granted('ROLE_EDITOR') %}

    {% set prices_json = [] %}
    {% for p in ingredient.prices|reverse %}
        {% set prices_json = prices_json|merge([{
            dateSort:  p.effectiveDate|date('Y-m-d'),
            dateLabel: p.effectiveDate|date('d/m/Y'),
            price:     p.priceHt,
            supplier:  p.supplier ?? ''
        }]) %}
    {% endfor %}

    <div class="mb-4">
        <a href="{{ path('app_ingredient_index') }}" class="inline-flex items-center gap-1.5 text-sm text-ardoise-doux hover:text-laiton-patine">
            <i class="fas fa-arrow-left text-[10px]"></i> Retour
        </a>
    </div>

    {# KPI #}
    {% set latestPrice = ingredient.prices|first %}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="rounded-2xl border border-trait bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-ardoise-faible">Prix actuel</p>
            <p class="text-2xl font-bold text-pousse mt-1">{{ latestPrice ? latestPrice.priceHt|number_format(4,',',' ') ~ ' €' : '—' }}</p>
            <p class="text-[11px] text-ardoise-faible mt-0.5">par {{ ingredient.baseUnit }}</p>
        </div>
        <div class="rounded-2xl border border-trait bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-ardoise-faible">Relevés</p>
            <p class="text-2xl font-bold text-ardoise mt-1">{{ ingredient.prices|length }}</p>
        </div>
        <div class="rounded-2xl border border-trait bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-ardoise-faible">Fournisseur</p>
            <p class="text-sm font-semibold text-ardoise mt-2">{{ ingredient.defaultSupplier ?? '—' }}</p>
        </div>
        <div class="rounded-2xl border border-trait bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-ardoise-faible">TVA</p>
            <p class="text-2xl font-bold text-ardoise mt-1">{{ ingredient.vatRate }} %</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# Fiche #}
        <div>
            <div class="rounded-2xl border border-trait bg-white">
                <div class="px-6 py-4 border-b border-trait-fin">
                    <h3 class="font-semibold text-[15px] text-ardoise"><i class="fas fa-pencil-alt text-laiton-patine mr-2 text-sm"></i>Fiche</h3>
                </div>
                <form method="post" action="{{ path('app_ingredient_update', {id: ingredient.id}) }}" class="p-6 space-y-4">
                    <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Nom</label><input type="text" name="name" value="{{ ingredient.name }}" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine disabled:bg-voile"></div>
                    <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Catégorie</label>
                        <select name="category_id" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine bg-white disabled:bg-voile">
                            <option value="{{ ingredient.category.id }}" selected>{{ ingredient.category.name }}</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Unité</label><select name="base_unit" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine bg-white disabled:bg-voile"><option value="kg" {{ ingredient.baseUnit == 'kg' ? 'selected' }}>kg</option><option value="g" {{ ingredient.baseUnit == 'g' ? 'selected' }}>g</option><option value="piece" {{ ingredient.baseUnit == 'piece' ? 'selected' }}>pièce</option><option value="litre" {{ ingredient.baseUnit == 'litre' ? 'selected' }}>litre</option></select></div>
                        <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">TVA %</label><input type="number" name="vat_rate" step="0.01" value="{{ ingredient.vatRate }}" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine disabled:bg-voile"></div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-ardoise-doux mb-1.5">Poids unitaire <span class="text-ardoise-faible font-normal">(g / pièce)</span></label>
                        <input type="number" name="unit_weight_g" step="0.1" min="0" value="{{ ingredient.unitWeightG }}" {{ canEdit ? '' : 'disabled' }} placeholder="ex. 50" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine disabled:bg-voile">
                        <p class="text-xs text-ardoise-faible mt-1">Pour un ingrédient à la pièce : permet de convertir pièce ↔ grammes (coût saisissable en grammes, et valeurs nutritionnelles prises en compte).</p>
                    </div>
                    <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Fournisseur par défaut</label><input type="text" name="default_supplier" value="{{ ingredient.defaultSupplier }}" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine disabled:bg-voile"></div>

                    <div class="border-t border-trait-fin pt-4">
                        <label class="block text-xs font-semibold text-ardoise-doux uppercase tracking-wider mb-2">Allergènes présents</label>
                        <div class="grid grid-cols-2 gap-x-3 gap-y-1.5">
                            {% for code, label in allergenes() %}
                                <label class="flex items-center gap-2 text-sm text-ardoise-doux {{ canEdit ? 'cursor-pointer' : '' }}">
                                    <input type="checkbox" name="allergens[]" value="{{ code }}" {{ code in ingredient.allergens ? 'checked' }} {{ canEdit ? '' : 'disabled' }} class="w-4 h-4 rounded border-trait text-sang focus:ring-sang/40">
                                    {{ label }}
                                </label>
                            {% endfor %}
                        </div>
                        <details class="mt-3">
                            <summary class="text-xs text-ardoise-faible cursor-pointer select-none hover:text-ardoise-doux">Traces éventuelles (« peut contenir »)</summary>
                            <div class="grid grid-cols-2 gap-x-3 gap-y-1.5 mt-2">
                                {% for code, label in allergenes() %}
                                    <label class="flex items-center gap-2 text-sm text-ardoise-doux {{ canEdit ? 'cursor-pointer' : '' }}">
                                        <input type="checkbox" name="traces[]" value="{{ code }}" {{ code in ingredient.traces ? 'checked' }} {{ canEdit ? '' : 'disabled' }} class="w-4 h-4 rounded border-trait text-laiton-patine focus:ring-laiton/40">
                                        {{ label }}
                                    </label>
                                {% endfor %}
                            </div>
                        </details>
                    </div>

                    <div class="border-t border-trait-fin pt-4">
                        <label class="block text-xs font-semibold text-ardoise-doux uppercase tracking-wider mb-2">Valeur nutritionnelle (Ciqual)</label>
                        <input type="hidden" name="ciqual_code" id="ciqualCode" value="{{ ingredient.ciqualCode }}">
                        <div id="ciqualCurrent" class="{{ ingredient.ciqualCode ? '' : 'hidden' }} flex items-center justify-between gap-2 rounded-lg bg-voile border border-laiton/30 px-3 py-2 mb-2">
                            <span class="text-sm text-ardoise-fort"><i class="fas fa-link text-[10px] mr-1.5"></i><span id="ciqualCurrentName">{{ ciqualName }}</span></span>
                            {% if canEdit %}<button type="button" onclick="clearCiqual()" class="text-laiton-patine hover:text-sang" title="Retirer le lien"><i class="fas fa-times text-xs"></i></button>{% endif %}
                        </div>
                        {% if ingredient.ciqualAuto %}
                            <p class="flex items-center gap-1.5 text-xs text-laiton-patine bg-laiton-voile border border-laiton/40 rounded-lg px-3 py-2 mb-2">
                                <i class="fas fa-triangle-exclamation text-[11px]"></i>
                                Rattachement automatique non vérifié — contrôlez l'état (cru / cuit) avant toute déclaration nutritionnelle.
                            </p>
                        {% endif %}
                        {% if canEdit %}
                            <div id="ciqualSuggestions" class="hidden rounded-lg border border-trait bg-voile px-3 py-2 mb-2"></div>
                            <div class="relative">
                                <input type="text" id="ciqualSearch" autocomplete="off" placeholder="Rechercher un aliment Ciqual…" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine">
                                <div id="ciqualResults" class="hidden absolute z-20 mt-1 w-full max-h-60 overflow-y-auto rounded-lg border border-trait bg-white shadow-lg"></div>
                            </div>
                            <button type="button" id="ciqualSuggestBtn" class="mt-2 text-xs text-laiton-patine hover:text-ardoise">
                                <i class="fas fa-wand-magic-sparkles text-[10px] mr-1"></i>Proposer un aliment d'après le nom
                            </button>
                            <p class="text-xs text-ardoise-faible mt-1.5">Associe cet ingrédient à un aliment Ciqual pour calculer les valeurs nutritionnelles des recettes. Source : Anses / Ciqual.</p>
                        {% endif %}
                    </div>

                    {% if canEdit %}<button type="submit" class="w-full rounded-lg bg-ardoise hover:bg-ardoise-clair px-5 py-2.5 text-sm font-medium text-white"><i class="fas fa-check text-[11px] mr-1"></i> Enregistrer</button>{% endif %}
                </form>
            </div>
            {% if canEdit and ingredient.ciqualAuto %}
                <form method="post" action="{{ path('app_ingredient_ciqual_confirm', {id: ingredient.id}) }}" class="mt-4">
                    <button class="w-full rounded-lg border border-laiton/40 bg-laiton-voile px-5 py-2.5 text-sm font-medium text-laiton-patine hover:bg-laiton-voile">
                        <i class="fas fa-check-double text-[11px] mr-1"></i> Confirmer le rattachement Ciqual
                    </button>
                </form>
            {% endif %}
            {% if canEdit %}
                <form method="post" action="{{ path('app_ingredient_delete', {id: ingredient.id}) }}" onsubmit="return confirm('Supprimer ?')" class="mt-4">
                    <button class="w-full rounded-lg border border-sang/30 px-5 py-2.5 text-sm font-medium text-sang hover:bg-sang-voile"><i class="fas fa-trash text-[11px] mr-1"></i> Supprimer</button>
                </form>
            {% endif %}
        </div>

        {# Historique prix #}
        <div class="lg:col-span-2">
            <div class="rounded-2xl border border-trait bg-white">
                <div class="px-6 py-4 border-b border-trait-fin flex items-center justify-between">
                    <h3 class="font-semibold text-[15px] text-ardoise"><i class="fas fa-chart-line text-pousse mr-2 text-sm"></i>Historique des prix</h3>
                    {% if canEdit %}
                        <button onclick="document.getElementById('addPriceModal').classList.remove('hidden');document.getElementById('addPriceModal').classList.add('flex')" class="inline-flex items-center gap-1.5 rounded-lg bg-pousse hover:bg-pousse px-3 py-2 text-xs font-medium text-white">
                            <i class="fas fa-plus text-[10px]"></i> Nouveau prix
                        </button>
                    {% endif %}
                </div>

                {# Graphique — données embarquées dans data-prices pour éviter les problèmes de portée Twig #}
                {% if ingredient.prices|length >= 2 %}
                    <div class="px-6 pt-5 pb-2">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-semibold text-ardoise-doux uppercase tracking-wider">Évolution du prix (€ / {{ ingredient.baseUnit }})</span>
                            {% set firstP = prices_json|first %}
                            {% set lastP  = prices_json|last %}
                            {% if firstP and lastP %}
                                {% set diff = lastP.price - firstP.price %}
                                {% set pct  = firstP.price > 0 ? (diff / firstP.price * 100)|round(1) : 0 %}
                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full {{ diff > 0 ? 'bg-sang-voile text-sang' : (diff < 0 ? 'bg-pousse-voile text-pousse' : 'bg-voile text-ardoise-doux') }}">
                        {{ diff > 0 ? '+' : '' }}{{ pct }} % sur la période
                    </span>
                            {% endif %}
                        </div>
                        <div style="height:180px; position:relative;">
                            {# Les données sont embarquées dans data-prices — accessibles dans le bloc JS #}
                            <canvas id="priceChart"
                                    data-prices="{{ prices_json|json_encode }}"
                                    data-unit="{{ ingredient.baseUnit }}">
                            </canvas>
                        </div>
                    </div>
                    <div class="border-t border-trait-fin"></div>
                {% elseif ingredient.prices|length == 1 %}
                    <div class="px-6 py-4">
                        <p class="text-xs text-ardoise-faible italic">Ajoutez un 2ème relevé de prix pour voir l'évolution.</p>
                    </div>
                    <div class="border-t border-trait-fin"></div>
                {% endif %}

                {% if ingredient.prices|length > 0 %}
                    <table class="w-full text-sm">
                        <thead><tr class="border-b border-trait-fin">
                            <th class="py-3 px-5 text-left text-xs font-medium uppercase text-ardoise-faible">Date</th>
                            <th class="py-3 px-3 text-right text-xs font-medium uppercase text-ardoise-faible">Prix HT / {{ ingredient.baseUnit }}</th>
                            <th class="py-3 px-3 text-left text-xs font-medium uppercase text-ardoise-faible">Fournisseur</th>
                        </tr></thead>
                        <tbody class="divide-y divide-trait-fin">
                        {% for p in ingredient.prices %}
                            <tr class="{{ loop.first ? 'bg-pousse-voile/50' : '' }}">
                                <td class="py-3 px-5 text-ardoise">{{ p.effectiveDate|date('d/m/Y') }}</td>
                                <td class="py-3 px-3 text-right font-semibold {{ loop.first ? 'text-pousse' : 'text-ardoise-doux' }}">{{ p.priceHt|number_format(4, ',', ' ') }} €</td>
                                <td class="py-3 px-3 text-ardoise-doux">{{ p.supplier|default('—') }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="py-12 text-center text-ardoise-faible">
                        <i class="fas fa-tag text-2xl text-ardoise-faible mb-2 block"></i>
                        <p class="text-sm">Aucun prix enregistré</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Modal nouveau prix #}
    <div id="addPriceModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <form method="post" action="{{ path('app_ingredient_add_price', {id: ingredient.id}) }}" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
            <div class="px-6 py-4 border-b border-trait-fin"><h3 class="font-semibold text-ardoise">Nouveau prix</h3></div>
            <div class="p-6 space-y-4">
                <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Prix HT / {{ ingredient.baseUnit }} *</label><input type="number" name="price_ht" step="0.0001" required class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine"></div>
                <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Fournisseur</label><input type="text" name="supplier" value="{{ ingredient.defaultSupplier }}" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine"></div>
                <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Date effective</label><input type="date" name="effective_date" value="{{ 'now'|date('Y-m-d') }}" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine"></div>
            </div>
            <div class="px-6 py-4 border-t border-trait-fin flex justify-end gap-3">
                <button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-trait px-4 py-2 text-sm text-ardoise-doux hover:bg-voile">Annuler</button>
                <button type="submit" class="rounded-lg bg-pousse hover:bg-pousse px-5 py-2 text-sm font-medium text-white">Ajouter</button>
            </div>
        </form></div>
{% endblock %}

{% block javascripts %}
    {# Chart.js hébergé ici : un script tiers s'exécute avec accès complet au
       DOM d'une session authentifiée qui affiche marges et prix fournisseurs. #}
    <script src="{{ asset('assets/vendor/chartjs/chart.umd.min.js') }}"></script>
    <script>
        // Graphique évolution des prix
        // Les données sont lues depuis data-prices pour éviter les problèmes de portée Twig inter-blocs
        const priceCanvas = document.getElementById('priceChart');
        if (priceCanvas && priceCanvas.dataset.prices) {
            const priceHistory = JSON.parse(priceCanvas.dataset.prices);
            priceHistory.sort((a, b) => a.dateSort < b.dateSort ? -1 : 1);

            const prices = priceHistory.map(p => parseFloat(p.price));
            const minP   = Math.min(...prices);
            const maxP   = Math.max(...prices);
            const pad    = (maxP - minP) * 0.15 || 0.05;

            new Chart(priceCanvas, {
                type: 'line',
                data: {
                    labels: priceHistory.map(p => p.dateLabel),
                    datasets: [{
                        data: prices,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16,185,129,0.06)',
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: ctx => parseFloat(ctx.parsed.y).toFixed(4).replace('.', ',') + ' €'
                            }
                        }
                    },
                    scales: {
                        y: {
                            min: Math.max(0, minP - pad),
                            max: maxP + pad,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                font: { size: 11 },
                                color: '#9ca3af',
                                callback: v => v.toFixed(2).replace('.', ',') + ' €'
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11 }, color: '#9ca3af' }
                        }
                    }
                }
            });
        }

        // ===== Autocomplétion Ciqual (valeur nutritionnelle) =====
        (function () {
            const input = document.getElementById('ciqualSearch');
            const box   = document.getElementById('ciqualResults');
            if (!input || !box) return;
            let timer = null;

            input.addEventListener('input', () => {
                clearTimeout(timer);
                const q = input.value.trim();
                if (q.length < 2) { box.classList.add('hidden'); box.innerHTML = ''; return; }
                timer = setTimeout(async () => {
                    try {
                        const res = await fetch('{{ path('app_ciqual_search') }}?q=' + encodeURIComponent(q));
                        const items = await res.json();
                        if (!items.length) { box.innerHTML = '<div class="px-3 py-2 text-sm text-ardoise-faible">Aucun résultat</div>'; box.classList.remove('hidden'); return; }
                        box.innerHTML = items.map(it =>
                            `<button type="button" class="block w-full text-left px-3 py-2 text-sm hover:bg-voile border-b border-trait-fin"
                                     data-code="${it.code}" data-nom="${it.nom.replace(/"/g, '&quot;')}">
                                ${it.nom}${it.groupe ? ` <span class="text-ardoise-faible text-xs">· ${it.groupe}</span>` : ''}
                             </button>`
                        ).join('');
                        box.classList.remove('hidden');
                    } catch (e) { box.classList.add('hidden'); }
                }, 250);
            });

            box.addEventListener('click', e => {
                const btn = e.target.closest('button[data-code]');
                if (!btn) return;
                applyCiqual(btn.dataset.code, btn.dataset.nom);
                box.classList.add('hidden');
                input.value = '';
            });

            document.addEventListener('click', e => {
                if (!box.contains(e.target) && e.target !== input) box.classList.add('hidden');
            });
        })();

        // ===== Suggestion automatique d'après le nom de l'ingrédient =====
        (function () {
            const panel = document.getElementById('ciqualSuggestions');
            const btn   = document.getElementById('ciqualSuggestBtn');
            if (!panel || !btn) return;

            const escape = s => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

            async function suggest() {
                const name = document.querySelector('input[name="name"]')?.value.trim() || '';
                const cat  = document.querySelector('select[name="category_id"]')?.value || '';
                if (!name) return;

                panel.innerHTML = '<p class="text-xs text-ardoise-faible">Recherche…</p>';
                panel.classList.remove('hidden');

                try {
                    const res = await fetch('{{ path('app_ciqual_suggest') }}?name=' + encodeURIComponent(name) + '&category_id=' + encodeURIComponent(cat));
                    const items = await res.json();
                    if (!items.length) {
                        panel.innerHTML = '<p class="text-xs text-ardoise-faible">Aucune correspondance trouvée — utilisez la recherche ci-dessous.</p>';
                        return;
                    }
                    panel.innerHTML =
                        '<p class="text-[11px] font-semibold uppercase tracking-wider text-ardoise-faible mb-1.5">Suggestions</p>' +
                        items.map(it => {
                            const pct = Math.round(it.score * 100);
                            const tone = pct >= 60 ? 'text-pousse' : 'text-laiton-patine';
                            return `<button type="button" data-code="${escape(it.code)}" data-nom="${escape(it.nom)}"
                                        class="flex w-full items-center justify-between gap-2 rounded px-2 py-1.5 text-left text-sm hover:bg-white">
                                        <span>${escape(it.nom)}${it.groupe ? ` <span class="text-ardoise-faible text-xs">· ${escape(it.groupe)}</span>` : ''}</span>
                                        <span class="${tone} text-xs font-semibold shrink-0">${pct} %</span>
                                    </button>`;
                        }).join('');
                } catch (e) {
                    panel.innerHTML = '<p class="text-xs text-sang">Suggestion indisponible.</p>';
                }
            }

            btn.addEventListener('click', suggest);
            panel.addEventListener('click', e => {
                const b = e.target.closest('button[data-code]');
                if (!b) return;
                applyCiqual(b.dataset.code, b.dataset.nom);
                panel.classList.add('hidden');
            });

            // Ingrédient non encore rattaché : on propose sans attendre une action.
            if (!document.getElementById('ciqualCode').value) suggest();
        })();

        function applyCiqual(code, nom) {
            document.getElementById('ciqualCode').value = code;
            document.getElementById('ciqualCurrentName').textContent = nom;
            document.getElementById('ciqualCurrent').classList.remove('hidden');
        }

        function clearCiqual() {
            document.getElementById('ciqualCode').value = '';
            document.getElementById('ciqualCurrent').classList.add('hidden');
        }
    </script>
{% endblock %}
