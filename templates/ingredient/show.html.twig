{% extends 'base.html.twig' %}
{% block title %}{{ ingredient.name }}{% endblock %}
{% block page_title %}{{ ingredient.name }}{% endblock %}
{% block page_subtitle %}{{ ingredient.category ? ingredient.category.name : '' }} · {{ ingredient.baseUnit }}{% endblock %}

{% block body %}
    {% set canEdit = is_granted('ROLE_EDITOR') %}

    {# Prix actuel (le plus récent) #}
    {% set latestPrice = ingredient.prices|first %}

    {# Préparer les données prix pour Chart.js (trié du plus ancien au plus récent) #}
    {% set prices_json = [] %}
    {% for p in ingredient.prices|reverse %}
        {% set prices_json = prices_json|merge([{
            dateSort:  p.effectiveDate|date('Y-m-d'),
            dateLabel: p.effectiveDate|date('d/m/Y'),
            price:     p.priceHt,
            supplier:  p.supplier ?? ''
        }]) %}
    {% endfor %}

    <div class="mb-4">
        <a href="{{ path('app_ingredient_index') }}" class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-blue-500">
            <i class="fas fa-arrow-left text-[10px]"></i> Retour
        </a>
    </div>

    {# KPI prix #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">Prix actuel</p>
            <p class="text-2xl font-bold text-emerald-600 mt-1">{{ latestPrice ? latestPrice.priceHt|number_format(4,',',' ') ~ ' €' : '—' }}</p>
            <p class="text-[11px] text-gray-400 mt-0.5">par {{ ingredient.baseUnit }}</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">Relevés</p>
            <p class="text-2xl font-bold text-[#1c2434] mt-1">{{ ingredient.prices|length }}</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">Fournisseur</p>
            <p class="text-sm font-semibold text-[#1c2434] mt-2">{{ ingredient.defaultSupplier ?? '—' }}</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">TVA</p>
            <p class="text-2xl font-bold text-[#1c2434] mt-1">{{ ingredient.vatRate }} %</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        {# Fiche édition #}
        <div>
            <div class="rounded-2xl border border-gray-200 bg-white">
                <div class="px-6 py-4 border-b border-gray-100">
                    <h3 class="font-semibold text-[15px] text-[#1c2434]"><i class="fas fa-pencil-alt text-blue-500 mr-2 text-sm"></i>Fiche</h3>
                </div>
                <form method="post" action="{{ path('app_ingredient_update', {id: ingredient.id}) }}" class="p-6 space-y-4">
                    <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Nom</label><input type="text" name="name" value="{{ ingredient.name }}" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 disabled:bg-gray-50"></div>
                    <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Catégorie</label>
                        <select name="category_id" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white disabled:bg-gray-50">
                            <option value="{{ ingredient.category.id }}" selected>{{ ingredient.category.name }}</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Unité</label><select name="base_unit" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white disabled:bg-gray-50"><option value="kg" {{ ingredient.baseUnit == 'kg' ? 'selected' }}>kg</option><option value="g" {{ ingredient.baseUnit == 'g' ? 'selected' }}>g</option><option value="piece" {{ ingredient.baseUnit == 'piece' ? 'selected' }}>pièce</option><option value="litre" {{ ingredient.baseUnit == 'litre' ? 'selected' }}>litre</option></select></div>
                        <div><label class="block text-sm font-medium text-gray-600 mb-1.5">TVA %</label><input type="number" name="vat_rate" step="0.01" value="{{ ingredient.vatRate }}" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 disabled:bg-gray-50"></div>
                    </div>
                    <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Fournisseur par défaut</label><input type="text" name="default_supplier" value="{{ ingredient.defaultSupplier }}" {{ canEdit ? '' : 'disabled' }} class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 disabled:bg-gray-50"></div>
                    {% if canEdit %}<button type="submit" class="w-full rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2.5 text-sm font-medium text-white"><i class="fas fa-check text-[11px] mr-1"></i> Enregistrer</button>{% endif %}
                </form>
            </div>
            {% if canEdit %}
                <form method="post" action="{{ path('app_ingredient_delete', {id: ingredient.id}) }}" onsubmit="return confirm('Supprimer ?')" class="mt-4">
                    <button class="w-full rounded-lg border border-red-200 px-5 py-2.5 text-sm font-medium text-red-500 hover:bg-red-50"><i class="fas fa-trash text-[11px] mr-1"></i> Supprimer</button>
                </form>
            {% endif %}
        </div>

        {# Historique des prix #}
        <div class="lg:col-span-2">
            <div class="rounded-2xl border border-gray-200 bg-white">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                    <h3 class="font-semibold text-[15px] text-[#1c2434]"><i class="fas fa-chart-line text-emerald-500 mr-2 text-sm"></i>Historique des prix</h3>
                    {% if canEdit %}
                        <button onclick="document.getElementById('addPriceModal').classList.remove('hidden');document.getElementById('addPriceModal').classList.add('flex')" class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-600 px-3 py-2 text-xs font-medium text-white">
                            <i class="fas fa-plus text-[10px]"></i> Nouveau prix
                        </button>
                    {% endif %}
                </div>

                {# Graphique évolution des prix #}
                {% if ingredient.prices|length >= 2 %}
                    <div class="px-6 pt-5 pb-2">
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Évolution du prix (€ / {{ ingredient.baseUnit }})</span>
                            {% if ingredient.prices|length >= 2 %}
                                {% set firstP = prices_json|first %}
                                {% set lastP  = prices_json|last %}
                                {% set diff   = lastP.price - firstP.price %}
                                {% set pct    = firstP.price > 0 ? (diff / firstP.price * 100)|round(1) : 0 %}
                                <span class="text-xs font-semibold px-2 py-0.5 rounded-full {{ diff > 0 ? 'bg-red-50 text-red-600' : (diff < 0 ? 'bg-emerald-50 text-emerald-600' : 'bg-gray-100 text-gray-500') }}">
                        {{ diff > 0 ? '+' : '' }}{{ pct }} % sur la période
                    </span>
                            {% endif %}
                        </div>
                        <div style="height:180px; position:relative;">
                            <canvas id="priceChart"></canvas>
                        </div>
                    </div>
                    <div class="border-t border-gray-50"></div>
                {% elseif ingredient.prices|length == 1 %}
                    <div class="px-6 py-4">
                        <p class="text-xs text-gray-400 italic">Ajoutez un 2ème relevé de prix pour voir l'évolution.</p>
                    </div>
                    <div class="border-t border-gray-50"></div>
                {% endif %}

                {# Tableau des prix #}
                {% if ingredient.prices|length > 0 %}
                    <table class="w-full text-sm">
                        <thead><tr class="border-b border-gray-100">
                            <th class="py-3 px-5 text-left text-xs font-medium uppercase text-gray-400">Date</th>
                            <th class="py-3 px-3 text-right text-xs font-medium uppercase text-gray-400">Prix HT / {{ ingredient.baseUnit }}</th>
                            <th class="py-3 px-3 text-left text-xs font-medium uppercase text-gray-400">Fournisseur</th>
                        </tr></thead>
                        <tbody class="divide-y divide-gray-50">
                        {% for p in ingredient.prices %}
                            <tr class="{{ loop.first ? 'bg-emerald-50/50' : '' }}">
                                <td class="py-3 px-5 text-gray-700">{{ p.effectiveDate|date('d/m/Y') }}</td>
                                <td class="py-3 px-3 text-right font-semibold {{ loop.first ? 'text-emerald-700' : 'text-gray-600' }}">{{ p.priceHt|number_format(4, ',', ' ') }} €</td>
                                <td class="py-3 px-3 text-gray-500">{{ p.supplier|default('—') }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="py-12 text-center text-gray-400">
                        <i class="fas fa-tag text-2xl text-gray-200 mb-2 block"></i>
                        <p class="text-sm">Aucun prix enregistré</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Modal nouveau prix #}
    <div id="addPriceModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50" onclick="if(event.target===this){this.classList.add('hidden');this.classList.remove('flex')}">
        <form method="post" action="{{ path('app_ingredient_add_price', {id: ingredient.id}) }}" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
            <div class="px-6 py-4 border-b border-gray-100"><h3 class="font-semibold text-[#1c2434]">Nouveau prix</h3></div>
            <div class="p-6 space-y-4">
                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Prix HT / {{ ingredient.baseUnit }} *</label><input type="number" name="price_ht" step="0.0001" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div>
                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Fournisseur</label><input type="text" name="supplier" value="{{ ingredient.defaultSupplier }}" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div>
                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Date effective</label><input type="date" name="effective_date" value="{{ 'now'|date('Y-m-d') }}" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button>
                <button type="submit" class="rounded-lg bg-emerald-500 hover:bg-emerald-600 px-5 py-2 text-sm font-medium text-white">Ajouter</button>
            </div>
        </form></div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        {% if ingredient.prices|length >= 2 %}
        const priceHistory = {{ prices_json|json_encode|raw }};
        priceHistory.sort((a, b) => a.dateSort < b.dateSort ? -1 : 1);

        const ctx = document.getElementById('priceChart');
        if (ctx) {
            const prices = priceHistory.map(p => parseFloat(p.price));
            const minP = Math.min(...prices);
            const maxP = Math.max(...prices);
            const pad  = (maxP - minP) * 0.15 || 0.05;

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: priceHistory.map(p => p.dateLabel),
                    datasets: [{
                        data: prices,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16,185,129,0.06)',
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: ctx => parseFloat(ctx.parsed.y).toFixed(4).replace('.', ',') + ' €'
                            }
                        }
                    },
                    scales: {
                        y: {
                            min: Math.max(0, minP - pad),
                            max: maxP + pad,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                font: { size: 11 },
                                color: '#9ca3af',
                                callback: v => v.toFixed(2).replace('.', ',') + ' €'
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11 }, color: '#9ca3af' }
                        }
                    }
                }
            });
        }
        {% endif %}
    </script>
{% endblock %}
