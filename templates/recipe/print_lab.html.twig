<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche labo — {{ recipe.name }}</title>
    <style>
        /*
         * FICHE LABO — le document qu'on tient au poste de travail.
         *
         * Trois contraintes propres au papier, qui ne valent pas à l'écran :
         *
         *  1. Il se lit à bout de bras, mains occupées. Le corps passe de 10 à
         *     12 pt, la composition — la seule chose qu'on relit vraiment en
         *     pesant — à 12,5 pt.
         *  2. Il finit photocopié ou plastifié. Aucune information ne repose
         *     sur la couleur seule, et les gris trop clairs disparaissent : le
         *     #94a3b8 employé dix fois est remplacé par un ton qui tient à
         *     l'impression.
         *  3. Arial et non Inter : la police de marque n'est pas embarquée dans
         *     le rendu Gotenberg, et une fiche d'atelier n'a pas besoin de
         *     porter la typographie du produit — elle a besoin d'être lisible
         *     sur une photocopie. Inter est proposée en tête au cas où elle
         *     serait disponible, Arial reprend la main sinon.
         */
        body {
            font-family: Inter, Arial, Helvetica, sans-serif;
            font-size: 12pt;
            color: #16202B;
            margin: 0;
            padding: 0;
            -webkit-print-color-adjust: exact;
        }

        .header-table { width: 100%; border-bottom: 3px solid #16202B; padding-bottom: 10px; margin-bottom: 16px; }
        .header-table td { vertical-align: bottom; padding: 0; }
        .header-title { font-size: 22pt; font-weight: bold; color: #16202B; letter-spacing: 1px; }
        .header-subtitle { font-size: 13pt; color: #475761; margin-top: 4px; }
        .header-company { font-size: 10pt; color: #5B6B73; text-align: right; }

        /* La quantité est le premier chiffre qu'on cherche en ouvrant la fiche. */
        .qty-badge {
            display: inline-block;
            background: #16202B;
            color: #FBFCFB;
            font-size: 16pt;
            font-weight: bold;
            padding: 8px 22px;
            border-radius: 4px;
            margin-bottom: 14px;
            letter-spacing: 0.5px;
        }

        .meta-table { width: 100%; margin-bottom: 16px; background: #EFF2F0; border: 1px solid #CBD2CE; border-radius: 4px; }
        .meta-table td { padding: 8px 14px; font-size: 11pt; color: #475761; }
        .meta-table strong { color: #16202B; }

        h2 { font-size: 14pt; font-weight: bold; color: #16202B; margin-bottom: 8px; padding-bottom: 5px; border-bottom: 1px solid #CBD2CE; }

        .comp-table { width: 100%; border-collapse: collapse; }
        .comp-table th {
            font-size: 9.5pt; text-transform: uppercase; letter-spacing: 0.8px;
            color: #33434E; font-weight: bold; padding: 8px 10px;
            border-bottom: 2px solid #16202B; text-align: left;
        }
        .comp-table th.c { text-align: center; }
        .comp-table td { padding: 8px 10px; border-bottom: 1px solid #DFE4E1; font-size: 12.5pt; }
        .comp-table td.c { text-align: center; font-variant-numeric: tabular-nums; }
        .comp-table td.bold { font-weight: bold; color: #16202B; }

        /* Une sous-recette se distingue par son marqueur [SR] et son italique,
           jamais par sa seule couleur : la fiche survit au noir et blanc. */
        .sub-recipe { color: #7E5B1E; font-style: italic; font-weight: bold; }
        .note { font-size: 10.5pt; color: #7E5B1E; font-style: italic; }

        .encart { width: 100%; margin-top: 14px; border: 1px solid #CBD2CE; border-radius: 4px; background: #fff; }
        .encart td { padding: 9px 14px; font-size: 11.5pt; color: #475761; }
        .encart strong { color: #16202B; }
        .encart .secondaire { color: #5B6B73; }

        .footer { margin-top: 30px; padding-top: 8px; border-top: 1px solid #CBD2CE; font-size: 10pt; color: #5B6B73; text-align: center; }

        /* Rien ne doit se couper au milieu d'une ligne d'ingrédient : on relit
           cette fiche en pesant, une quantité orpheline en haut de page est une
           erreur de pesée. */
        tr, .encart { page-break-inside: avoid; }
        h2 { page-break-after: avoid; }
    </style>
</head>
<body>

{% set f = factor|default(1) %}
{% set rqty = requestedQty|default(recipe.outputValue) %}

<!-- EN-TÊTE -->
<table class="header-table">
    <tr>
        <td>
            <div class="header-title">FICHE LABO</div>
            <div class="header-subtitle">{{ recipe.name }} — {{ recipe.family }}</div>
        </td>
        <td class="header-company">
            {% if logo_base64() %}<img src="{{ logo_base64() }}" alt="" style="max-height:44px; max-width:130px; margin-bottom:5px; display:block; margin-left:auto;"><br>{% endif %}
            <strong style="color:#16202B;">{{ boutique().nomEtablissement }}</strong>
            {% if boutique().sousTitre %}<br>{{ boutique().sousTitre }}{% endif %}
            {% if boutique().adresseComplete %}<br>{{ boutique().adresseComplete }}{% endif %}
        </td>
    </tr>
</table>

<!-- BADGE QUANTITÉ (mise en avant sur la fiche labo) -->
<div style="text-align:center; margin-bottom:20px;">
    <span class="qty-badge">
        POUR {{ rqty|number_format(3, ',', ' ')|replace({',000': '', ',00': '', ',0': ''}) }} {{ recipe.outputUnitLabel|upper }}
    </span>
    {% if f != 1 %}
        <div style="font-size:11pt; color:#5B6B73; margin-top:4px;">
            Facteur × {{ f|number_format(3, ',', ' ')|replace({',000': '', ',00': '', ',0': ''}) }} — base recette : {{ recipe.outputValue }} {{ recipe.outputUnitLabel }}
        </div>
    {% endif %}
</div>

<!-- MÉTA -->
<table class="meta-table">
    <tr>
        <td>Sortie cible : <strong>{{ (totals.output_target * f)|number_format(3, ',', ' ') }} {{ recipe.outputUnitLabel }}</strong></td>
        <td>Perte : <strong>{{ recipe.lossPercent|number_format(1, ',', ' ') }}%</strong></td>
        <td>Rendement : <strong>{{ recipe.yieldPercent|number_format(1, ',', ' ') }}%</strong></td>
        <td>Sortie effective : <strong>{{ (totals.output_effective * f)|number_format(3, ',', ' ') }} {{ recipe.outputUnitLabel }}</strong></td>
    </tr>
</table>

<!-- COMPOSITION -->
<h2>Composition</h2>
<table class="comp-table">
    <thead>
    <tr>
        <th>Élément</th>
        <th class="c" style="width: 110px;">Qté brute</th>
        <th class="c" style="width: 110px;">Qté nette</th>
        <th class="c" style="width: 70px;">Unité</th>
    </tr>
    </thead>
    <tbody>
    {% for l in lines %}
        <tr>
            <td>
                {% if l.type == 'sub_recipe' %}
                    <span class="sub-recipe">[SR] {{ l.sub_recipe.name }}</span>
                {% else %}
                    {{ l.ingredient.name }}
                {% endif %}
                {% if l.note %}<br><span class="note">→ {{ l.note }}</span>{% endif %}
            </td>
            <td class="c bold">{{ (l.qty_brute * f)|number_format(3, ',', ' ') }}</td>
            <td class="c">{{ (l.qty_net * f)|number_format(3, ',', ' ') }}</td>
            <td class="c">{{ l.unit }}</td>
        </tr>
        {% if l.type == 'sub_recipe' and l.sub_recipe.components is not empty %}
            <tr>
                <td colspan="4" style="padding:3px 8px 8px 22px; background:#EFF2F0; border-bottom:1px solid #DFE4E1;">
                    <div style="font-size:11pt; color:#475761; margin-bottom:3px;">
                        Composition de « {{ l.sub_recipe.name }} » — pour {{ l.sub_recipe.output_value|number_format(3, ',', ' ') }} {{ l.sub_recipe.output_unit }}
                        <span style="color:#5B6B73;">(utilisé ici : {{ (l.sub_recipe.qty_used * f)|number_format(3, ',', ' ') }} {{ l.sub_recipe.output_unit }})</span>
                    </div>
                    <table style="width:100%; border-collapse:collapse; font-size:11pt;">
                        {% for c in l.sub_recipe.components %}
                            <tr>
                                <td style="padding:1px 0; color:#33434E;">– {{ c.name }}{% if c.note %} <span style="color:#5B6B73;">({{ c.note }})</span>{% endif %}</td>
                                <td style="text-align:right; width:120px; color:#33434E;">{{ c.qty_brute|number_format(3, ',', ' ') }} {{ c.unit }}</td>
                                <td style="text-align:right; width:120px; color:#5B6B73;">net {{ c.qty_net|number_format(3, ',', ' ') }}</td>
                            </tr>
                        {% endfor %}
                    </table>
                </td>
            </tr>
        {% endif %}
    {% endfor %}
    </tbody>
</table>

<!-- ALLERGÈNES -->
{% if totals.allergens is not empty or totals.traces is not empty %}
    <table style="width:100%; margin-top:16px; border:1px solid #CBD2CE; border-radius:4px; background:#fff;">
        <tr>
            <td style="padding:9px 14px; font-size:11.5pt; color:#475761;">
                <strong style="color:#16202B;">Allergènes :</strong>
                {% if totals.allergens is not empty %}
                    {% for code in totals.allergens %}{{ allergen_label(code) }}{% if not loop.last %}, {% endif %}{% endfor %}
                {% else %}—{% endif %}
                {% if totals.traces is not empty %}
                    <br><span style="color:#5B6B73;">Traces éventuelles : {% for code in totals.traces %}{{ allergen_label(code) }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
                {% endif %}
            </td>
        </tr>
    </table>
{% endif %}

{% if totals.nutrition.available %}
    <table style="width:100%; margin-top:16px; border:1px solid #CBD2CE; border-radius:4px; background:#fff;">
        <tr><td colspan="2" style="padding:9px 14px 2px; font-size:11.5pt; color:#16202B;"><strong>Valeurs nutritionnelles moyennes pour 100 g</strong>{% if not totals.nutrition.complete %} <span style="color:#7E5B1E;">(calcul incomplet — {{ totals.nutrition.missing }} élément(s) sans donnée)</span>{% endif %}</td></tr>
        <tr><td style="padding:3px 14px; font-size:11.5pt; color:#475761;">Énergie</td><td style="padding:3px 14px; font-size:11.5pt; text-align:right; color:#16202B;">{{ totals.nutrition.per_100g.energie_kj|number_format(0, ',', ' ') }} kJ / {{ totals.nutrition.per_100g.energie_kcal|number_format(0, ',', ' ') }} kcal</td></tr>
        <tr><td style="padding:3px 14px; font-size:11.5pt; color:#475761;">Matières grasses</td><td style="padding:3px 14px; font-size:11.5pt; text-align:right; color:#16202B;">{{ totals.nutrition.per_100g.lipides|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px 3px 26px; font-size:11.5pt; color:#5B6B73;">dont acides gras saturés</td><td style="padding:3px 14px; font-size:11.5pt; text-align:right; color:#5B6B73;">{{ totals.nutrition.per_100g.ag_satures|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px; font-size:11.5pt; color:#475761;">Glucides</td><td style="padding:3px 14px; font-size:11.5pt; text-align:right; color:#16202B;">{{ totals.nutrition.per_100g.glucides|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px 3px 26px; font-size:11.5pt; color:#5B6B73;">dont sucres</td><td style="padding:3px 14px; font-size:11.5pt; text-align:right; color:#5B6B73;">{{ totals.nutrition.per_100g.sucres|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px; font-size:11.5pt; color:#475761;">Protéines</td><td style="padding:3px 14px; font-size:11.5pt; text-align:right; color:#16202B;">{{ totals.nutrition.per_100g.proteines|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px 9px; font-size:11.5pt; color:#475761;">Sel</td><td style="padding:3px 14px 9px; font-size:11.5pt; text-align:right; color:#16202B;">{{ totals.nutrition.per_100g.sel|number_format(2, ',', ' ') }} g</td></tr>
        <tr><td colspan="2" style="padding:0 14px 9px; font-size:10.5pt; color:#5B6B73;">Valeurs moyennes calculées — source : Anses, table Ciqual.</td></tr>
    </table>
{% endif %}

<!-- PIED -->
<div class="footer">
    Fiche labo générée le {{ 'now'|date('d/m/Y à H:i') }} — {{ boutique().nomEtablissement }}{% if boutique().sousTitre %}, {{ boutique().sousTitre }}{% endif %}
    {% if boutique().mentionPied %}<br>{{ boutique().mentionPied }}{% endif %}
</div>

</body>
</html>
