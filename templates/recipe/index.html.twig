{% extends 'base.html.twig' %}
{% block title %}Recettes{% endblock %}
{% block page_title %}Recettes <span class="ml-2 text-sm font-normal text-gray-400">({{ recipes|length }})</span>{% endblock %}
{% block page_actions %}
    {% if is_granted('ROLE_EDITOR') %}
        <button onclick="document.getElementById('createModal').classList.remove('hidden');document.getElementById('createModal').classList.add('flex')" class="inline-flex items-center gap-2 rounded-lg bg-blue-500 hover:bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition-colors"><i class="fas fa-plus text-[11px]"></i> Nouvelle recette</button>
    {% endif %}
{% endblock %}

{% block body %}
    {# Indicateurs — chacun doit déclencher une action, sinon il n'a rien à faire ici #}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">Recettes</p>
            <p class="text-2xl font-bold text-[#1c2434] mt-1">{{ recipes|length }}</p>
        </div>
        <div class="rounded-2xl border {{ underpriced|length ? 'border-red-200 bg-red-50/50' : 'border-gray-200 bg-white' }} px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider {{ underpriced|length ? 'text-red-600' : 'text-gray-400' }}">Sous le prix conseillé</p>
            <p class="text-2xl font-bold {{ underpriced|length ? 'text-red-700' : 'text-[#1c2434]' }} mt-1">{{ underpriced|length }}</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">Marque réelle médiane</p>
            <p class="text-2xl font-bold {{ medianMarkup is null ? 'text-gray-300' : 'text-emerald-600' }} mt-1">
                {{ medianMarkup is null ? '—' : medianMarkup|number_format(1) ~ ' %' }}
            </p>
            <p class="text-[10px] text-gray-400 mt-0.5">sur {{ pricedCount }} recette(s) tarifée(s)</p>
        </div>
        <div class="rounded-2xl border {{ invoice_pending_count() ? 'border-amber-200 bg-amber-50/50' : 'border-gray-200 bg-white' }} px-5 py-4">
            <p class="text-[11px] font-semibold uppercase tracking-wider {{ invoice_pending_count() ? 'text-amber-600' : 'text-gray-400' }}">Factures à valider</p>
            <p class="text-2xl font-bold {{ invoice_pending_count() ? 'text-amber-700' : 'text-[#1c2434]' }} mt-1">{{ invoice_pending_count() }}</p>
            {% if invoice_pending_count() %}
                <a href="{{ path('app_invoice_index') }}" class="text-[10px] text-amber-700 hover:underline">traiter maintenant</a>
            {% endif %}
        </div>
    </div>

    {# Alerte : vendu sous l'objectif. Silencieuse quand tout va bien. #}
    {% if underpriced|length %}
        <div class="rounded-2xl border border-red-200 bg-white mb-6 overflow-hidden">
            <div class="px-5 py-3 bg-red-50/70 border-b border-red-100 flex items-center gap-2">
                <i class="fas fa-triangle-exclamation text-red-500 text-sm"></i>
                <h3 class="font-semibold text-[14px] text-red-800">
                    {{ underpriced|length }} recette(s) vendue(s) sous le prix conseillé
                </h3>
            </div>
            <div class="divide-y divide-gray-50">
                {% for r in underpriced|slice(0, 5) %}
                    <div class="flex items-center gap-4 px-5 py-3">
                        <a href="{{ path('app_recipe_show', {id: r.id}) }}" class="flex-1 min-w-0 font-medium text-sm text-blue-600 hover:text-blue-800">{{ r.name }}</a>
                        <div class="text-right text-xs text-gray-500 w-40 flex-shrink-0">
                            pratiqué <strong class="text-gray-700">{{ r.sellPriceTtc|number_format(2, ',', ' ') }} €</strong>
                            · conseillé {{ r.costCache.advisedSellTtc|number_format(2, ',', ' ') }} €
                        </div>
                        <div class="text-right w-24 flex-shrink-0">
                            <span class="font-bold text-red-600 text-sm">{{ r.priceGapPercent|number_format(1, ',', ' ') }} %</span>
                        </div>
                        <div class="text-right w-28 flex-shrink-0 text-xs text-gray-500">
                            marque réelle <strong class="{{ r.realMarkupPercent < 15 ? 'text-red-600' : 'text-gray-700' }}">{{ r.realMarkupPercent|number_format(1) }} %</strong>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% if underpriced|length > 5 %}
                <p class="px-5 py-2.5 text-[11px] text-gray-500 bg-gray-50/70 border-t border-gray-100">
                    et {{ underpriced|length - 5 }} autre(s) — triées de la plus grosse perte à la plus faible.
                </p>
            {% endif %}
        </div>
    {% endif %}

    {# Table #}
    <div class="rounded-2xl border border-gray-200 bg-white">
        <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="relative">
                <input type="text" id="searchInput" placeholder="Rechercher…" class="w-60 pl-9 pr-3 py-2 rounded-lg border border-gray-200 text-sm outline-none focus:border-blue-400 bg-gray-50 placeholder-gray-400">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
            </div>
            <div class="flex items-center gap-3">
                <label class="text-sm text-gray-500">Afficher</label>
                <select id="perPage" class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm bg-white outline-none focus:border-blue-400">
                    <option value="10" selected>10</option><option value="25">25</option><option value="50">50</option>
                </select>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead><tr class="border-b border-gray-100">
                    <th class="py-3 px-5 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Nom</th>
                    <th class="py-3 px-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Famille</th>
                    <th class="py-3 px-3 text-center text-xs font-medium uppercase tracking-wider text-gray-400">Sortie</th>
                    <th class="py-3 px-3 text-right text-xs font-medium uppercase tracking-wider text-gray-400">Coût/u HT</th>
                    <th class="py-3 px-3 text-right text-xs font-medium uppercase tracking-wider text-gray-400">PV conseillé</th>
                    <th class="py-3 px-3 text-right text-xs font-medium uppercase tracking-wider text-gray-400">PV pratiqué</th>
                    <th class="py-3 px-3 text-right text-xs font-medium uppercase tracking-wider text-gray-400">Marque</th>
                    <th class="py-3 px-5 text-center text-xs font-medium uppercase tracking-wider text-gray-400" style="min-width:80px">Actions</th>
                </tr></thead>
                <tbody class="divide-y divide-gray-50">
                {% for r in recipes %}
                    <tr class="dt-row hover:bg-gray-50/50 transition-colors" data-search="{{ r.name|lower }} {{ r.family|lower }}">
                        <td class="py-3 px-5">
                            <a href="{{ path('app_recipe_show', {id: r.id}) }}" class="font-medium text-blue-600 hover:text-blue-800">{{ r.name }}</a>
                        </td>
                        <td class="py-3 px-3"><span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-[11px] font-medium text-gray-600">{{ r.family }}</span></td>
                        <td class="py-3 px-3 text-center text-gray-600">{{ r.outputValue }} {{ r.outputUnitLabel }}</td>
                        <td class="py-3 px-3 text-right font-semibold text-gray-700">{{ r.costCache ? r.costCache.costPerOutputHt|number_format(2, ',', ' ') ~ ' €' : '—' }}</td>
                        <td class="py-3 px-3 text-right text-gray-500">{{ r.costCache ? r.costCache.advisedSellTtc|number_format(2, ',', ' ') ~ ' €' : '—' }}</td>
                        <td class="py-3 px-3 text-right">
                            {% if r.hasSellPrice %}
                                <span class="font-semibold text-[#1c2434]">{{ r.sellPriceTtc|number_format(2, ',', ' ') }} €</span>
                                {% if r.priceGapPercent is not null and r.priceGapPercent < -2 %}
                                    <span class="block text-[10px] font-semibold text-red-600">{{ r.priceGapPercent|number_format(1) }} %</span>
                                {% endif %}
                            {% else %}
                                <span class="text-gray-300">—</span>
                            {% endif %}
                        </td>
                        {# Marque réelle dès que le prix pratiqué est connu ; sinon
                           la théorique, signalée comme telle pour ne pas tromper. #}
                        <td class="py-3 px-3 text-right">
                            {% set markup = r.realMarkupPercent is not null ? r.realMarkupPercent : (r.costCache ? r.costCache.marginPercent : null) %}
                            {% if markup is not null %}
                                <span class="font-semibold {{ markup >= 30 ? 'text-emerald-600' : (markup >= 15 ? 'text-amber-600' : 'text-red-600') }}">{{ markup|number_format(1) }}%</span>
                                {% if r.realMarkupPercent is null %}
                                    <span class="block text-[10px] text-gray-400">théorique</span>
                                {% endif %}
                            {% else %}—{% endif %}
                        </td>
                        <td class="py-3 px-5 text-center">
                            <a href="{{ path('app_recipe_show', {id: r.id}) }}" class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-blue-500 hover:bg-blue-50 transition-colors" title="Ouvrir"><i class="fas fa-eye text-xs"></i></a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="py-16 text-center text-gray-400 text-sm">Aucune recette.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="px-5 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <p class="text-sm text-gray-500" id="paginationInfo">—</p>
            <nav class="flex items-center gap-1" id="paginationNav"></nav>
        </div>
    </div>

    {# Create Modal #}
    <div id="createModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <form method="post" action="{{ path('app_recipe_create') }}" class="bg-white rounded-2xl shadow-xl w-full max-w-lg mx-4 max-h-[90vh] overflow-y-auto">
            <div class="px-6 py-4 border-b border-gray-100"><h3 class="font-semibold text-[#1c2434]"><i class="fas fa-plus text-blue-500 mr-2 text-sm"></i>Nouvelle recette</h3></div>
            <div class="p-6 space-y-4">
                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Nom *</label><input type="text" name="name" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20"></div>
                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Famille *</label>
                    <select name="family" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white">
                        {% for f in families %}<option value="{{ f.name }}">{{ f.name }}</option>{% endfor %}
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Type sortie</label><select name="output_type" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white"><option value="weight">Poids (kg)</option><option value="portion">Portions</option></select></div>
                    <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Quantité sortie *</label><input type="number" name="output_value" step="0.001" value="5" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Mode prix</label><select name="pricing_mode" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white"><option value="coef">Coefficient (× coût HT)</option><option value="margin">Taux de marque (% du PV)</option></select></div>
                    <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Objectif</label><input type="number" name="pricing_value" step="0.01" value="{{ boutique().coefDefaut }}" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-medium text-gray-600 mb-1.5">TVA produit %</label><input type="number" name="product_vat_rate" step="0.01" value="{{ boutique().tvaDefaut }}" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div>
                    <div></div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1.5">Main d'œuvre (minutes)</label>
                        <input type="number" name="labor_minutes" min="0" step="1" value="0"
                               data-taux="{{ boutique().tauxHoraireMo }}" oninput="majCoutMO(this)"
                               class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400">
                        <p class="text-xs text-gray-400 mt-1">≈ <span class="cout-mo">0,00</span> € HT (taux : {{ boutique().tauxHoraireMo }} €/h)</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-600 mb-1.5">Emballage (€ HT)</label>
                        <input type="number" name="packaging_cost_ht" step="0.01" value="0"
                               class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400">
                    </div>
                </div>
                <input type="hidden" name="loss_percent" value="0">
                <input type="hidden" name="yield_percent" value="100">
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button>
                <button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white">Créer</button>
            </div>
        </form></div>
{% endblock %}

{% block javascripts %}
    <script>
        const allRows=[...document.querySelectorAll('.dt-row')];let filtered=[...allRows],currentPage=1,perPage=parseInt(document.getElementById('perPage').value);
        function applyPagination(){allRows.forEach(r=>r.style.display='none');const s=(currentPage-1)*perPage,e=Math.min(s+perPage,filtered.length);filtered.slice(s,e).forEach(r=>r.style.display='');document.getElementById('paginationInfo').textContent=filtered.length===0?'Aucun résultat':`Affichage de ${s+1} à ${e} sur ${filtered.length}`;renderNav();}
        function renderNav(){const nav=document.getElementById('paginationNav'),tp=Math.max(1,Math.ceil(filtered.length/perPage));nav.innerHTML='';const bc='w-9 h-9 flex items-center justify-center rounded-lg text-sm transition-colors',ac='bg-blue-500 text-white font-medium',nc='border border-gray-200 text-gray-600 hover:bg-gray-50',dc='border border-gray-100 text-gray-300 cursor-not-allowed';const prev=Object.assign(document.createElement('button'),{type:'button',className:`${bc} ${currentPage===1?dc:nc}`,innerHTML:'<i class="fas fa-chevron-left text-[10px]"></i>',disabled:currentPage===1});prev.onclick=()=>{if(currentPage>1){currentPage--;applyPagination();}};nav.appendChild(prev);const mx=5;let sp=Math.max(1,currentPage-Math.floor(mx/2)),ep=Math.min(tp,sp+mx-1);if(ep-sp<mx-1)sp=Math.max(1,ep-mx+1);if(sp>1){nav.appendChild(mkB(1));if(sp>2)nav.appendChild(mkD());}for(let i=sp;i<=ep;i++)nav.appendChild(mkB(i));if(ep<tp){if(ep<tp-1)nav.appendChild(mkD());nav.appendChild(mkB(tp));}const next=Object.assign(document.createElement('button'),{type:'button',className:`${bc} ${currentPage===tp?dc:nc}`,innerHTML:'<i class="fas fa-chevron-right text-[10px]"></i>',disabled:currentPage===tp});next.onclick=()=>{if(currentPage<tp){currentPage++;applyPagination();}};nav.appendChild(next);function mkB(p){const b=Object.assign(document.createElement('button'),{type:'button',className:`${bc} ${p===currentPage?ac:nc}`,textContent:p});b.onclick=()=>{currentPage=p;applyPagination();};return b;}function mkD(){const s=document.createElement('span');s.className='w-9 h-9 flex items-center justify-center text-gray-400 text-xs';s.textContent='…';return s;}}
        document.getElementById('searchInput').addEventListener('input',function(){const q=this.value.toLowerCase().trim();filtered=q===''?[...allRows]:allRows.filter(r=>r.dataset.search.includes(q));currentPage=1;applyPagination();});
        document.getElementById('perPage').addEventListener('change',function(){perPage=parseInt(this.value);currentPage=1;applyPagination();});
        applyPagination();

        // Aperçu du coût de main d'œuvre (minutes → euros)
        function majCoutMO(input){
            const taux = parseFloat(input.dataset.taux) || 0;
            const min  = parseFloat(input.value) || 0;
            const span = input.closest('div').querySelector('.cout-mo');
            if (span) span.textContent = (min / 60 * taux).toFixed(2).replace('.', ',');
        }
        document.querySelectorAll('input[name="labor_minutes"]').forEach(majCoutMO);
    </script>
{% endblock %}
