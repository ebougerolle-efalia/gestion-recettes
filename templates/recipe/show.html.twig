{% extends 'base.html.twig' %}
{% block title %}{{ recipe.name }}{% endblock %}
{% block page_title %}{{ recipe.name }}{% endblock %}
{% block page_subtitle %}<span class="inline-flex items-center rounded-full bg-voile px-2 py-0.5 text-2xs font-medium text-ardoise-doux">{{ recipe.family }}</span> · {{ recipe.outputValue }} {{ recipe.outputUnitLabel }}{% endblock %}
{% block page_actions %}
    <div class="flex items-center gap-2">
        {% if is_granted('ROLE_EDITOR') %}<button type="button" onclick="document.getElementById('paramsModal').classList.remove('hidden');document.getElementById('paramsModal').classList.add('flex')" class="inline-flex items-center gap-1.5 rounded-lg border border-trait px-3 py-2 text-xs text-ardoise-doux hover:bg-voile transition-colors"><i class="fas fa-pen text-[12px]"></i> Modifier</button>{% endif %}
        <button type="button" onclick="toggleInfo()" class="inline-flex items-center gap-1.5 rounded-lg border border-trait px-3 py-2 text-xs text-ardoise-doux hover:bg-voile transition-colors"><i class="fas fa-table-columns text-[12px]"></i> <span id="infoToggleLabel">Afficher infos</span></button>
        <button onclick="openPrintModal()" class="inline-flex items-center gap-1.5 rounded-lg border border-trait px-3 py-2 text-xs text-ardoise-doux hover:bg-voile transition-colors"><i class="fas fa-print text-[12px]"></i> Imprimer</button>
        {% if is_granted('ROLE_EDITOR') %}
            <button onclick="document.getElementById('dupeModal').classList.remove('hidden');document.getElementById('dupeModal').classList.add('flex')" class="inline-flex items-center gap-1.5 rounded-lg border border-trait px-3 py-2 text-xs text-ardoise-doux hover:bg-voile transition-colors"><i class="fas fa-copy text-[12px]"></i> Dupliquer</button>
        {% endif %}
    </div>
{% endblock %}

{% block body %}
    {% set t = totals %}
    {% set unitLabel = recipe.outputUnitLabel %}
    {% set canEdit = is_granted('ROLE_EDITOR') %}

    <div class="mb-4">
        <a href="{{ path('app_recipe_index') }}" class="inline-flex items-center gap-1.5 text-sm text-ardoise-doux hover:text-laiton-patine transition-colors"><i class="fas fa-arrow-left text-[12px]"></i> Retour aux recettes</a>
    </div>

    {# ══ Bandeau d'alertes : coûts potentiellement faussés ══ #}
    {% set w = t.warnings %}
    {% if w.total > 0 %}
        <div class="mb-5 rounded-xl border border-laiton/40 bg-laiton-voile px-5 py-2.5 text-sm text-laiton-patine">
            <div class="flex items-center gap-2 font-semibold mb-1.5">
                <i class="fas fa-triangle-exclamation"></i> Attention : le coût affiché peut être sous-évalué
            </div>
            <ul class="list-disc ml-5 space-y-0.5 text-laiton-patine">
                {% if w.no_price > 0 %}<li>{{ w.no_price }} ligne(s) sans prix d'ingrédient → comptées à 0 €.</li>{% endif %}
                {% if w.unit_mismatch > 0 %}<li>{{ w.unit_mismatch }} ligne(s) avec une unité incompatible avec l'ingrédient → comptées à 0 €.</li>{% endif %}
                {% if w.approx_density > 0 %}<li>{{ w.approx_density }} conversion(s) litre↔kg approximative(s) (densité = 1).</li>{% endif %}
                {% if w.output_exceeds_input %}<li>La sortie déclarée ({{ t.output_effective }} kg) dépasse la masse nette des ingrédients ({{ w.net_input_kg }} kg) : vérifiez la quantité de sortie.</li>{% endif %}
                {% if w.pricing == 'markup_over_100' %}<li>Le taux de marque ≥ 100 % est impossible : aucun prix de vente n'a pu être calculé.</li>{% endif %}
            </ul>
        </div>
    {% endif %}

    {# ── La balance ─────────────────────────────────────────────────────────

       L'écran central prend la forme de l'instrument du métier, qui est aussi
       la marque de l'application : deux plateaux, ce que ça coûte à gauche, ce
       que ça rapporte à droite, et la marque au milieu comme l'aiguille.

       Ce n'est pas une illustration posée sur des chiffres. Le fléau penche
       réellement selon l'écart entre le prix pratiqué et le prix conseillé :
       vendre en dessous alourdit le plateau du coût. Sans prix pratiqué, la
       balance reste à l'équilibre et montre le conseillé — elle ne prétend pas
       savoir ce qu'on ignore.

       Tous les nombres passent par des séparateurs français explicites : sans
       eux, number_format rend « 61.5 % » à côté de « 1,67 € ». ── #}
    {% set hasReal = t.real_markup_percent is not null %}
    {% set marque  = hasReal ? t.real_markup_percent : t.markup_percent %}
    {% set marge   = hasReal ? t.real_margin_ht : t.margin_ht %}
    {% set ecart   = t.price_gap_percent %}

    {# Inclinaison, bornée à ±7° pour qu'un écart extrême ne renverse pas le
       dessin. En SVG l'axe Y descend : une rotation NÉGATIVE fait descendre le
       bras gauche. Vendre sous le conseillé (écart négatif) alourdit donc bien
       le plateau du coût, et vendre au-dessus fait pencher celui de la recette.
       L'angle suit directement le signe de l'écart — pas de négation, elle
       inversait le sens. #}
    {% set inclinaison = 0 %}
    {% if hasReal and ecart is not null %}
        {% set inclinaison = ecart < -14 ? -7 : (ecart > 14 ? 7 : ecart / 2) %}
    {% endif %}

    {# Trois états, et non deux.

       Colorer selon le seul écart affichait en rouge des recettes à 52 % de
       marque vendues 3 % sous le conseillé — alarmiste et faux. Mais s'en tenir
       au signe de la marge rendait la couleur muette : verte presque toujours.

       Le laiton dit « à regarder », pas « au secours ». Le rouge reste réservé
       à la perte réelle. Le seuil est à 5 % : en deçà, l'écart relève de
       l'arrondi à l'étiquette ou du prix psychologique, pas d'une dérive. #}
    {% set etat = 'sain' %}
    {% if marge <= 0 %}
        {% set etat = 'perte' %}
    {% elseif hasReal and ecart is not null and ecart < -5 %}
        {% set etat = 'vigilance' %}
    {% endif %}

    {% set teinteTexte  = {'perte': 'text-sang',   'vigilance': 'text-laiton-patine', 'sain': 'text-pousse'}[etat] %}
    {% set teinteTrait  = {'perte': 'stroke-sang', 'vigilance': 'stroke-laiton',      'sain': 'stroke-pousse'}[etat] %}
    {% set teinteFond   = {'perte': 'fill-sang/15','vigilance': 'fill-laiton/20',     'sain': 'fill-pousse/15'}[etat] %}
    {% set teintePleine = {'perte': 'fill-sang',   'vigilance': 'fill-laiton',        'sain': 'fill-pousse'}[etat] %}

    {# Libellé de la fournée. « 30 portion » se lisait comme une faute ; et un
       poids de sortie décimal (2,4 kg) doit garder la virgule française. #}
    {% set sortieNombre = recipe.outputValue|number_format(recipe.outputValue == recipe.outputValue|round ? 0 : 2, ',', ' ') %}
    {% set unitPluriel  = (unitLabel == 'portion' and recipe.outputValue > 1) ? 'portions' : unitLabel %}
    {% set fournee      = sortieNombre ~ ' ' ~ unitPluriel %}

    <div class="rounded-2xl border border-trait bg-white mb-4 overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr]">

            {# ── Plateau gauche : ce que ça coûte ── #}
            <div class="px-5 py-4">
                <div class="flex items-baseline justify-between gap-3 mb-2.5">
                    <p class="text-2xs font-semibold uppercase tracking-[0.14em] text-ardoise-faible">Ce que ça coûte</p>
                    <p class="text-2xs text-ardoise-faible">pour {{ fournee }}</p>
                </div>

                <dl class="space-y-1.5 text-sm">
                    <div class="flex justify-between gap-3">
                        <dt class="text-ardoise-doux">Matières</dt>
                        <dd class="tabular-nums text-ardoise">{{ t.material_cost_ht|number_format(2, ',', ' ') }} €</dd>
                    </div>
                    <div class="flex justify-between gap-3">
                        <dt class="text-ardoise-doux">Main d'œuvre</dt>
                        <dd class="tabular-nums text-ardoise">{{ t.labor_cost_ht|number_format(2, ',', ' ') }} €</dd>
                    </div>
                    <div class="flex justify-between gap-3">
                        <dt class="text-ardoise-doux">Emballage</dt>
                        <dd class="tabular-nums text-ardoise">{{ t.packaging_cost_ht|number_format(2, ',', ' ') }} €</dd>
                    </div>
                </dl>

                <div class="mt-2.5 pt-2.5 border-t border-trait flex justify-between items-baseline gap-3">
                    <span class="text-sm font-semibold text-ardoise">Coût de revient</span>
                    <span class="text-xl font-bold tabular-nums text-ardoise">{{ t.total_cost_ht|number_format(2, ',', ' ') }} €</span>
                </div>
                <p class="text-2xs text-ardoise-faible mt-1 text-right">
                    soit {{ t.cost_per_output_ht|number_format(2, ',', ' ') }} € / {{ unitLabel }} ·
                    ratio matière <span class="{{ t.material_ratio_percent > 40 ? 'font-semibold text-laiton-patine' : '' }}">{{ t.material_ratio_percent|number_format(1, ',', ' ') }} %</span>
                </p>
            </div>

            {# ── L'aiguille ── #}
            <div class="px-5 py-4 border-t lg:border-t-0 lg:border-x border-trait-fin bg-voile/40 flex flex-col items-center justify-center min-w-[190px]">
                <svg viewBox="0 0 150 84" width="150" height="84" role="img" class="balance-recette"
                     aria-label="Balance : {{ hasReal ? 'prix pratiqué' : 'prix conseillé' }}, marque {{ marque|number_format(1, ',', ' ') }} %">
                    {# Fléau et suspentes : un seul groupe, il pivote d'un bloc. #}
                    <g style="transform: rotate({{ inclinaison }}deg); transform-origin: 75px 26px;"
                       fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                       class="{{ teinteTexte }}">
                        <path d="M28 26h94"/>
                        <path d="M34 26v7"/>
                        <path d="M116 26v7"/>
                    </g>
                    {# Colonne et socle : fixes. #}
                    <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                       class="{{ teinteTexte }}">
                        <path d="M75 26v40"/>
                        <path d="M60 66h30"/>
                    </g>
                    <circle cx="75" cy="23" r="3.4" class="{{ teintePleine }}"/>
                    {# Plateaux : ils suivent les extrémités du fléau. 120 px de
                       demi-fléau, sin(7°) ≈ 0,122 → 7,3 px au maximum. #}
                    <path d="M20 36h28l-14 15z" stroke-width="2.4" stroke-linejoin="round"
                          class="{{ teinteTrait }} {{ teinteFond }}"
                          style="transform: translateY({{ (inclinaison * -1.04)|round(1) }}px);"/>
                    <path d="M102 36h28l-14 15z" stroke-width="2.4" stroke-linejoin="round"
                          class="{{ teinteTrait }} {{ teinteFond }}"
                          style="transform: translateY({{ (inclinaison * 1.04)|round(1) }}px);"/>
                </svg>

                <p class="text-2xs font-semibold uppercase tracking-[0.14em] text-ardoise-faible mt-1">
                    Marque {{ hasReal ? 'réelle' : 'conseillée' }}
                </p>
                <p class="text-3xl font-extrabold tabular-nums leading-none mt-0.5 {{ teinteTexte }}">
                    {{ marque|number_format(1, ',', ' ') }} %
                </p>
                <p class="text-2xs text-ardoise-faible mt-1 text-center">
                    marge {{ t.margin_on_cost_percent|number_format(1, ',', ' ') }} % · coef ×{{ t.coefficient|number_format(2, ',', ' ') }}
                </p>
            </div>

            {# ── Plateau droit : ce que ça rapporte ── #}
            <div class="px-5 py-4 border-t lg:border-t-0 border-trait-fin">
                <div class="flex items-baseline justify-between gap-3 mb-2.5">
                    <p class="text-2xs font-semibold uppercase tracking-[0.14em] text-ardoise-faible">Ce que ça rapporte</p>
                    <p class="text-2xs text-ardoise-faible">pour {{ fournee }}</p>
                </div>

                {# Les deux plateaux doivent peser la même chose. Celui de gauche
                   totalise la fournée ; celui-ci mêlait des prix à l'unité et un
                   total, si bien qu'on lisait 98,92 € face à 6,33 € sans savoir
                   ce qui se comparait à quoi.

                   Un prix de vente n'a de sens qu'à l'unité : on ne vend pas la
                   fournée. Plutôt que de le convertir, les deux natures sont
                   séparées — le tarif d'abord, puis ce que la fournée encaisse
                   et laisse. Le grand chiffre du bas est alors homogène au coût
                   de revient d'en face. #}
                {% set pvUnitaireHt  = hasReal ? t.real_sell_ht : t.advised_sell_ht %}
                {% set recetteTotale = pvUnitaireHt * recipe.outputValue %}
                {# Par différence, et non « marge unitaire × sortie » : la marge
                   unitaire est arrondie au centime, et 2,70 × 30 donnait 81,00
                   sous une soustraction affichée qui vaut 81,08. Une addition
                   visible doit tomber juste. #}
                {% set margeTotale   = recetteTotale - t.total_cost_ht %}
                {% set margeUnitaire = recipe.outputValue > 0 ? margeTotale / recipe.outputValue : 0 %}

                <p class="text-2xs text-ardoise-faible mb-1">Tarif, par {{ unitLabel }}</p>
                <dl class="space-y-1.5 text-sm">
                    <div class="flex justify-between gap-3">
                        <dt class="text-ardoise-doux">Prix conseillé TTC</dt>
                        <dd class="tabular-nums text-ardoise">{{ t.advised_sell_ttc|number_format(2, ',', ' ') }} €</dd>
                    </div>
                    <div class="flex justify-between gap-3">
                        <dt class="text-ardoise-doux">Prix pratiqué TTC</dt>
                        <dd class="tabular-nums {{ t.real_sell_ttc is null ? 'text-ardoise-faible' : 'text-ardoise font-semibold' }}">
                            {% if t.real_sell_ttc is null %}
                                — à renseigner
                            {% else %}
                                {{ t.real_sell_ttc|number_format(2, ',', ' ') }} €
                            {% endif %}
                        </dd>
                    </div>
                    {% if hasReal and ecart is not null %}
                        <div class="flex justify-between gap-3">
                            <dt class="text-ardoise-doux">Écart au conseillé</dt>
                            <dd class="tabular-nums font-semibold {{ ecart < -5 ? 'text-laiton-patine' : (ecart > 2 ? 'text-pousse' : 'text-ardoise') }}">
                                {{ ecart > 0 ? '+' : '' }}{{ ecart|number_format(1, ',', ' ') }} %
                            </dd>
                        </div>
                    {% endif %}
                </dl>

                <p class="text-2xs text-ardoise-faible mt-3 mb-1 pt-2.5 border-t border-trait-fin">Sur la fournée de {{ fournee }}</p>
                <dl class="space-y-1.5 text-sm">
                    <div class="flex justify-between gap-3">
                        <dt class="text-ardoise-doux">Chiffre d'affaires HT</dt>
                        <dd class="tabular-nums text-ardoise">{{ recetteTotale|number_format(2, ',', ' ') }} €</dd>
                    </div>
                    <div class="flex justify-between gap-3">
                        <dt class="text-ardoise-doux">Coût de revient</dt>
                        <dd class="tabular-nums text-ardoise">− {{ t.total_cost_ht|number_format(2, ',', ' ') }} €</dd>
                    </div>
                </dl>

                <div class="mt-2.5 pt-2.5 border-t border-trait flex justify-between items-baseline gap-3">
                    <span class="text-sm font-semibold text-ardoise">Marge {{ hasReal ? 'réelle' : 'conseillée' }}</span>
                    <span class="text-xl font-bold tabular-nums {{ margeTotale > 0 ? 'text-pousse' : 'text-sang' }}">{{ margeTotale|number_format(2, ',', ' ') }} €</span>
                </div>
                <p class="text-2xs text-ardoise-faible mt-1 text-right">
                    soit {{ margeUnitaire|number_format(2, ',', ' ') }} € / {{ unitLabel }}
                    {% if not hasReal %} · aucun prix pratiqué renseigné{% endif %}
                </p>
            </div>
        </div>
    </div>

    {# Zone de travail : contenu principal + barre latérale droite (repliable, masquée par défaut) #}
    <div id="recipeLayout" class="flex flex-col lg:flex-row gap-6 items-start">

        {# ── Contenu principal : Paramètres + onglets (Composition / Analyse des coûts) ── #}
        <div class="flex-1 min-w-0 space-y-6">

            {# Paramètres — résumé sur une ligne (édition via le bouton « Modifier » de l'en-tête) #}
            <div class="rounded-xl border border-trait bg-voile/60 px-4 py-2.5 flex items-center flex-wrap gap-x-2 gap-y-1 text-xs text-ardoise-doux">
                <i class="fas fa-sliders text-ardoise-faible text-xs mr-0.5"></i>
                <span>{{ recipe.outputType == 'weight' ? 'Poids' : 'Portions' }} · sortie <strong class="font-semibold text-ardoise">{{ recipe.outputValue }} {{ unitLabel }}</strong></span>
                <span class="text-ardoise-faible">|</span>
                <span>perte <strong class="font-semibold text-ardoise">{{ recipe.lossPercent|number_format(1, ',', ' ') }} %</strong></span>
                <span class="text-ardoise-faible">|</span>
                <span>rdt <strong class="font-semibold text-ardoise">{{ recipe.yieldPercent|number_format(1, ',', ' ') }} %</strong></span>
                <span class="text-ardoise-faible">|</span>
                <span>TVA <strong class="font-semibold text-ardoise">{{ recipe.productVatRate|number_format(1, ',', ' ') }} %</strong></span>
                <span class="text-ardoise-faible">|</span>
                <span>MO <strong class="font-semibold text-ardoise">{{ t.labor_cost_ht|number_format(2, ',', ' ') }} €</strong> ({{ recipe.laborMinutes }} min)</span>
                <span class="text-ardoise-faible">|</span>
                <span>emballage <strong class="font-semibold text-ardoise">{{ recipe.packagingCostHt|number_format(2, ',', ' ') }} €</strong></span>
                <span class="text-ardoise-faible">|</span>
                <span>{{ recipe.pricingMode == 'coef' ? 'coef cible' : 'marque cible' }} <strong class="font-semibold text-ardoise">{{ recipe.pricingMode == 'coef' ? '× ' ~ (recipe.pricingValue|number_format(2, ',', ' ')) : (recipe.pricingValue|number_format(1, ',', ' ')) ~ ' %' }}</strong></span>
            </div>

            {# Carte à onglets : Composition / Analyse des coûts #}
            <div class="rounded-2xl border border-trait bg-white">
                <div class="px-4 border-b border-trait-fin flex items-center justify-between">
                    <div class="flex">
                        <button type="button" id="tabBtn-compo" onclick="showRecipeTab('compo')" class="tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-ardoise-doux transition-colors">Composition <span class="text-xs text-ardoise-faible ml-0.5">({{ lines|length }})</span></button>
                        {% if t.total_cost_ht > 0 %}<button type="button" id="tabBtn-couts" onclick="showRecipeTab('couts')" class="tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-ardoise-doux transition-colors">Analyse des coûts</button>{% endif %}
                        {# Onglet toujours présent, même sans étape saisie : c'est
                           ainsi qu'on découvre que la fiche peut en porter. Le
                           panneau invite alors à en écrire. #}
                        <button type="button" id="tabBtn-process" onclick="showRecipeTab('process')" class="tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-ardoise-doux transition-colors">
                            Mode opératoire
                            {% if recipe.processSteps is not empty %}<span class="text-xs text-ardoise-faible ml-0.5">({{ recipe.processSteps|length }})</span>{% endif %}
                        </button>
                    </div>
                    {% if canEdit %}
                        <button onclick="document.getElementById('addLineModal').classList.remove('hidden');document.getElementById('addLineModal').classList.add('flex')" class="inline-flex items-center gap-1.5 rounded-lg bg-ardoise hover:bg-ardoise-clair px-3 py-1.5 text-xs font-medium text-white transition-colors"><i class="fas fa-plus text-[12px]"></i> Ajouter</button>
                    {% endif %}
                </div>

                {# Panneau : Composition (tableau condensé) #}
                <div id="tab-compo">
                    {% if lines|length == 0 %}
                        <div class="py-16 text-center text-ardoise-faible"><i class="fas fa-leaf text-3xl mb-3 block text-ardoise-faible"></i><p class="text-sm">Aucun ingrédient</p></div>
                    {% else %}
                        <div class="grid grid-cols-[minmax(0,1fr)_70px_90px_92px_68px] gap-2 px-5 py-2 text-2xs uppercase tracking-wider text-ardoise-faible border-b border-trait-fin">
                            <div>Ingrédient</div>
                            <div class="text-right">Brut</div>
                            <div class="text-right">Coût HT</div>
                            <div class="text-right">€ / unité</div>
                            <div></div>
                        </div>
                        <div class="divide-y divide-trait-fin">
                            {% for l in lines %}
                                <div class="grid grid-cols-[minmax(0,1fr)_70px_90px_92px_68px] gap-2 px-5 py-2.5 items-center hover:bg-voile/50 transition-colors">
                                    <div class="min-w-0">
                                        <div class="text-sm font-medium text-ardoise">
                                            {% if l.type == 'ingredient' %}{{ l.ingredient.name }}{% else %}{{ l.sub_recipe.name }} <span class="ml-1 inline-flex items-center rounded-full bg-voile px-1.5 py-px text-2xs font-medium text-laiton-patine">sous-recette</span>{% endif %}
                                            {% if 'no_price' in l.warnings %}<span class="ml-1 inline-flex items-center rounded-full bg-sang-voile px-1.5 py-px text-2xs font-medium text-sang" title="Aucun prix : ligne comptée à 0 €"><i class="fas fa-tag mr-0.5 text-[12px]"></i>sans prix</span>{% endif %}
                                            {% if 'unit_mismatch' in l.warnings %}<span class="ml-1 inline-flex items-center rounded-full bg-sang-voile px-1.5 py-px text-2xs font-medium text-sang" title="Unité incompatible : ligne comptée à 0 €"><i class="fas fa-triangle-exclamation mr-0.5 text-[12px]"></i>unité ?</span>{% endif %}
                                            {% if 'approx_density' in l.warnings %}<span class="ml-1 inline-flex items-center rounded-full bg-laiton-voile px-1.5 py-px text-2xs font-medium text-laiton-patine" title="Conversion litre↔kg approximative (densité = 1)">≈ densité</span>{% endif %}
                                        </div>
                                        <div class="text-xs text-ardoise-faible mt-0.5">perte {{ l.loss_percent|number_format(1, ',', ' ') }}%<span class="text-ardoise-faible mx-1">·</span>rdt {{ l.yield_percent|number_format(1, ',', ' ') }}%{% if l.note %}<span class="text-ardoise-faible mx-1">·</span><span class="text-laiton-patine italic">{{ l.note }}</span>{% endif %}</div>
                                    </div>
                                    <div class="text-right text-sm text-ardoise-doux">{{ l.qty_brute }} {{ l.unit }}</div>
                                    <div class="text-right text-sm font-semibold text-ardoise">{{ l.line_cost_ht|number_format(2, ',', ' ') }} €</div>
                                    <div class="text-right text-2xs text-ardoise-faible">{{ l.price_ht_per_base_unit|number_format(2, ',', ' ') }} €/{% if l.type == 'ingredient' %}{{ l.ingredient.base_unit }}{% else %}{{ unitLabel }}{% endif %}</div>
                                    <div class="flex items-center justify-end gap-1">
                                        {% if canEdit %}
                                            {# Les données de la ligne voyagent dans les attributs : le
                                               formulaire de modification est unique et se remplit à
                                               l'ouverture, plutôt que d'être répété pour chaque ligne. #}
                                            <button type="button"
                                                    onclick="openEditLine(this)"
                                                    data-id="{{ l.line_id }}"
                                                    data-nom="{{ l.type == 'ingredient' ? l.ingredient.name : l.sub_recipe.name }}"
                                                    data-qty="{{ l.qty_brute }}"
                                                    data-unit="{{ l.unit }}"
                                                    data-perte="{{ l.loss_percent }}"
                                                    data-rdt="{{ l.yield_percent }}"
                                                    data-note="{{ l.note }}"
                                                    title="Modifier cette ligne"
                                                    class="w-7 h-7 inline-flex items-center justify-center rounded-lg text-ardoise-faible hover:text-laiton-patine hover:bg-laiton-voile transition-colors">
                                                <i class="fas fa-pen text-[12px]"></i>
                                            </button>
                                            <form method="post" action="{{ path('app_recipe_remove_line', {id: recipe.id, lineId: l.line_id}) }}" onsubmit="return confirm('Supprimer ?')">
                                                <button title="Supprimer cette ligne" class="w-7 h-7 inline-flex items-center justify-center rounded-lg text-ardoise-faible hover:text-sang hover:bg-sang-voile transition-colors"><i class="fas fa-trash text-[12px]"></i></button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="grid grid-cols-[minmax(0,1fr)_70px_90px_92px_68px] gap-2 px-5 py-2.5 border-t border-trait bg-voile/50 rounded-b-2xl items-center">
                            <div class="text-sm font-semibold text-ardoise-doux">Total matière HT</div>
                            <div></div>
                            <div class="text-right text-base font-bold text-ardoise">{{ t.material_cost_ht|number_format(2, ',', ' ') }} €</div>
                            <div></div>
                            <div></div>
                        </div>
                    {% endif %}
                </div>

                {# Panneau : Analyse des coûts #}
                {% if t.total_cost_ht > 0 %}
                    <div id="tab-couts" class="hidden p-6">
                        <p class="text-xs text-ardoise-faible mb-5">Décomposition du coût total HT pour {{ recipe.outputValue }} {{ unitLabel }}.</p>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                            <div class="flex justify-center">
                                <div style="position:relative; width:220px; height:220px;">
                                    <canvas id="costChart"
                                            data-mat="{{ t.material_cost_ht }}"
                                            data-labor="{{ t.labor_cost_ht }}"
                                            data-pack="{{ t.packaging_cost_ht }}">
                                    </canvas>
                                    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; pointer-events:none;">
                                        <div class="text-xl font-bold text-ardoise">{{ t.total_cost_ht|number_format(2,',',' ') }} €</div>
                                        <div class="text-xs text-ardoise-faible">coût total HT</div>
                                    </div>
                                </div>
                            </div>
                            <div class="space-y-4">
                                {% set pct_mat   = t.total_cost_ht > 0 ? (t.material_cost_ht   / t.total_cost_ht * 100)|round(1) : 0 %}
                                {% set pct_labor = t.total_cost_ht > 0 ? (t.labor_cost_ht      / t.total_cost_ht * 100)|round(1) : 0 %}
                                {% set pct_pack  = t.total_cost_ht > 0 ? (t.packaging_cost_ht  / t.total_cost_ht * 100)|round(1) : 0 %}
                                <div class="flex items-center gap-3">
                                    <div class="w-3 h-3 rounded-full bg-ardoise flex-shrink-0"></div>
                                    <div class="flex-1">
                                        <div class="flex justify-between text-sm mb-1"><span class="font-medium text-ardoise">Matières premières</span><span class="font-semibold text-ardoise">{{ t.material_cost_ht|number_format(2,',',' ') }} € <span class="text-ardoise-faible font-normal">({{ pct_mat }}%)</span></span></div>
                                        <div class="h-2 rounded-full bg-voile"><div class="h-2 rounded-full bg-ardoise" style="width:{{ pct_mat }}%"></div></div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="w-3 h-3 rounded-full bg-pousse flex-shrink-0"></div>
                                    <div class="flex-1">
                                        <div class="flex justify-between text-sm mb-1"><span class="font-medium text-ardoise">Main d'œuvre</span><span class="font-semibold text-ardoise">{{ t.labor_cost_ht|number_format(2,',',' ') }} € <span class="text-ardoise-faible font-normal">({{ pct_labor }}%)</span></span></div>
                                        <div class="h-2 rounded-full bg-voile"><div class="h-2 rounded-full bg-pousse" style="width:{{ pct_labor }}%"></div></div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-3">
                                    <div class="w-3 h-3 rounded-full bg-laiton flex-shrink-0"></div>
                                    <div class="flex-1">
                                        <div class="flex justify-between text-sm mb-1"><span class="font-medium text-ardoise">Emballage</span><span class="font-semibold text-ardoise">{{ t.packaging_cost_ht|number_format(2,',',' ') }} € <span class="text-ardoise-faible font-normal">({{ pct_pack }}%)</span></span></div>
                                        <div class="h-2 rounded-full bg-voile"><div class="h-2 rounded-full bg-laiton" style="width:{{ pct_pack }}%"></div></div>
                                    </div>
                                </div>
                                <hr class="border-trait-fin">
                                <div class="flex justify-between items-center bg-pousse-voile/70 rounded-xl px-4 py-2.5">
                                    <span class="text-sm font-semibold text-ardoise">Marge brute</span>
                                    <span class="font-bold text-pousse">{{ t.margin_ht|number_format(2,',',' ') }} € <span class="font-normal text-pousse text-sm">(marque {{ t.markup_percent|number_format(1, ',', ' ') }} %)</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# Panneau : Mode opératoire #}
                <div id="tab-process" class="hidden">
                    {% if recipe.processSteps is empty %}
                        {# Un écran vide est une invitation à agir, pas un constat.
                           On dit donc quoi faire et pourquoi. #}
                        <div class="py-14 px-6 text-center">
                            <i class="fas fa-list-ol text-3xl mb-3 block text-ardoise-faible"></i>
                            <p class="text-sm font-medium text-ardoise">Aucune étape de fabrication</p>
                            <p class="text-sm text-ardoise-doux mt-1.5 max-w-md mx-auto">
                                La fiche labo ne porte pour l'instant que des pesées. Les étapes, les temps
                                et les températures s'ajoutent depuis <strong>Modifier les paramètres</strong>,
                                et s'impriment avec une case à cocher chacune.
                            </p>
                            {% if canEdit %}
                                <button type="button" onclick="openParamsModal()"
                                        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-ardoise hover:bg-ardoise-clair px-5 py-2.5 text-sm font-semibold text-white transition-colors">
                                    <i class="fas fa-pen text-[12px]"></i> Écrire le mode opératoire
                                </button>
                            {% endif %}
                        </div>
                    {% else %}
                        <ol class="divide-y divide-trait-fin">
                            {% for etape in recipe.processSteps %}
                                <li class="flex gap-3 px-5 py-3">
                                    <span class="shrink-0 w-7 h-7 rounded-full bg-voile border border-trait flex items-center justify-center text-2xs font-bold text-laiton-patine tabular-nums">{{ loop.index }}</span>
                                    <span class="text-sm text-ardoise pt-1">{{ etape }}</span>
                                </li>
                            {% endfor %}
                        </ol>
                        {% if canEdit %}
                            <div class="px-5 py-2.5 border-t border-trait bg-voile/50 rounded-b-2xl flex items-center justify-between gap-3">
                                <p class="text-2xs text-ardoise-faible">Ces étapes s'impriment sur la fiche labo, avec une case à cocher chacune.</p>
                                <button type="button" onclick="openParamsModal()" class="text-xs font-semibold text-laiton-patine hover:underline shrink-0">Modifier</button>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

        </div>

        {# ── Barre latérale DROITE : Allergènes + Nutrition (masquée par défaut) ── #}
        <aside id="infoSidebar" class="hidden w-full lg:w-80 shrink-0 space-y-4 lg:sticky lg:top-4">

            {# Allergènes #}
            <div class="rounded-2xl border border-trait bg-white px-5 py-2.5">
                <div class="flex items-center gap-2 mb-3">
                    <div class="w-2 h-2 rounded-full bg-sang"></div>
                    <h3 class="font-semibold text-sm text-ardoise">Allergènes</h3>
                </div>
                {% if t.allergens is empty and t.traces is empty %}
                    <p class="text-sm text-ardoise-faible">Aucun allergène renseigné sur les ingrédients de cette recette.</p>
                {% else %}
                    {% if t.allergens is not empty %}
                        <p class="text-2xs font-semibold text-ardoise-faible uppercase tracking-wider mb-1.5">Présents</p>
                        <div class="flex flex-wrap gap-1.5">
                            {% for code in t.allergens %}
                                <span class="inline-flex items-center rounded-full bg-sang-voile text-sang text-xs font-semibold px-2.5 py-1">{{ allergen_label(code) }}</span>
                            {% endfor %}
                        </div>
                    {% endif %}
                    {% if t.traces is not empty %}
                        <p class="text-2xs font-semibold text-ardoise-faible uppercase tracking-wider mt-3 mb-1.5">Traces</p>
                        <div class="flex flex-wrap gap-1.5">
                            {% for code in t.traces %}
                                <span class="inline-flex items-center rounded-full bg-laiton-voile text-laiton-patine text-xs font-medium px-2.5 py-1">{{ allergen_label(code) }}</span>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% endif %}
            </div>

            {# Valeurs nutritionnelles #}
            {% set n = t.nutrition %}
            <div class="rounded-2xl border border-trait bg-white px-5 py-2.5">
                <div class="flex items-center gap-2 mb-1">
                    <div class="w-2 h-2 rounded-full bg-pousse"></div>
                    <h3 class="font-semibold text-sm text-ardoise">Valeurs nutritionnelles</h3>
                </div>
                <p class="text-xs text-ardoise-faible mb-3">pour 100 g — valeurs moyennes calculées (Ciqual / Anses)</p>
                {% if not n.available %}
                    <p class="text-sm text-ardoise-faible">
                        {% if n.reason == 'not_weight' %}Disponible uniquement pour les recettes au poids.
                        {% elseif n.reason == 'no_data' %}Aucun ingrédient n'est encore associé à un aliment Ciqual.
                        {% else %}Valeurs indisponibles.{% endif %}
                    </p>
                {% else %}
                    {% if not n.complete %}
                        <div class="mb-3 rounded-lg bg-laiton-voile border border-laiton/40 px-3 py-2 text-xs text-laiton-patine">
                            <i class="fas fa-triangle-exclamation mr-1"></i> Calcul incomplet : {{ n.missing }} élément(s) sans donnée — valeurs sous-estimées.
                        </div>
                    {% endif %}
                    <table class="w-full text-sm">
                        <tbody class="divide-y divide-trait-fin">
                        <tr><td class="py-1.5 text-ardoise-doux">Énergie</td><td class="py-1.5 text-right font-medium text-ardoise">{{ n.per_100g.energie_kj|number_format(0, ',', ' ') }} kJ / {{ n.per_100g.energie_kcal|number_format(0, ',', ' ') }} kcal</td></tr>
                        <tr><td class="py-1.5 text-ardoise-doux">Matières grasses</td><td class="py-1.5 text-right font-medium text-ardoise">{{ n.per_100g.lipides|number_format(1, ',', ' ') }} g</td></tr>
                        <tr><td class="py-1.5 pl-4 text-ardoise-faible">dont AG saturés</td><td class="py-1.5 text-right text-ardoise-doux">{{ n.per_100g.ag_satures|number_format(1, ',', ' ') }} g</td></tr>
                        <tr><td class="py-1.5 text-ardoise-doux">Glucides</td><td class="py-1.5 text-right font-medium text-ardoise">{{ n.per_100g.glucides|number_format(1, ',', ' ') }} g</td></tr>
                        <tr><td class="py-1.5 pl-4 text-ardoise-faible">dont sucres</td><td class="py-1.5 text-right text-ardoise-doux">{{ n.per_100g.sucres|number_format(1, ',', ' ') }} g</td></tr>
                        <tr><td class="py-1.5 text-ardoise-doux">Protéines</td><td class="py-1.5 text-right font-medium text-ardoise">{{ n.per_100g.proteines|number_format(1, ',', ' ') }} g</td></tr>
                        <tr><td class="py-1.5 text-ardoise-doux">Sel</td><td class="py-1.5 text-right font-medium text-ardoise">{{ n.per_100g.sel|number_format(2, ',', ' ') }} g</td></tr>
                        </tbody>
                    </table>
                {% endif %}
            </div>

        </aside>

    </div>

    {# ===== MODAL IMPRESSION ===== #}
    <div id="printQtyModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
            <div class="px-6 py-2.5 border-b border-trait-fin">
                <h3 class="font-semibold text-ardoise"><i class="fas fa-print text-laiton-patine mr-2 text-sm"></i>Quantité à imprimer</h3>
                <p class="text-xs text-ardoise-faible mt-1">Recette de base : <strong>{{ recipe.outputValue }} {{ recipe.outputUnitLabel }}</strong></p>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-ardoise-doux mb-1.5">Quantité souhaitée ({{ recipe.outputUnitLabel }})</label>
                    <input type="number" id="printQtyInput" step="0.001" min="0.001"
                           value="{{ recipe.outputValue }}" oninput="updatePrintPreview()"
                           class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine focus:ring-2 focus:ring-laiton/40/20">
                </div>
                <div>
                    <p class="text-xs text-ardoise-faible mb-2">Raccourcis :</p>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" onclick="setPrintQty({{ recipe.outputValue * 0.5 }})" class="rounded-lg border border-trait px-3 py-1.5 text-xs text-ardoise-doux hover:bg-voile hover:border-laiton/40 hover:text-laiton-patine transition-colors">× 0.5</button>
                        <button type="button" onclick="setPrintQty({{ recipe.outputValue }})" class="rounded-lg border border-laiton/40 px-3 py-1.5 text-xs text-laiton-patine bg-voile font-medium">× 1 (base)</button>
                        <button type="button" onclick="setPrintQty({{ recipe.outputValue * 2 }})" class="rounded-lg border border-trait px-3 py-1.5 text-xs text-ardoise-doux hover:bg-voile hover:border-laiton/40 hover:text-laiton-patine transition-colors">× 2</button>
                        <button type="button" onclick="setPrintQty({{ recipe.outputValue * 5 }})" class="rounded-lg border border-trait px-3 py-1.5 text-xs text-ardoise-doux hover:bg-voile hover:border-laiton/40 hover:text-laiton-patine transition-colors">× 5</button>
                        <button type="button" onclick="setPrintQty({{ recipe.outputValue * 10 }})" class="rounded-lg border border-trait px-3 py-1.5 text-xs text-ardoise-doux hover:bg-voile hover:border-laiton/40 hover:text-laiton-patine transition-colors">× 10</button>
                    </div>
                </div>
                <div class="bg-voile rounded-xl px-4 py-2.5 flex items-center justify-between">
                    <span class="text-sm text-ardoise-doux">Facteur multiplicateur</span>
                    <span id="printFactorDisplay" class="text-base font-bold text-ardoise">× 1,00</span>
                </div>
            </div>
            <div class="px-6 py-2.5 border-t border-trait-fin flex flex-col gap-2">
                <button type="button" onclick="generatePrint('lab')"
                        class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-ardoise hover:bg-ardoise-clair px-5 py-2.5 text-sm font-medium text-white transition-colors">
                    <i class="fas fa-flask text-[12px]"></i> Fiche labo
                </button>
                {% if canEdit %}
                    <button type="button" onclick="generatePrint('full')"
                            class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-ardoise hover:bg-ardoise-clair px-5 py-2.5 text-sm font-medium text-white transition-colors">
                        <i class="fas fa-file-pdf text-[12px]"></i> Fiche technique complète
                    </button>
                {% endif %}
                <button type="button"
                        onclick="document.getElementById('printQtyModal').classList.add('hidden');document.getElementById('printQtyModal').classList.remove('flex')"
                        class="w-full rounded-lg border border-trait px-5 py-2 text-sm text-ardoise-doux hover:bg-voile">
                    Annuler
                </button>
            </div>
        </div>
    </div>

    {# Modal ajouter ligne #}
    <div id="addLineModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <form method="post" action="{{ path('app_recipe_add_line', {id: recipe.id}) }}" class="bg-white rounded-2xl shadow-xl w-full max-w-lg mx-4">
            <div class="px-6 py-2.5 border-b border-trait-fin"><h3 class="font-semibold text-ardoise"><i class="fas fa-plus text-laiton-patine mr-2 text-sm"></i>Ajouter une ligne</h3></div>
            <div class="p-6 space-y-4">
                <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Type</label><select name="type" id="lineTypeSelect" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine bg-white" onchange="toggleLineType()"><option value="ingredient">Ingrédient</option><option value="sub_recipe">Sous-recette</option></select></div>
                <div id="ingredientField"><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Ingrédient</label><select name="ingredient_id" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine bg-white"><option value="">Choisir…</option>{% for i in ingredients %}<option value="{{ i.id }}">{{ i.name }} ({{ i.baseUnit }})</option>{% endfor %}</select></div>
                <div id="subRecipeField" style="display:none"><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Sous-recette</label><select name="sub_recipe_id" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine bg-white"><option value="">Choisir…</option>{% for r in availableSubs %}<option value="{{ r.id }}">{{ r.name }} ({{ r.family }})</option>{% endfor %}</select></div>
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Quantité brute</label><input type="number" name="qty_brute" step="0.001" required placeholder="0.000" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine"></div>
                    <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Unité</label><select name="unit" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine bg-white"><option value="kg">kg</option><option value="g">g</option><option value="piece">pièce</option><option value="litre">litre</option></select></div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">% perte</label><input type="number" name="loss_percent" step="0.01" value="0" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine"></div>
                    <div><label class="block text-sm font-medium text-ardoise-doux mb-1.5">% rendement</label><input type="number" name="yield_percent" step="0.01" value="100" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine"></div>
                </div>
                {# L'annotation existait en base et s'affichait sur les fiches, mais
                   ce formulaire ne la proposait pas : les « Parage » du jeu de
                   démonstration n'étaient atteignables par aucun écran. #}
                <div>
                    <label class="block text-sm font-medium text-ardoise-doux mb-1.5">Annotation <span class="text-ardoise-faible font-normal">(facultatif)</span></label>
                    <input type="text" name="note" maxlength="120" placeholder="Parage, dorure, à tempérer…"
                           class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine">
                    <p class="text-2xs text-ardoise-faible mt-1">Apparaît sous l'élément, sur l'écran et sur les fiches imprimées.</p>
                </div>
            </div>
            <div class="px-6 py-2.5 border-t border-trait-fin flex justify-end gap-3">
                <button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-trait px-4 py-2 text-sm text-ardoise-doux hover:bg-voile">Annuler</button>
                <button type="submit" class="rounded-lg bg-ardoise hover:bg-ardoise-clair px-5 py-2 text-sm font-medium text-white"><i class="fas fa-plus text-[12px] mr-1"></i> Ajouter</button>
            </div>
        </form></div>

    {# Modal : modifier une ligne existante ────────────────────────────────
       Un seul formulaire pour toutes les lignes, rempli à l'ouverture depuis
       les attributs du bouton. Le répéter pour chaque ligne alourdirait la
       page d'autant de formulaires qu'il y a d'ingrédients.

       L'ingrédient n'y figure pas : le changer ne corrige pas une ligne, il en
       fait une autre. #}
    <div id="editLineModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <form method="post" id="editLineForm" class="bg-white rounded-2xl shadow-xl w-full max-w-lg mx-4">
            <div class="px-6 py-2.5 border-b border-trait-fin">
                <h3 class="font-semibold text-ardoise"><i class="fas fa-pen text-laiton-patine mr-2 text-sm"></i>Modifier <span id="editLineNom" class="text-ardoise-doux font-normal"></span></h3>
            </div>
            <div class="p-6 space-y-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-ardoise-doux mb-1.5" for="editQty">Quantité brute</label>
                        <input type="number" name="qty_brute" id="editQty" step="0.001" min="0.001" required
                               class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-ardoise-doux mb-1.5" for="editUnit">Unité</label>
                        <select name="unit" id="editUnit" class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine bg-white">
                            <option value="kg">kg</option><option value="g">g</option>
                            <option value="piece">pièce</option><option value="litre">litre</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-medium text-ardoise-doux mb-1.5" for="editPerte">% perte</label>
                        <input type="number" name="loss_percent" id="editPerte" step="0.01" min="0" max="100"
                               class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-ardoise-doux mb-1.5" for="editRdt">% rendement</label>
                        <input type="number" name="yield_percent" id="editRdt" step="0.01" min="0" max="100"
                               class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-ardoise-doux mb-1.5" for="editNote">Annotation <span class="text-ardoise-faible font-normal">(facultatif)</span></label>
                    <input type="text" name="note" id="editNote" maxlength="120" placeholder="Parage, dorure, à tempérer…"
                           class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine">
                    <p class="text-2xs text-ardoise-faible mt-1">Vider le champ efface l'annotation.</p>
                </div>
            </div>
            <div class="px-6 py-2.5 border-t border-trait-fin flex justify-end gap-3">
                <button type="button" onclick="closeEditLine()" class="rounded-lg border border-trait px-4 py-2 text-sm text-ardoise-doux hover:bg-voile">Annuler</button>
                <button type="submit" class="rounded-lg bg-ardoise hover:bg-ardoise-clair px-5 py-2 text-sm font-medium text-white"><i class="fas fa-check text-[12px] mr-1"></i> Enregistrer</button>
            </div>
        </form>
    </div>

    {# Modal dupliquer #}
    <div id="dupeModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <form method="post" action="{{ path('app_recipe_duplicate', {id: recipe.id}) }}" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
            <div class="px-6 py-2.5 border-b border-trait-fin"><h3 class="font-semibold text-ardoise">Dupliquer</h3></div>
            <div class="p-6"><p class="text-xs text-ardoise-faible mb-3">Copie la recette avec tous ses ingrédients.</p><label class="block text-sm font-medium text-ardoise-doux mb-1.5">Nom de la copie</label><input type="text" name="new_name" value="{{ recipe.name }} (copie)" required class="w-full rounded-lg border border-trait px-4 py-2.5 text-sm outline-none focus:border-laiton-patine"></div>
            <div class="px-6 py-2.5 border-t border-trait-fin flex justify-end gap-3"><button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-trait px-4 py-2 text-sm text-ardoise-doux hover:bg-voile">Annuler</button><button type="submit" class="rounded-lg bg-pousse hover:bg-pousse px-5 py-2 text-sm font-medium text-white">Dupliquer</button></div>
        </form></div>
    {# Modal édition des paramètres #}
    {% if canEdit %}
        <div id="paramsModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50 p-4">
            <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden">
                <div class="px-6 py-2.5 border-b border-trait-fin flex items-center justify-between shrink-0">
                    <h3 class="font-semibold text-ardoise"><i class="fas fa-pen text-purple-500 mr-2 text-sm"></i>Modifier les paramètres</h3>
                    <button type="button" onclick="closeParamsModal()" class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-ardoise-faible hover:text-ardoise-doux hover:bg-voile"><i class="fas fa-times"></i></button>
                </div>

                <form id="paramsForm" method="post" action="{{ path('app_recipe_update', {id: recipe.id}) }}" class="px-6 py-5 overflow-y-auto">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-3 items-start">
                        <div class="sm:col-span-2"><label class="block text-xs font-medium text-ardoise-doux mb-1">Nom</label><input type="text" name="name" value="{{ recipe.name }}" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine"></div>
                        <div class="sm:col-span-2"><label class="block text-xs font-medium text-ardoise-doux mb-1">Famille</label><input type="text" name="family" value="{{ recipe.family }}" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine"></div>

                        <div class="sm:col-span-2 border-t border-trait-fin pt-3 mt-1"><p class="text-2xs font-semibold uppercase tracking-wider text-ardoise-faible">Fabrication & rendement</p></div>
                        <div><label class="block text-xs font-medium text-ardoise-doux mb-1">Type sortie</label><select name="output_type" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine bg-white"><option value="weight" {{ recipe.outputType == 'weight' ? 'selected' }}>Poids (kg)</option><option value="portion" {{ recipe.outputType == 'portion' ? 'selected' }}>Portions</option></select></div>
                        <div><label class="block text-xs font-medium text-ardoise-doux mb-1">Sortie</label><input type="number" name="output_value" step="0.001" value="{{ recipe.outputValue }}" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine"></div>
                        <div><label class="block text-xs font-medium text-ardoise-doux mb-1">% perte</label><input type="number" name="loss_percent" step="0.01" value="{{ recipe.lossPercent }}" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine"></div>
                        <div><label class="block text-xs font-medium text-ardoise-doux mb-1">% rendement</label><input type="number" name="yield_percent" step="0.01" value="{{ recipe.yieldPercent }}" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine"></div>

                        <div class="sm:col-span-2 border-t border-trait-fin pt-3 mt-1"><p class="text-2xs font-semibold uppercase tracking-wider text-ardoise-faible">Coûts & prix de vente</p></div>
                        <div>
                            <label class="block text-xs font-medium text-ardoise-doux mb-1">Main d'œuvre (minutes)</label>
                            <input type="number" name="labor_minutes" min="0" step="1" value="{{ recipe.laborMinutes }}" data-taux="{{ boutique().tauxHoraireMo }}" oninput="majCoutMO(this)" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine">
                            <p class="text-2xs text-ardoise-faible mt-1">≈ <span class="cout-mo">0,00</span> € HT · {{ boutique().tauxHoraireMo }} €/h</p>
                        </div>
                        <div><label class="block text-xs font-medium text-ardoise-doux mb-1">Emballage (€ HT)</label><input type="number" name="packaging_cost_ht" step="0.01" value="{{ recipe.packagingCostHt }}" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine"></div>
                        <div><label class="block text-xs font-medium text-ardoise-doux mb-1">TVA produit %</label><input type="number" name="product_vat_rate" step="0.01" value="{{ recipe.productVatRate }}" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine"></div>
                        <div><label class="block text-xs font-medium text-ardoise-doux mb-1">Mode prix</label><select name="pricing_mode" id="pricingMode" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine bg-white"><option value="coef" {{ recipe.pricingMode == 'coef' ? 'selected' }}>Coefficient (× coût HT)</option><option value="margin" {{ recipe.pricingMode == 'margin' ? 'selected' }}>Taux de marque (% du PV)</option></select></div>
                        <div class="sm:col-span-2"><label class="block text-xs font-medium text-ardoise-doux mb-1">Objectif</label><input type="number" name="pricing_value" step="0.01" value="{{ recipe.pricingValue }}" class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine"></div>

                        <p class="sm:col-span-2 text-2xs text-ardoise-faible leading-relaxed"><i class="fas fa-circle-info mr-1"></i> <strong>Coefficient</strong> : multiplie le coût HT (TVA ajoutée ensuite). <strong>Taux de marque</strong> : part de la marge dans le prix de vente (marque 30 % ⇔ marge 42,9 % ⇔ coef ×1,43).</p>

                        <div class="sm:col-span-2">
                            <label class="block text-xs font-medium text-ardoise-doux mb-1">
                                Prix de vente pratiqué <span class="text-ardoise-faible font-normal">(€ TTC / {{ recipe.outputUnitLabel }})</span>
                            </label>
                            <input type="number" name="sell_price_ttc" step="0.01" min="0"
                                   value="{{ recipe.sellPriceTtc }}"
                                   placeholder="prix affiché en boutique"
                                   class="w-full rounded-lg border border-trait px-3 py-2 text-sm outline-none focus:border-laiton-patine">
                            <p class="text-2xs text-ardoise-faible mt-1">
                                Votre prix réel, celui de l'étiquette. Renseigné, il donne la <strong>marge réelle</strong> et
                                signale les recettes vendues sous l'objectif. Laisser vide si le produit n'est pas encore tarifé.
                            </p>
                        </div>

                        {# Mode opératoire — texte libre, une étape par ligne.
                           Saisie volontairement non contrainte : on ne sait pas
                           encore ce qu'un artisan y écrit vraiment, et un
                           formulaire trop cadré l'empêcherait d'y mettre ce qui
                           lui sert. Le découpage se fait à l'affichage. #}
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-medium text-ardoise-doux mb-1" for="process">
                                Mode opératoire <span class="text-ardoise-faible font-normal">(une étape par ligne)</span>
                            </label>
                            <textarea name="process" id="process" rows="7"
                                      placeholder="Désosser l'épaule, parer les nerfs&#10;Hacher grille 8 mm, réserver au froid&#10;Mêler la farce 3 min, saler à 18 g/kg&#10;Cuisson 2 h à 78 °C à cœur&#10;Refroidir en cellule, 3 h maximum"
                                      class="w-full rounded-lg border border-trait px-3 py-2 text-sm leading-relaxed outline-none focus:border-laiton-patine">{{ recipe.process }}</textarea>
                            <p class="text-2xs text-ardoise-faible mt-1">
                                Les étapes apparaissent numérotées sur la <strong>fiche labo</strong>, avec une case à cocher
                                par étape. Temps et températures se saisissent ici, dans le texte.
                            </p>
                        </div>
                    </div>
                </form>

                <div class="px-6 py-2.5 border-t border-trait-fin flex items-center justify-between gap-3 shrink-0">
                    <form method="post" action="{{ path('app_recipe_delete', {id: recipe.id}) }}" onsubmit="return confirm('Supprimer définitivement cette recette ?')">
                        <button type="submit" class="inline-flex items-center gap-1.5 text-xs font-medium text-sang hover:text-sang transition-colors"><i class="fas fa-trash text-[12px]"></i> Supprimer</button>
                    </form>
                    <div class="flex gap-3">
                        <button type="button" onclick="closeParamsModal()" class="rounded-lg border border-trait px-5 py-2.5 text-sm text-ardoise-doux hover:bg-voile">Annuler</button>
                        <button type="submit" form="paramsForm" class="rounded-lg bg-ardoise hover:bg-ardoise-clair px-5 py-2.5 text-sm font-medium text-white transition-colors"><i class="fas fa-check text-[12px] mr-1"></i> Enregistrer</button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

{% endblock %}

{% block javascripts %}
    {# Chart.js hébergé ici : un script tiers s'exécute avec accès complet au
       DOM d'une session authentifiée qui affiche marges et prix fournisseurs. #}
    <script src="{{ asset('assets/vendor/chartjs/chart.umd.min.js') }}"></script>
    <script>
        function toggleInfo(){
            const sb=document.getElementById('infoSidebar');
            const lbl=document.getElementById('infoToggleLabel');
            const hidden=sb.classList.toggle('hidden');
            if(lbl) lbl.textContent = hidden ? 'Afficher infos' : 'Masquer infos';
            try{ localStorage.setItem('recipeInfoHidden', hidden ? '1':'0'); }catch(e){}
        }
        function closeParamsModal(){ const m=document.getElementById('paramsModal'); if(m){m.classList.add('hidden');m.classList.remove('flex');} }

        // Ouvre les paramètres. Appelée depuis l'onglet Mode opératoire, qui
        // amène le curseur directement sur la zone d'étapes — sans quoi on
        // arrive en haut d'un formulaire long sans savoir où écrire.
        function openParamsModal(surProcess){
            const m = document.getElementById('paramsModal');
            if (!m) return;
            m.classList.remove('hidden');
            m.classList.add('flex');

            const champ = document.getElementById('process');
            if (champ) {
                champ.scrollIntoView({ block: 'center' });
                champ.focus();
            }
        }
        (function(){ try{ if(localStorage.getItem('recipeInfoHidden')==='0'){ const sb=document.getElementById('infoSidebar'); const lbl=document.getElementById('infoToggleLabel'); if(sb){sb.classList.remove('hidden'); if(lbl) lbl.textContent='Masquer infos';} } }catch(e){} })();
        function toggleLineType(){const t=document.getElementById('lineTypeSelect').value;document.getElementById('ingredientField').style.display=t==='ingredient'?'':'none';document.getElementById('subRecipeField').style.display=t==='sub_recipe'?'':'none';}

        function majCoutMO(input){
            const taux=parseFloat(input.dataset.taux)||0;
            const min=parseFloat(input.value)||0;
            const span=input.closest('div').querySelector('.cout-mo');
            if(span) span.textContent=(min/60*taux).toFixed(2).replace('.',',');
        }
        document.querySelectorAll('input[name="labor_minutes"]').forEach(majCoutMO);

        // Onglets de la fiche + graphe en initialisation différée
        let _costChartDone = false;
        function initCostChart(){
            if(_costChartDone) return;
            const costCanvas = document.getElementById('costChart');
            if(!costCanvas) return;
            const mat=parseFloat(costCanvas.dataset.mat)||0, labor=parseFloat(costCanvas.dataset.labor)||0, packing=parseFloat(costCanvas.dataset.pack)||0;
            if(mat+labor+packing>0){
                new Chart(costCanvas,{type:'doughnut',data:{labels:['Matières',"Main d'œuvre",'Emballage'],datasets:[{data:[mat,labor,packing],backgroundColor:['#3b82f6','#10b981','#f59e0b'],borderWidth:0,hoverOffset:6}]},options:{cutout:'68%',plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>' '+parseFloat(ctx.raw).toFixed(2).replace('.',',')+' €'}}}}});
            }
            _costChartDone = true;
        }
        // Modification d'une ligne : un seul formulaire, rempli depuis les
        // attributs du bouton cliqué. L'action est reconstruite à chaque
        // ouverture pour viser la bonne ligne.
        const URL_EDIT_LINE = '{{ path("app_recipe_edit_line", {id: recipe.id, lineId: "LIGNE"}) }}';

        function openEditLine(bouton){
            const d = bouton.dataset;
            const f = document.getElementById('editLineForm');
            f.action = URL_EDIT_LINE.replace('LIGNE', d.id);

            document.getElementById('editLineNom').textContent = '— ' + d.nom;
            document.getElementById('editQty').value   = d.qty;
            document.getElementById('editUnit').value  = d.unit;
            document.getElementById('editPerte').value = d.perte;
            document.getElementById('editRdt').value   = d.rdt;
            document.getElementById('editNote').value  = d.note || '';

            const m = document.getElementById('editLineModal');
            m.classList.remove('hidden');
            m.classList.add('flex');
            // Le curseur va sur la quantité : c'est la correction la plus fréquente.
            document.getElementById('editQty').focus();
            document.getElementById('editQty').select();
        }

        function closeEditLine(){
            const m = document.getElementById('editLineModal');
            m.classList.add('hidden');
            m.classList.remove('flex');
        }

        function showRecipeTab(name){
            ['compo','couts','process'].forEach(function(tn){
                const panel=document.getElementById('tab-'+tn);
                const btn=document.getElementById('tabBtn-'+tn);
                if(!panel||!btn) return;
                const active=(tn===name);
                panel.classList.toggle('hidden', !active);
                btn.classList.toggle('text-laiton-patine', active);
                btn.classList.toggle('border-laiton/40', active);
                btn.classList.toggle('text-ardoise-doux', !active);
                btn.classList.toggle('border-transparent', !active);
            });
            if(name==='couts') initCostChart();
        }
        showRecipeTab('compo');

        // Impression avec choix de quantité
        const BASE_QTY    = {{ recipe.outputValue }};
        const URL_PDF     = '{{ path("app_recipe_pdf",     {id: recipe.id}) }}';
        const URL_PDF_LAB = '{{ path("app_recipe_pdf_lab", {id: recipe.id}) }}';

        function openPrintModal() {
            document.getElementById('printQtyInput').value = BASE_QTY;
            updatePrintPreview();
            document.getElementById('printQtyModal').classList.remove('hidden');
            document.getElementById('printQtyModal').classList.add('flex');
        }
        function setPrintQty(qty) {
            document.getElementById('printQtyInput').value = qty;
            updatePrintPreview();
        }
        function updatePrintPreview() {
            const qty    = parseFloat(document.getElementById('printQtyInput').value) || BASE_QTY;
            const factor = qty / BASE_QTY;
            document.getElementById('printFactorDisplay').textContent = '× ' + factor.toFixed(2).replace('.', ',');
        }
        function generatePrint(type) {
            const qty = parseFloat(document.getElementById('printQtyInput').value) || BASE_QTY;
            const url = (type === 'lab' ? URL_PDF_LAB : URL_PDF) + '?qty=' + qty;
            window.open(url, '_blank');
            document.getElementById('printQtyModal').classList.add('hidden');
            document.getElementById('printQtyModal').classList.remove('flex');
        }
    </script>
{% endblock %}
