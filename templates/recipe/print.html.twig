<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche technique — {{ recipe.name }}</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #333; margin: 0; padding: 0; }

        .header-table { width: 100%; border-bottom: 3px solid #1c2434; padding-bottom: 10px; margin-bottom: 18px; }
        .header-table td { vertical-align: bottom; padding: 0; }
        .header-title { font-size: 22pt; font-weight: bold; color: #1c2434; letter-spacing: 1px; }
        .header-subtitle { font-size: 11pt; color: #555; margin-top: 4px; }
        .header-company { font-size: 9pt; color: #999; text-align: right; }

        .qty-badge {
            display: inline-block;
            background: #1c2434;
            color: white;
            font-size: 11pt;
            font-weight: bold;
            padding: 5px 14px;
            border-radius: 4px;
            margin-bottom: 14px;
        }
        .qty-base {
            font-size: 8.5pt;
            color: #94a3b8;
            margin-left: 8px;
            font-weight: normal;
        }

        .meta-table { width: 100%; margin-bottom: 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 4px; }
        .meta-table td { padding: 8px 14px; font-size: 9pt; color: #555; }
        .meta-table strong { color: #1c2434; }

        .kpi-table { width: 100%; margin-bottom: 18px; border-spacing: 8px; border-collapse: separate; }
        .kpi-cell { border: 1px solid #e2e8f0; border-radius: 4px; padding: 8px 12px; background: #fff; width: 33.33%; }
        .kpi-label { font-size: 7pt; text-transform: uppercase; letter-spacing: 0.8px; color: #94a3b8; font-weight: bold; }
        .kpi-value { font-size: 15pt; font-weight: bold; color: #1c2434; margin-top: 2px; }
        .kpi-blue { color: #2563eb; }
        .kpi-green { color: #059669; }

        h2 { font-size: 13pt; font-weight: bold; color: #1c2434; margin-bottom: 8px; padding-bottom: 5px; border-bottom: 1px solid #e2e8f0; }

        .comp-table { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
        .comp-table th { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.8px; color: #64748b; font-weight: bold; padding: 8px 10px; border-bottom: 2px solid #1c2434; text-align: left; }
        .comp-table th.r { text-align: right; }
        .comp-table th.c { text-align: center; }
        .comp-table td { padding: 6px 10px; border-bottom: 1px solid #e9ecef; font-size: 9.5pt; }
        .comp-table td.r { text-align: right; }
        .comp-table td.c { text-align: center; }
        .comp-table td.bold { font-weight: bold; }
        .sub-recipe { color: #2563eb; font-style: italic; }
        .note { font-size: 8pt; color: #b45309; font-style: italic; }

        .totals-table { width: 100%; border-top: 3px solid #1c2434; padding-top: 10px; margin-bottom: 18px; }
        .totals-table td { padding: 3px 0; font-size: 10pt; }
        .totals-table td.r { text-align: right; }
        .totals-table tr.big td { font-size: 13pt; font-weight: bold; padding-top: 8px; border-top: 1px solid #cbd5e1; }

        .footer { margin-top: 25px; padding-top: 8px; border-top: 1px solid #e2e8f0; font-size: 8pt; color: #94a3b8; text-align: center; }

        .warn-box { border: 1px solid #f59e0b; background: #fffbeb; border-radius: 4px; padding: 9px 13px; margin-bottom: 16px; font-size: 8.5pt; color: #92400e; }
        .warn-box .warn-title { font-weight: bold; margin-bottom: 3px; }
        .warn-box ul { margin: 0; padding-left: 16px; }
        .price-src { font-size: 7.5pt; color: #94a3b8; }
        .flag { color: #dc2626; font-weight: bold; font-size: 8pt; }
    </style>
</head>
<body>

{% set f = factor|default(1) %}
{% set rqty = requestedQty|default(recipe.outputValue) %}

<!-- EN-TÊTE -->
<table class="header-table">
    <tr>
        <td>
            <div class="header-title">FICHE TECHNIQUE</div>
            <div class="header-subtitle">{{ recipe.name }} — {{ recipe.family }}</div>
        </td>
        <td class="header-company">
            {% if logo_base64() %}<img src="{{ logo_base64() }}" alt="" style="max-height:44px; max-width:130px; margin-bottom:5px; display:block; margin-left:auto;"><br>{% endif %}
            <strong style="color:#1c2434;">{{ boutique().nomEtablissement }}</strong>
            {% if boutique().sousTitre %}<br>{{ boutique().sousTitre }}{% endif %}
            {% if boutique().adresseComplete %}<br>{{ boutique().adresseComplete }}{% endif %}
        </td>
    </tr>
</table>

<!-- BADGE QUANTITÉ -->
<div>
    <span class="qty-badge">
        Pour {{ rqty|number_format(3, ',', ' ')|replace({',000': '', ',00': '', ',0': ''}) }} {{ recipe.outputUnitLabel }}
        {% if f != 1 %} &nbsp;(× {{ f|number_format(2)|replace({'.00': '', '.0': ''}) }} par rapport à la base){% endif %}
    </span>
</div>

<!-- MÉTA -->
<table class="meta-table">
    <tr>
        <td>Sortie cible : <strong>{{ (totals.output_target * f)|number_format(3, ',', ' ') }} {{ recipe.outputUnitLabel }}</strong></td>
        <td>Perte : <strong>{{ recipe.lossPercent|number_format(1) }}%</strong></td>
        <td>Rendement : <strong>{{ recipe.yieldPercent|number_format(1) }}%</strong></td>
        <td>Sortie effective : <strong>{{ (totals.output_effective * f)|number_format(3, ',', ' ') }} {{ recipe.outputUnitLabel }}</strong></td>
    </tr>
</table>

{# Bandeau d'alerte : coût potentiellement sous-évalué #}
{% set w = totals.warnings %}
{% if w.total > 0 %}
    <div class="warn-box">
        <div class="warn-title">⚠ Coût potentiellement sous-évalué — à vérifier avant tarification</div>
        <ul>
            {% if w.no_price > 0 %}<li>{{ w.no_price }} ligne(s) sans prix d'ingrédient (comptées à 0 €).</li>{% endif %}
            {% if w.unit_mismatch > 0 %}<li>{{ w.unit_mismatch }} ligne(s) en unité incompatible (comptées à 0 €).</li>{% endif %}
            {% if w.approx_density > 0 %}<li>{{ w.approx_density }} conversion(s) litre↔kg approximative(s) (densité = 1).</li>{% endif %}
            {% if w.output_exceeds_input %}<li>Sortie déclarée supérieure à la masse nette des ingrédients ({{ w.net_input_kg }} kg).</li>{% endif %}
            {% if w.pricing == 'markup_over_100' %}<li>Taux de marque ≥ 100 % : prix de vente non calculable.</li>{% endif %}
        </ul>
    </div>
{% endif %}

<!-- COMPOSITION -->
<h2>Composition</h2>
<table class="comp-table">
    <thead>
    <tr>
        <th>Élément</th>
        <th class="c" style="width: 80px;">Qté brute</th>
        <th class="c" style="width: 60px;">Unité</th>
        <th class="r" style="width: 90px;">P.U. HT</th>
        <th class="r" style="width: 90px;">Coût HT</th>
    </tr>
    </thead>
    <tbody>
    {% for l in lines %}
        <tr>
            <td>
                {% if l.type == 'sub_recipe' %}
                    <span class="sub-recipe">[SR] {{ l.sub_recipe.name }}</span>
                {% else %}
                    {{ l.ingredient.name }}
                    {% if 'no_price' in l.warnings %}<span class="flag"> ⚠ sans prix</span>{% endif %}
                    {% if 'unit_mismatch' in l.warnings %}<span class="flag"> ⚠ unité incompatible</span>{% endif %}
                    {% if 'approx_density' in l.warnings %}<span class="price-src"> (≈ densité 1)</span>{% endif %}
                    {% if l.price_meta and l.price_meta.effective_date %}
                        <br><span class="price-src">prix du {{ l.price_meta.effective_date|date('d/m/Y') }}{% if l.price_meta.supplier %} · {{ l.price_meta.supplier }}{% endif %}</span>
                    {% endif %}
                {% endif %}
                {% if l.note %}<br><span class="note">→ {{ l.note }}</span>{% endif %}
            </td>
            <td class="c">{{ (l.qty_brute * f)|number_format(3, ',', ' ') }}</td>
            <td class="c">{{ l.unit }}</td>
            <td class="r">{{ l.price_ht_per_base_unit|number_format(2, ',', ' ') }} €</td>
            <td class="r bold">{{ (l.line_cost_ht * f)|number_format(2, ',', ' ') }} €</td>
        </tr>
        {% if l.type == 'sub_recipe' and l.sub_recipe.components is not empty %}
            <tr>
                <td colspan="5" style="padding:3px 8px 8px 22px; background:#f8fafc; border-bottom:1px solid #eef2f7;">
                    <div style="font-size:8.5pt; color:#6b7280; margin-bottom:3px;">
                        Composition de « {{ l.sub_recipe.name }} » — pour {{ l.sub_recipe.output_value|number_format(3, ',', ' ') }} {{ l.sub_recipe.output_unit }}
                        <span style="color:#9ca3af;">(utilisé ici : {{ (l.sub_recipe.qty_used * f)|number_format(3, ',', ' ') }} {{ l.sub_recipe.output_unit }})</span>
                    </div>
                    <table style="width:100%; border-collapse:collapse; font-size:8.5pt;">
                        {% for c in l.sub_recipe.components %}
                            <tr>
                                <td style="padding:1px 0; color:#374151;">– {{ c.name }}{% if c.note %} <span style="color:#9ca3af;">({{ c.note }})</span>{% endif %}</td>
                                <td style="text-align:right; width:130px; color:#6b7280;">{{ c.qty_brute|number_format(3, ',', ' ') }} {{ c.unit }}</td>
                                <td style="text-align:right; width:90px; color:#374151;">{{ c.line_cost_ht|number_format(2, ',', ' ') }} €</td>
                            </tr>
                        {% endfor %}
                    </table>
                </td>
            </tr>
        {% endif %}
    {% endfor %}
    </tbody>
</table>

<!-- TOTAUX (scalés par f) -->
<table class="totals-table">
    <tr><td>Coût matière HT</td><td class="r">{{ (totals.material_cost_ht * f)|number_format(2, ',', ' ') }} €</td></tr>
    <tr><td>Main d'œuvre HT</td><td class="r">{{ (totals.labor_cost_ht * f)|number_format(2, ',', ' ') }} €</td></tr>
    <tr><td>Emballage HT</td><td class="r">{{ (totals.packaging_cost_ht * f)|number_format(2, ',', ' ') }} €</td></tr>
    <tr class="big"><td>Coût total HT</td><td class="r">{{ (totals.total_cost_ht * f)|number_format(2, ',', ' ') }} €</td></tr>
</table>

<!-- KPI (par unité : inchangés quel que soit le facteur) -->
<table class="kpi-table">
    <tr>
        <td class="kpi-cell">
            <div class="kpi-label">Coût / {{ recipe.outputUnitLabel }} HT</div>
            <div class="kpi-value kpi-blue">{{ totals.cost_per_output_ht|number_format(2, ',', ' ') }} €</div>
        </td>
        <td class="kpi-cell">
            <div class="kpi-label">Prix conseillé / {{ recipe.outputUnitLabel }} HT</div>
            <div class="kpi-value">{{ totals.advised_sell_ht|number_format(2, ',', ' ') }} €</div>
        </td>
        <td class="kpi-cell">
            <div class="kpi-label">Prix conseillé / {{ recipe.outputUnitLabel }} TTC</div>
            <div class="kpi-value kpi-blue">{{ totals.advised_sell_ttc|number_format(2, ',', ' ') }} €</div>
        </td>
    </tr>
    <tr>
        <td class="kpi-cell">
            <div class="kpi-label">Marge brute / {{ recipe.outputUnitLabel }} HT</div>
            <div class="kpi-value kpi-green">{{ totals.margin_ht|number_format(2, ',', ' ') }} €</div>
        </td>
        <td class="kpi-cell">
            <div class="kpi-label">Taux de marque (sur PV)</div>
            <div class="kpi-value kpi-green">{{ totals.markup_percent|number_format(1) }} %</div>
        </td>
        <td class="kpi-cell">
            <div class="kpi-label">Taux de marge (sur coût)</div>
            <div class="kpi-value">{{ totals.margin_on_cost_percent|number_format(1) }} %</div>
        </td>
    </tr>
    <tr>
        <td class="kpi-cell">
            <div class="kpi-label">Coefficient</div>
            <div class="kpi-value">× {{ totals.coefficient|number_format(2, ',', ' ') }}</div>
        </td>
        <td class="kpi-cell">
            <div class="kpi-label">Ratio matière</div>
            <div class="kpi-value">{{ totals.material_ratio_percent|number_format(1) }} %</div>
        </td>
        <td class="kpi-cell">
            <div class="kpi-label">TVA produit</div>
            <div class="kpi-value">{{ recipe.productVatRate|number_format(1) }} %</div>
        </td>
    </tr>
</table>

<!-- ALLERGÈNES -->
{% if totals.allergens is not empty or totals.traces is not empty %}
    <table style="width:100%; margin-top:14px; border:1px solid #e2e8f0; border-radius:4px; background:#fff;">
        <tr>
            <td style="padding:8px 14px; font-size:9pt; color:#555;">
                <strong style="color:#1c2434;">Allergènes :</strong>
                {% if totals.allergens is not empty %}
                    {% for code in totals.allergens %}{{ allergen_label(code) }}{% if not loop.last %}, {% endif %}{% endfor %}
                {% else %}—{% endif %}
                {% if totals.traces is not empty %}
                    <br><span style="color:#94a3b8;">Traces éventuelles : {% for code in totals.traces %}{{ allergen_label(code) }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
                {% endif %}
            </td>
        </tr>
    </table>
{% endif %}

{% if totals.nutrition.available %}
    <table style="width:100%; margin-top:14px; border:1px solid #e2e8f0; border-radius:4px; background:#fff;">
        <tr><td colspan="2" style="padding:8px 14px 2px; font-size:9pt; color:#1c2434;"><strong>Valeurs nutritionnelles moyennes pour 100 g</strong>{% if not totals.nutrition.complete %} <span style="color:#d97706;">(calcul incomplet — {{ totals.nutrition.missing }} élément(s) sans donnée)</span>{% endif %}</td></tr>
        <tr><td style="padding:3px 14px; font-size:9pt; color:#555;">Énergie</td><td style="padding:3px 14px; font-size:9pt; text-align:right; color:#1c2434;">{{ totals.nutrition.per_100g.energie_kj|number_format(0, ',', ' ') }} kJ / {{ totals.nutrition.per_100g.energie_kcal|number_format(0, ',', ' ') }} kcal</td></tr>
        <tr><td style="padding:3px 14px; font-size:9pt; color:#555;">Matières grasses</td><td style="padding:3px 14px; font-size:9pt; text-align:right; color:#1c2434;">{{ totals.nutrition.per_100g.lipides|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px 3px 26px; font-size:9pt; color:#94a3b8;">dont acides gras saturés</td><td style="padding:3px 14px; font-size:9pt; text-align:right; color:#94a3b8;">{{ totals.nutrition.per_100g.ag_satures|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px; font-size:9pt; color:#555;">Glucides</td><td style="padding:3px 14px; font-size:9pt; text-align:right; color:#1c2434;">{{ totals.nutrition.per_100g.glucides|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px 3px 26px; font-size:9pt; color:#94a3b8;">dont sucres</td><td style="padding:3px 14px; font-size:9pt; text-align:right; color:#94a3b8;">{{ totals.nutrition.per_100g.sucres|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px; font-size:9pt; color:#555;">Protéines</td><td style="padding:3px 14px; font-size:9pt; text-align:right; color:#1c2434;">{{ totals.nutrition.per_100g.proteines|number_format(1, ',', ' ') }} g</td></tr>
        <tr><td style="padding:3px 14px 8px; font-size:9pt; color:#555;">Sel</td><td style="padding:3px 14px 8px; font-size:9pt; text-align:right; color:#1c2434;">{{ totals.nutrition.per_100g.sel|number_format(2, ',', ' ') }} g</td></tr>
        <tr><td colspan="2" style="padding:0 14px 8px; font-size:7.5pt; color:#94a3b8;">Valeurs moyennes calculées — source : Anses, table Ciqual.</td></tr>
    </table>
{% endif %}

<!-- PIED -->
<div class="footer">
    Généré le {{ 'now'|date('d/m/Y à H:i') }} — {{ boutique().nomEtablissement }}{% if boutique().sousTitre %}, {{ boutique().sousTitre }}{% endif %}
    {% if boutique().mentionPied %}<br>{{ boutique().mentionPied }}{% endif %}
</div>

</body>
</html>
