{% extends 'base.html.twig' %}
{% block title %}Tableau de bord{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}
{% block page_subtitle %}Vue d'ensemble · {{ "now"|date("d/m/Y H:i") }}{% endblock %}

{% block body %}

    {# ═══════════════════════════════════════════════════════
   ZONE 1 — L'ARGENT : ce qui appelle une décision aujourd'hui
═══════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">

        {# Marque réelle — la seule marge opposable, calculée sur les prix pratiqués #}
        <div class="rounded-2xl border border-trait bg-white px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-ardoise-faible">Marque réelle médiane</p>
            <p class="text-3xl font-bold mt-1 {{ kpis.median_markup is null ? 'text-ardoise-faible' : (kpis.median_markup >= 40 ? 'text-pousse' : (kpis.median_markup >= 25 ? 'text-laiton-patine' : 'text-sang')) }}">
                {{ kpis.median_markup is null ? '—' : kpis.median_markup|number_format(1, ',', ' ') ~ ' %' }}
            </p>
            <p class="text-[10px] text-ardoise-faible mt-2">sur {{ kpis.priced_count }} recette(s) tarifée(s)</p>
        </div>

        {# Sous l'objectif #}
        <div class="rounded-2xl border {{ underpriced|length ? 'border-sang/30 bg-sang-voile/40' : 'border-trait bg-white' }} px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider {{ underpriced|length ? 'text-sang' : 'text-ardoise-faible' }}">Sous le prix conseillé</p>
            <p class="text-3xl font-bold mt-1 {{ underpriced|length ? 'text-sang' : 'text-ardoise' }}">{{ underpriced|length }}</p>
            <p class="text-[10px] text-ardoise-faible mt-2">écart supérieur à 2 %</p>
        </div>

        {# Dérive des coûts #}
        <div class="rounded-2xl border {{ cost_drift|length ? 'border-laiton/40 bg-laiton-voile/40' : 'border-trait bg-white' }} px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider {{ cost_drift|length ? 'text-laiton-patine' : 'text-ardoise-faible' }}">Coûts en hausse (30 j)</p>
            <p class="text-3xl font-bold mt-1 {{ cost_drift|length ? 'text-laiton-patine' : 'text-ardoise' }}">{{ cost_drift|length }}</p>
            <p class="text-[10px] text-ardoise-faible mt-2">recettes touchées par une hausse de prix</p>
        </div>

        {# Factures à valider #}
        <div class="rounded-2xl border {{ kpis.pending_invoices ? 'border-laiton/40 bg-voile/40' : 'border-trait bg-white' }} px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider {{ kpis.pending_invoices ? 'text-laiton-patine' : 'text-ardoise-faible' }}">Factures à valider</p>
            <p class="text-3xl font-bold mt-1 {{ kpis.pending_invoices ? 'text-ardoise-fort' : 'text-ardoise' }}">{{ kpis.pending_invoices }}</p>
            {% if kpis.pending_invoices %}
                <a href="{{ path('app_invoice_index') }}" class="text-[10px] text-ardoise-fort hover:underline mt-2 inline-block">traiter maintenant</a>
            {% else %}
                <p class="text-[10px] text-ardoise-faible mt-2">rien en attente</p>
            {% endif %}
        </div>
    </div>

    {# ── Dérive des coûts : le bloc qu'aucun concurrent ne peut afficher,
          faute de recevoir les factures automatiquement. Muet si rien ne bouge. ── #}
    {% if cost_drift|length %}
        <div class="rounded-2xl border border-laiton/40 bg-white mb-6 overflow-hidden">
            <div class="px-5 py-3 bg-laiton-voile/70 border-b border-laiton/40 flex items-center gap-2">
                <i class="fas fa-arrow-trend-up text-laiton-patine text-sm"></i>
                <h3 class="font-semibold text-[14px] text-laiton-patine">Coûts en hausse sur 30 jours</h3>
                <span class="text-[11px] text-laiton-patine/70 ml-auto">comparé aux prix en vigueur il y a 30 jours</span>
            </div>
            <div class="divide-y divide-trait-fin">
                {% for d in cost_drift %}
                    <div class="flex items-center gap-4 px-5 py-3">
                        <a href="{{ path('app_recipe_show', {id: d.recipe_id}) }}" class="flex-1 min-w-0 font-medium text-sm text-laiton-patine hover:text-ardoise">{{ d.recipe_name }}</a>
                        <div class="text-right text-xs text-ardoise-doux w-48 flex-shrink-0">
                            {{ d.cost_then|number_format(2, ',', ' ') }} €
                            <i class="fas fa-arrow-right text-[9px] text-ardoise-faible mx-1"></i>
                            <strong class="text-ardoise">{{ d.cost_now|number_format(2, ',', ' ') }} €</strong>
                            / {{ d.output_unit }}
                        </div>
                        <div class="text-right w-20 flex-shrink-0">
                            <span class="font-bold text-sm {{ d.delta_percent >= 10 ? 'text-sang' : 'text-laiton-patine' }}">+{{ d.delta_percent|number_format(1, ',', ' ') }} %</span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# ── Vendu sous l'objectif ── #}
    {% if underpriced|length %}
        <div class="rounded-2xl border border-sang/30 bg-white mb-6 overflow-hidden">
            <div class="px-5 py-3 bg-sang-voile/70 border-b border-sang/30 flex items-center gap-2">
                <i class="fas fa-triangle-exclamation text-sang text-sm"></i>
                <h3 class="font-semibold text-[14px] text-sang">
                    {{ underpriced|length }} recette(s) vendue(s) sous le prix conseillé
                </h3>
            </div>
            <div class="divide-y divide-trait-fin">
                {% for r in underpriced|slice(0, 5) %}
                    <div class="flex items-center gap-4 px-5 py-3">
                        <a href="{{ path('app_recipe_show', {id: r.id}) }}" class="flex-1 min-w-0 font-medium text-sm text-laiton-patine hover:text-ardoise">{{ r.name }}</a>
                        <div class="text-right text-xs text-ardoise-doux w-44 flex-shrink-0">
                            pratiqué <strong class="text-ardoise">{{ r.sellPriceTtc|number_format(2, ',', ' ') }} €</strong>
                            · conseillé {{ r.costCache.advisedSellTtc|number_format(2, ',', ' ') }} €
                        </div>
                        <div class="text-right w-20 flex-shrink-0">
                            <span class="font-bold text-sang text-sm">{{ r.priceGapPercent|number_format(1, ',', ' ') }} %</span>
                        </div>
                        <div class="text-right w-32 flex-shrink-0 text-xs text-ardoise-doux">
                            marque <strong class="{{ r.realMarkupPercent < 15 ? 'text-sang' : 'text-ardoise' }}">{{ r.realMarkupPercent|number_format(1, ',', ' ') }} %</strong>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% if underpriced|length > 5 %}
                <p class="px-5 py-2.5 text-[11px] text-ardoise-doux bg-voile/70 border-t border-trait-fin">
                    et {{ underpriced|length - 5 }} autre(s) — de la plus grosse perte à la plus faible.
                </p>
            {% endif %}
        </div>
    {% endif %}

    {# ═══════════════════════════════════════════════════════
   ZONE 2 — L'ÉTAT DU CATALOGUE
═══════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">

        {# Recettes #}
        <div class="rounded-2xl border border-trait bg-white px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-ardoise-faible">Recettes</p>
            <p class="text-3xl font-bold text-ardoise mt-1">{{ kpis.total_recipes }}</p>
            <div class="mt-2 flex gap-2 flex-wrap">
            <span class="text-[10px] bg-pousse-voile text-pousse rounded-full px-2 py-0.5 font-medium">
                {{ kpis.recipes_with_cost }} avec coût
            </span>
                {% if kpis.recipes_no_cost > 0 %}
                    <span class="text-[10px] bg-laiton-voile text-laiton-patine rounded-full px-2 py-0.5 font-medium">
                {{ kpis.recipes_no_cost }} sans coût
            </span>
                {% endif %}
            </div>
        </div>

        {# Ingrédients #}
        <div class="rounded-2xl border border-trait bg-white px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-ardoise-faible">Ingrédients</p>
            <p class="text-3xl font-bold text-ardoise mt-1">{{ kpis.total_ingredients }}</p>
            <div class="mt-2 flex gap-2 flex-wrap">
            <span class="text-[10px] bg-pousse-voile text-pousse rounded-full px-2 py-0.5 font-medium">
                {{ kpis.ings_with_price }} avec prix
            </span>
                {% if kpis.ings_no_price > 0 %}
                    <span class="text-[10px] bg-sang-voile text-sang rounded-full px-2 py-0.5 font-medium">
                {{ kpis.ings_no_price }} sans prix
            </span>
                {% endif %}
            </div>
        </div>

        {# Marque conseillée — la théorie, à distinguer de la marque réelle ci-dessus #}
        <div class="rounded-2xl border border-trait bg-white px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-ardoise-faible">Marque conseillée moyenne</p>
            <p class="text-3xl font-bold mt-1 {{ kpis.avg_margin >= 60 ? 'text-pousse' : (kpis.avg_margin >= 40 ? 'text-laiton-patine' : 'text-sang') }}">
                {{ kpis.avg_margin > 0 ? kpis.avg_margin ~ ' %' : '—' }}
            </p>
            <p class="text-[10px] text-ardoise-faible mt-2">théorique · {{ kpis.recipes_with_cost }} recettes calculées</p>
        </div>

        {# Apprentissage du rapprochement de factures : le seul chiffre
           « technique » qui dise quelque chose d'utile — plus il monte, moins
           l'utilisateur a de lignes à trier à chaque facture. #}
        <div class="rounded-2xl border border-trait bg-white px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-ardoise-faible">Libellés fournisseurs appris</p>
            <p class="text-3xl font-bold text-ardoise mt-1">{{ mapping_count }}</p>
            <p class="text-[10px] text-ardoise-faible mt-2">reconnus automatiquement à l'import</p>
        </div>

    </div>

    {# ═══════════════════════════════════════════════════════
   ALERTES
═══════════════════════════════════════════════════════ #}
    {% set hasAlerts = alerts.no_price|length > 0 or alerts.empty|length > 0 or alerts.old_prices|length > 0 %}
    {% if hasAlerts %}
        <div class="mb-6 space-y-3">

            {# Ingrédients sans prix #}
            {% if alerts.no_price|length > 0 %}
                <div class="rounded-2xl border border-sang/30 bg-sang-voile/50 px-5 py-4">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-exclamation-circle text-sang mt-0.5"></i>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-sang">
                                {{ alerts.no_price|length }} ingrédient{{ alerts.no_price|length > 1 ? 's' : '' }} sans prix — le coût des recettes utilisant ces ingrédients est faux
                            </p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for ing in alerts.no_price %}
                                    <a href="{{ path('app_ingredient_show', {id: ing.id}) }}"
                                       class="text-[11px] bg-white border border-sang/30 text-sang rounded-lg px-2.5 py-1 hover:bg-sang-voile transition-colors">
                                        {{ ing.name }}{% if ing.category %} <span class="text-sang">({{ ing.category }})</span>{% endif %}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Prix anciens #}
            {% if alerts.old_prices|length > 0 %}
                <div class="rounded-2xl border border-laiton/40 bg-laiton-voile/50 px-5 py-4">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-clock text-laiton-patine mt-0.5"></i>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-laiton-patine">
                                {{ alerts.old_prices|length }} ingrédient{{ alerts.old_prices|length > 1 ? 's' : '' }} avec des prix datant de plus de 90 jours
                            </p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for row in alerts.old_prices %}
                                    <a href="{{ path('app_ingredient_show', {id: row.id}) }}"
                                       class="text-[11px] bg-white border border-laiton/40 text-laiton-patine rounded-lg px-2.5 py-1 hover:bg-laiton-voile transition-colors">
                                        {{ row.name }} <span class="text-laiton-patine">{{ row.days_old }}j</span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Recettes vides #}
            {% if alerts.empty|length > 0 %}
                <div class="rounded-2xl border border-trait bg-voile/50 px-5 py-4">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-file-circle-xmark text-ardoise-faible mt-0.5"></i>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-ardoise-doux">
                                {{ alerts.empty|length }} recette{{ alerts.empty|length > 1 ? 's' : '' }} sans aucun ingrédient
                            </p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for r in alerts.empty %}
                                    <a href="{{ path('app_recipe_show', {id: r.id}) }}"
                                       class="text-[11px] bg-white border border-trait text-ardoise-doux rounded-lg px-2.5 py-1 hover:bg-voile transition-colors">
                                        {{ r.name }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

        </div>
    {% endif %}

    {# ── Ingrédients en hausse : le pendant amont de la dérive des recettes.
          Répond à « où renégocier », là où les anciennes cartes « ingrédients
          les plus chers » ne disaient rien d'actionnable : un ingrédient cher
          n'est pas un problème, un ingrédient qui grimpe en est un. ── #}
    {% if ingredient_rises|length %}
        <div class="rounded-2xl border border-trait bg-white mb-6 overflow-hidden">
            <div class="px-5 py-4 border-b border-trait-fin flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-laiton"></div>
                <h3 class="font-semibold text-[15px] text-ardoise">Ingrédients en hausse sur 30 jours</h3>
                <span class="text-[11px] text-ardoise-faible ml-auto">à renégocier ou substituer</span>
            </div>
            <div class="divide-y divide-trait-fin">
                {% for ing in ingredient_rises %}
                    <div class="flex items-center gap-4 px-5 py-3">
                        <a href="{{ path('app_ingredient_show', {id: ing.id}) }}" class="flex-1 min-w-0 font-medium text-sm text-laiton-patine hover:text-ardoise">{{ ing.name }}</a>
                        <div class="text-right text-xs text-ardoise-doux w-52 flex-shrink-0">
                            {{ ing.old_price|number_format(4, ',', ' ') }} €
                            <i class="fas fa-arrow-right text-[9px] text-ardoise-faible mx-1"></i>
                            <strong class="text-ardoise">{{ ing.new_price|number_format(4, ',', ' ') }} €</strong>
                            / {{ ing.base_unit }}
                        </div>
                        <div class="text-right w-20 flex-shrink-0">
                            <span class="font-bold text-sm {{ ing.delta >= 10 ? 'text-sang' : 'text-laiton-patine' }}">+{{ ing.delta|number_format(1, ',', ' ') }} %</span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

{% endblock %}
