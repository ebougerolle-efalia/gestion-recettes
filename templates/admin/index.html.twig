{% extends 'base.html.twig' %}
{% block title %}Tableau de bord{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}
{% block page_subtitle %}Vue d'ensemble · {{ "now"|date("d/m/Y H:i") }}{% endblock %}

{% block body %}

    {# ═══════════════════════════════════════════════════════
   KPIs
═══════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">

        {# Recettes #}
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Recettes</p>
            <p class="text-3xl font-bold text-[#1c2434] mt-1">{{ kpis.total_recipes }}</p>
            <div class="mt-2 flex gap-2 flex-wrap">
            <span class="text-[10px] bg-emerald-50 text-emerald-700 rounded-full px-2 py-0.5 font-medium">
                {{ kpis.recipes_with_cost }} avec coût
            </span>
                {% if kpis.recipes_no_cost > 0 %}
                    <span class="text-[10px] bg-amber-50 text-amber-700 rounded-full px-2 py-0.5 font-medium">
                {{ kpis.recipes_no_cost }} sans coût
            </span>
                {% endif %}
            </div>
        </div>

        {# Ingrédients #}
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Ingrédients</p>
            <p class="text-3xl font-bold text-[#1c2434] mt-1">{{ kpis.total_ingredients }}</p>
            <div class="mt-2 flex gap-2 flex-wrap">
            <span class="text-[10px] bg-emerald-50 text-emerald-700 rounded-full px-2 py-0.5 font-medium">
                {{ kpis.ings_with_price }} avec prix
            </span>
                {% if kpis.ings_no_price > 0 %}
                    <span class="text-[10px] bg-red-50 text-red-700 rounded-full px-2 py-0.5 font-medium">
                {{ kpis.ings_no_price }} sans prix
            </span>
                {% endif %}
            </div>
        </div>

        {# Marge moyenne #}
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Marge moyenne</p>
            <p class="text-3xl font-bold mt-1 {{ kpis.avg_margin >= 60 ? 'text-emerald-600' : (kpis.avg_margin >= 40 ? 'text-amber-500' : 'text-red-500') }}">
                {{ kpis.avg_margin > 0 ? kpis.avg_margin ~ ' %' : '—' }}
            </p>
            <p class="text-[10px] text-gray-400 mt-2">sur {{ kpis.recipes_with_cost }} recettes calculées</p>
        </div>

        {# Base de données #}
        <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Base de données</p>
            <p class="text-2xl font-bold text-[#1c2434] mt-1">{{ db_size }}</p>
            <p class="text-[10px] text-gray-400 mt-2">
                SQLite · {{ mapping_count }} mapping{{ mapping_count > 1 ? 's' : '' }} facture mémorisé{{ mapping_count > 1 ? 's' : '' }}
            </p>
        </div>

    </div>

    {# ═══════════════════════════════════════════════════════
   ALERTES
═══════════════════════════════════════════════════════ #}
    {% set hasAlerts = alerts.no_price|length > 0 or alerts.empty|length > 0 or alerts.old_prices|length > 0 %}
    {% if hasAlerts %}
        <div class="mb-6 space-y-3">

            {# Ingrédients sans prix #}
            {% if alerts.no_price|length > 0 %}
                <div class="rounded-2xl border border-red-200 bg-red-50/50 px-5 py-4">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-exclamation-circle text-red-500 mt-0.5"></i>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-red-700">
                                {{ alerts.no_price|length }} ingrédient{{ alerts.no_price|length > 1 ? 's' : '' }} sans prix — le coût des recettes utilisant ces ingrédients est faux
                            </p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for ing in alerts.no_price %}
                                    <a href="{{ path('app_ingredient_show', {id: ing.id}) }}"
                                       class="text-[11px] bg-white border border-red-200 text-red-600 rounded-lg px-2.5 py-1 hover:bg-red-50 transition-colors">
                                        {{ ing.name }}{% if ing.category %} <span class="text-red-400">({{ ing.category }})</span>{% endif %}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Prix anciens #}
            {% if alerts.old_prices|length > 0 %}
                <div class="rounded-2xl border border-amber-200 bg-amber-50/50 px-5 py-4">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-clock text-amber-500 mt-0.5"></i>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-amber-700">
                                {{ alerts.old_prices|length }} ingrédient{{ alerts.old_prices|length > 1 ? 's' : '' }} avec des prix datant de plus de 90 jours
                            </p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for row in alerts.old_prices %}
                                    <a href="{{ path('app_ingredient_show', {id: row.id}) }}"
                                       class="text-[11px] bg-white border border-amber-200 text-amber-700 rounded-lg px-2.5 py-1 hover:bg-amber-50 transition-colors">
                                        {{ row.name }} <span class="text-amber-400">{{ row.days_old }}j</span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Recettes vides #}
            {% if alerts.empty|length > 0 %}
                <div class="rounded-2xl border border-gray-200 bg-gray-50/50 px-5 py-4">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-file-circle-xmark text-gray-400 mt-0.5"></i>
                        <div class="flex-1">
                            <p class="text-sm font-semibold text-gray-600">
                                {{ alerts.empty|length }} recette{{ alerts.empty|length > 1 ? 's' : '' }} sans aucun ingrédient
                            </p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                {% for r in alerts.empty %}
                                    <a href="{{ path('app_recipe_show', {id: r.id}) }}"
                                       class="text-[11px] bg-white border border-gray-200 text-gray-600 rounded-lg px-2.5 py-1 hover:bg-gray-50 transition-colors">
                                        {{ r.name }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

        </div>
    {% endif %}

    {# ═══════════════════════════════════════════════════════
   GRILLE PRINCIPALE
═══════════════════════════════════════════════════════ #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

        {# ── Derniers prix importés ── #}
        <div class="rounded-2xl border border-gray-200 bg-white">
            <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-blue-500"></div>
                    <h3 class="font-semibold text-[15px] text-[#1c2434]">Derniers prix renseignés</h3>
                </div>
                <a href="{{ path('app_invoice_import') }}" class="text-xs text-blue-500 hover:text-blue-600">
                    <i class="fas fa-file-import mr-1"></i>Importer
                </a>
            </div>
            {% if last_prices|length > 0 %}
                <div class="divide-y divide-gray-50">
                    {% for p in last_prices %}
                        <div class="px-5 py-3 flex items-center justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <a href="{{ path('app_ingredient_show', {id: p.ing_id}) }}"
                                   class="text-sm font-medium text-[#1c2434] hover:text-blue-600 truncate block">
                                    {{ p.ingredient }}
                                </a>
                                <p class="text-[11px] text-gray-400 mt-0.5">
                                    {{ p.supplier ?: 'Fournisseur inconnu' }} · {{ p.effective_date }}
                                </p>
                            </div>
                            <span class="flex-shrink-0 font-semibold text-sm text-[#1c2434]">
                    {{ p.price_ht|number_format(2, ',', ' ') }} €/{{ p.base_unit }}
                </span>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="px-5 py-8 text-center text-sm text-gray-400">
                    <i class="fas fa-tags text-2xl mb-2 block text-gray-200"></i>
                    Aucun prix enregistré
                </div>
            {% endif %}
        </div>

        {# ── Répartition par famille ── #}
        <div class="rounded-2xl border border-gray-200 bg-white">
            <div class="px-5 py-4 border-b border-gray-100">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-violet-500"></div>
                    <h3 class="font-semibold text-[15px] text-[#1c2434]">Répartition par famille</h3>
                </div>
            </div>
            <div class="divide-y divide-gray-50">
                {% for row in by_family %}
                    <div class="px-5 py-3 flex items-center gap-3">
                        <div class="flex-1">
                            <p class="text-sm font-medium text-[#1c2434]">{{ row.family }}</p>
                            <div class="mt-1.5 w-full bg-gray-100 rounded-full h-1.5">
                                {% set pct = kpis.total_recipes > 0 ? (row.nb / kpis.total_recipes * 100)|round : 0 %}
                                <div class="bg-violet-400 h-1.5 rounded-full" style="width: {{ pct }}%"></div>
                            </div>
                        </div>
                        <div class="flex-shrink-0 text-right">
                            <p class="text-sm font-semibold text-[#1c2434]">{{ row.nb }} recette{{ row.nb > 1 ? 's' : '' }}</p>
                            {% if row.avg_margin %}
                                <p class="text-[11px] {{ row.avg_margin >= 60 ? 'text-emerald-600' : 'text-amber-600' }}">
                                    {{ row.avg_margin }} % marge
                                </p>
                            {% else %}
                                <p class="text-[11px] text-gray-400">coût non calculé</p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

    </div>

    {# ── Ligne basse : top ingrédients + top recettes ── #}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        {# Top ingrédients les plus chers #}
        <div class="rounded-2xl border border-gray-200 bg-white">
            <div class="px-5 py-4 border-b border-gray-100">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-red-400"></div>
                    <h3 class="font-semibold text-[15px] text-[#1c2434]">Ingrédients les plus chers</h3>
                </div>
            </div>
            {% if top_ingredients|length > 0 %}
                <div class="divide-y divide-gray-50">
                    {% for ing in top_ingredients %}
                        <div class="px-5 py-3 flex items-center justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <a href="{{ path('app_ingredient_show', {id: ing.id}) }}"
                                   class="text-sm font-medium text-[#1c2434] hover:text-blue-600 truncate block">
                                    {{ ing.name }}
                                </a>
                                <p class="text-[11px] text-gray-400">{{ ing.supplier ?: '—' }}</p>
                            </div>
                            <span class="flex-shrink-0 font-bold text-sm text-red-600">
                    {{ ing.price_ht|number_format(2, ',', ' ') }} €/{{ ing.base_unit }}
                </span>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="px-5 py-6 text-sm text-gray-400 text-center">Aucun prix enregistré</p>
            {% endif %}
        </div>

        {# Top recettes par coût de revient #}
        <div class="rounded-2xl border border-gray-200 bg-white">
            <div class="px-5 py-4 border-b border-gray-100">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-amber-500"></div>
                    <h3 class="font-semibold text-[15px] text-[#1c2434]">Recettes les plus coûteuses</h3>
                </div>
            </div>
            {% if top_recipes|length > 0 %}
                <div class="divide-y divide-gray-50">
                    {% for r in top_recipes %}
                        <div class="px-5 py-3 flex items-center justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <a href="{{ path('app_recipe_show', {id: r.id}) }}"
                                   class="text-sm font-medium text-[#1c2434] hover:text-blue-600 truncate block">
                                    {{ r.name }}
                                </a>
                                <p class="text-[11px] text-gray-400">{{ r.family }} · {{ r.output_type == 'weight' ? 'kg' : 'portion' }}</p>
                            </div>
                            <div class="flex-shrink-0 text-right">
                                <p class="font-bold text-sm text-amber-600">{{ r.cost_per_output_ht|number_format(2, ',', ' ') }} €</p>
                                {% if r.margin_percent > 0 %}
                                    <p class="text-[11px] {{ r.margin_percent >= 60 ? 'text-emerald-600' : 'text-amber-600' }}">
                                        {{ r.margin_percent }} %
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="px-5 py-6 text-sm text-gray-400 text-center">Aucun coût calculé</p>
            {% endif %}
        </div>

    </div>

{% endblock %}
