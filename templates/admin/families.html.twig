{% extends 'base.html.twig' %}
{% block title %}Familles{% endblock %}
{% block page_title %}Familles de recettes{% endblock %}
{% block page_subtitle %}{{ families|length }} famille{{ families|length > 1 ? 's' : '' }}{% endblock %}

{% block page_actions %}
    <button onclick="openModal('addModal')" class="inline-flex items-center gap-2 rounded-lg bg-blue-500 hover:bg-blue-600 px-4 py-2.5 text-sm font-medium text-white">
        <i class="fas fa-plus text-[11px]"></i> Ajouter
    </button>
{% endblock %}

{% block body %}
    <div class="rounded-2xl border border-gray-200 bg-white">
        <table class="w-full text-sm">
            <thead>
            <tr class="border-b border-gray-100 bg-gray-50/50">
                <th class="py-3 px-5 text-left text-xs font-medium uppercase text-gray-400">Nom</th>
                <th class="py-3 px-3 text-center text-xs font-medium uppercase text-gray-400 w-24">Ordre</th>
                <th class="py-3 px-5 text-center text-xs font-medium uppercase text-gray-400 w-28">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
            {% for f in families %}
                <tr class="hover:bg-gray-50/50">
                    <td class="py-3.5 px-5 font-medium text-gray-700">{{ f.name }}</td>
                    <td class="py-3.5 px-3 text-center">
                        <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-gray-100 text-gray-600 text-sm font-semibold">{{ f.sortOrder }}</span>
                    </td>
                    <td class="py-3.5 px-5">
                        <div class="flex items-center justify-center gap-1">
                            <button type="button"
                                    onclick="openEditFamilyModal({{ f.id }}, '{{ f.name|e('js') }}', {{ f.sortOrder }})"
                                    class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-blue-500 hover:bg-blue-50 transition-colors"
                                    title="Modifier">
                                <i class="fas fa-pen text-xs"></i>
                            </button>
                            <form method="post" action="{{ path('app_admin_family_delete', {id: f.id}) }}" onsubmit="return confirm('Supprimer la famille « {{ f.name|e('js') }} » ?')" class="inline">
                                <button class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors" title="Supprimer">
                                    <i class="fas fa-trash text-xs"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="py-12 text-center text-gray-400">Aucune famille</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# ══ MODAL AJOUTER ══ #}
    <div id="addModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <form method="post" action="{{ path('app_admin_family_create') }}" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="font-semibold text-[#1c2434]">Nouvelle famille</h3>
                <button type="button" onclick="closeModal('addModal')" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Nom *</label>
                    <input type="text" name="name" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Ordre d'affichage</label>
                    <input type="number" name="sort_order" value="{{ families|length * 10 }}" min="0" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="closeModal('addModal')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button>
                <button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white">Créer</button>
            </div>
        </form>
    </div>

    {# ══ MODAL MODIFIER ══ #}
    <div id="editModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <form id="editFamilyForm" method="post" action="" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="font-semibold text-[#1c2434]">Modifier la famille</h3>
                <button type="button" onclick="closeModal('editModal')" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Nom *</label>
                    <input type="text" id="editFamilyName" name="name" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Ordre d'affichage</label>
                    <input type="number" id="editFamilyOrder" name="sort_order" min="0" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
                    <p class="text-xs text-gray-400 mt-1">Les familles sont triées par ordre croissant</p>
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="closeModal('editModal')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button>
                <button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white"><i class="fas fa-save text-[10px] mr-1.5"></i> Enregistrer</button>
            </div>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        const FAMILY_EDIT_URL = '{{ path('app_admin_family_update', {id: '__ID__'}) }}';
        function openEditFamilyModal(id, name, order) {
            document.getElementById('editFamilyName').value  = name;
            document.getElementById('editFamilyOrder').value = order;
            document.getElementById('editFamilyForm').action = FAMILY_EDIT_URL.replace('__ID__', id);
            openModal('editModal');
        }
    </script>
{% endblock %}
