{% extends 'base.html.twig' %}
{% block title %}Catégories{% endblock %}
{% block page_title %}Catégories d'ingrédients{% endblock %}
{% block page_actions %}<button onclick="document.getElementById('addModal').classList.remove('hidden');document.getElementById('addModal').classList.add('flex')" class="inline-flex items-center gap-2 rounded-lg bg-blue-500 hover:bg-blue-600 px-4 py-2.5 text-sm font-medium text-white"><i class="fas fa-plus text-[11px]"></i> Ajouter</button>{% endblock %}
{% block body %}
<div class="rounded-2xl border border-gray-200 bg-white">
    <table class="w-full text-sm"><thead><tr class="border-b border-gray-100"><th class="py-3 px-5 text-left text-xs font-medium uppercase text-gray-400">Nom</th><th class="py-3 px-3 text-center text-xs font-medium uppercase text-gray-400">Ordre</th><th class="py-3 px-3 text-center text-xs font-medium uppercase text-gray-400">Ingrédients</th><th class="py-3 px-5 text-center text-xs font-medium uppercase text-gray-400">Actions</th></tr></thead>
    <tbody class="divide-y divide-gray-50">{% for c in categories %}<tr class="hover:bg-gray-50/50">
        <td class="py-3 px-5 font-medium text-gray-700">{{ c.name }}</td>
        <td class="py-3 px-3 text-center text-gray-500">{{ c.sortOrder }}</td>
        <td class="py-3 px-3 text-center text-gray-500">{{ c.ingredients|length }}</td>
        <td class="py-3 px-5 text-center"><form method="post" action="{{ path('app_admin_category_delete', {id: c.id}) }}" onsubmit="return confirm('Supprimer ?')" class="inline"><button class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50"><i class="fas fa-trash text-xs"></i></button></form></td>
    </tr>{% else %}<tr><td colspan="4" class="py-12 text-center text-gray-400">Aucune catégorie</td></tr>{% endfor %}</tbody></table>
</div>
<div id="addModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50" onclick="if(event.target===this){this.classList.add('hidden');this.classList.remove('flex')}">
<form method="post" action="{{ path('app_admin_category_create') }}" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4"><div class="px-6 py-4 border-b border-gray-100"><h3 class="font-semibold text-[#1c2434]">Nouvelle catégorie</h3></div><div class="p-6 space-y-4"><div><label class="block text-sm font-medium text-gray-600 mb-1.5">Nom *</label><input type="text" name="name" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div><div><label class="block text-sm font-medium text-gray-600 mb-1.5">Ordre</label><input type="number" name="sort_order" value="0" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div></div><div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3"><button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button><button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white">Créer</button></div></form></div>
{% endblock %}
