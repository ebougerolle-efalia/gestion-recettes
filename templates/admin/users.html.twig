{% extends 'base.html.twig' %}
{% block title %}Utilisateurs{% endblock %}
{% block page_title %}Utilisateurs{% endblock %}
{% block page_subtitle %}{{ users|length }} utilisateur{{ users|length > 1 ? 's' : '' }}{% endblock %}

{% block page_actions %}
    <button onclick="openModal('addModal')" class="inline-flex items-center gap-2 rounded-lg bg-blue-500 hover:bg-blue-600 px-4 py-2.5 text-sm font-medium text-white">
        <i class="fas fa-plus text-[11px]"></i> Ajouter
    </button>
{% endblock %}

{% block body %}
    <div class="rounded-2xl border border-gray-200 bg-white">
        <table class="w-full text-sm">
            <thead>
            <tr class="border-b border-gray-100 bg-gray-50/50">
                <th class="py-3 px-5 text-left text-xs font-medium uppercase text-gray-400">Identifiant</th>
                <th class="py-3 px-3 text-center text-xs font-medium uppercase text-gray-400">Rôle</th>
                <th class="py-3 px-3 text-center text-xs font-medium uppercase text-gray-400">Statut</th>
                <th class="py-3 px-5 text-center text-xs font-medium uppercase text-gray-400 w-28">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
            {% for u in users %}
                <tr class="hover:bg-gray-50/50 {{ not u.active ? 'opacity-50' }}">
                    <td class="py-3.5 px-5 font-medium text-gray-700">{{ u.username }}</td>
                    <td class="py-3.5 px-3 text-center">
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium {{ u.role == 'admin' ? 'bg-purple-50 text-purple-600' : (u.role == 'editor' ? 'bg-blue-50 text-blue-600' : 'bg-gray-100 text-gray-500') }}">{{ u.role }}</span>
                    </td>
                    <td class="py-3.5 px-3 text-center">
                        {% if u.active %}
                            <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-[11px] font-medium text-green-600">Actif</span>
                        {% else %}
                            <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-medium text-red-600">Inactif</span>
                        {% endif %}
                    </td>
                    <td class="py-3.5 px-5">
                        <div class="flex items-center justify-center gap-1">
                            <button type="button"
                                    onclick="openEditUserModal({{ u.id }}, '{{ u.username|e('js') }}', '{{ u.role|e('js') }}', {{ u.active ? 'true' : 'false' }})"
                                    class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-blue-500 hover:bg-blue-50 transition-colors"
                                    title="Modifier">
                                <i class="fas fa-pen text-xs"></i>
                            </button>
                            {% if u.id != app.user.id %}
                                <form method="post" action="{{ path('app_admin_user_delete', {id: u.id}) }}" onsubmit="return confirm('Supprimer l’utilisateur « {{ u.username|e('js') }} » ?')" class="inline">
                                    <button class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors" title="Supprimer">
                                        <i class="fas fa-trash text-xs"></i>
                                    </button>
                                </form>
                            {% else %}
                                <span class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-200 cursor-not-allowed" title="Vous ne pouvez pas supprimer votre propre compte">
                                    <i class="fas fa-trash text-xs"></i>
                                </span>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {# ══ MODAL AJOUTER ══ #}
    <div id="addModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <form method="post" action="{{ path('app_admin_user_create') }}" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="font-semibold text-[#1c2434]">Nouvel utilisateur</h3>
                <button type="button" onclick="closeModal('addModal')" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6 space-y-4">
                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Identifiant *</label><input type="text" name="username" required minlength="3" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div>
                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Mot de passe * (min 6)</label><input type="password" name="password" required minlength="6" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400"></div>
                <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Rôle</label>
                    <select name="role" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white">
                        <option value="reader">Lecteur</option>
                        <option value="editor" selected>Éditeur</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="closeModal('addModal')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button>
                <button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white">Créer</button>
            </div>
        </form>
    </div>

    {# ══ MODAL MODIFIER ══ #}
    <div id="editModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50">
        <form id="editUserForm" method="post" action="" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="font-semibold text-[#1c2434]">Modifier l'utilisateur</h3>
                <button type="button" onclick="closeModal('editModal')" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Identifiant</label>
                    <input type="text" id="editUserName" disabled class="w-full rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 text-sm text-gray-500 outline-none">
                    <p class="text-xs text-gray-400 mt-1">L'identifiant n'est pas modifiable</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Rôle</label>
                    <select id="editUserRole" name="role" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white">
                        <option value="reader">Lecteur</option>
                        <option value="editor">Éditeur</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Nouveau mot de passe (min 6)</label>
                    <input type="password" name="new_password" minlength="6" placeholder="Laisser vide pour ne pas changer" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400">
                </div>
                <label class="flex items-center gap-2.5 cursor-pointer select-none">
                    <input type="checkbox" id="editUserActive" name="is_active" value="1" class="w-4 h-4 rounded border-gray-300 text-blue-500 focus:ring-blue-400">
                    <span class="text-sm text-gray-600">Compte actif</span>
                </label>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
                <button type="button" onclick="closeModal('editModal')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button>
                <button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white"><i class="fas fa-save text-[10px] mr-1.5"></i> Enregistrer</button>
            </div>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        const USER_EDIT_URL = '{{ path('app_admin_user_update', {id: '__ID__'}) }}';
        function openEditUserModal(id, username, role, active) {
            document.getElementById('editUserName').value     = username;
            document.getElementById('editUserRole').value     = role;
            document.getElementById('editUserActive').checked = active;
            document.getElementById('editUserForm').action    = USER_EDIT_URL.replace('__ID__', id);
            openModal('editModal');
        }
    </script>
{% endblock %}
