{% extends 'base.html.twig' %}
{% block title %}Fournisseurs{% endblock %}
{% block page_title %}Fournisseurs{% endblock %}
{% block page_subtitle %}{{ suppliers|length }} fournisseur{{ suppliers|length > 1 ? 's' : '' }} enregistré{{ suppliers|length > 1 ? 's' : '' }}{% endblock %}

{% block body %}

{% if suppliers|length == 0 %}
<div class="rounded-2xl border border-gray-200 bg-white p-12 text-center">
    <i class="fas fa-truck text-4xl text-gray-200 mb-4 block"></i>
    <p class="text-gray-500 font-medium">Aucun fournisseur enregistré</p>
    <p class="text-sm text-gray-400 mt-1">Les fournisseurs sont créés automatiquement lors de l'import de factures Factur-X.</p>
    <a href="{{ path('app_invoice_import') }}"
       class="mt-5 inline-flex items-center gap-2 rounded-xl bg-blue-500 hover:bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors">
        <i class="fas fa-file-import text-[11px]"></i> Importer une facture
    </a>
</div>

{% else %}

{# ── KPIs globaux ── #}
{% set totalInvoices   = suppliers|map(s => s.invoice_count)|reduce((carry, v) => carry + v, 0) %}
{% set totalHt12m      = suppliers|map(s => s.total_ht_12m)|reduce((carry, v) => carry + v, 0) %}
{% set totalIngredients= suppliers|map(s => s.ingredient_count)|reduce((carry, v) => carry + v, 0) %}

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Fournisseurs</p>
        <p class="text-3xl font-bold text-[#1c2434] mt-1">{{ suppliers|length }}</p>
    </div>
    <div class="rounded-2xl border border-blue-100 bg-blue-50/40 px-5 py-4">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-blue-500">Factures importées</p>
        <p class="text-3xl font-bold text-blue-700 mt-1">{{ totalInvoices }}</p>
    </div>
    <div class="rounded-2xl border border-emerald-100 bg-emerald-50/40 px-5 py-4">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Achats 12 mois</p>
        <p class="text-3xl font-bold text-emerald-700 mt-1">{{ totalHt12m|number_format(0, ',', ' ') }} €</p>
        <p class="text-[10px] text-emerald-500 mt-1">HT</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Ingrédients sourcés</p>
        <p class="text-3xl font-bold text-[#1c2434] mt-1">{{ totalIngredients }}</p>
    </div>
</div>

{# ── Liste fournisseurs ── #}
<div class="rounded-2xl border border-gray-200 bg-white">
    <div class="px-6 py-4 border-b border-gray-100">
        <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-blue-500"></div>
            <h3 class="font-semibold text-[15px] text-[#1c2434]">Liste des fournisseurs</h3>
        </div>
    </div>

    <div class="overflow-x-auto">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-gray-100 bg-gray-50/50">
                <th class="py-3 px-5 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Fournisseur</th>
                <th class="py-3 px-4 text-center text-xs font-semibold uppercase tracking-wider text-gray-400">Factures</th>
                <th class="py-3 px-4 text-center text-xs font-semibold uppercase tracking-wider text-gray-400">Produits</th>
                <th class="py-3 px-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-400">Total HT (12m)</th>
                <th class="py-3 px-4 text-right text-xs font-semibold uppercase tracking-wider text-gray-400">Total HT (tout)</th>
                <th class="py-3 px-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Dernière facture</th>
                <th class="py-3 px-4 w-10"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
        {% for s in suppliers %}
        <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="py-3.5 px-5">
                <a href="{{ path('app_supplier_show', {id: s.id}) }}"
                   class="font-semibold text-[#1c2434] hover:text-blue-600 transition-colors block">
                    {{ s.name }}
                </a>
                <p class="text-[11px] text-gray-400 mt-0.5">
                    {% if s.city %}{{ s.city }}{% endif %}
                    {% if s.siret %} · SIRET {{ s.siret|slice(0,9) }}…{% endif %}
                </p>
            </td>
            <td class="py-3.5 px-4 text-center">
                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-blue-50 text-blue-700 font-semibold text-sm">
                    {{ s.invoice_count }}
                </span>
            </td>
            <td class="py-3.5 px-4 text-center">
                <span class="text-sm font-medium text-gray-700">{{ s.ingredient_count }}</span>
            </td>
            <td class="py-3.5 px-4 text-right">
                <span class="font-semibold text-emerald-700">
                    {{ s.total_ht_12m > 0 ? s.total_ht_12m|number_format(2, ',', ' ') ~ ' €' : '—' }}
                </span>
            </td>
            <td class="py-3.5 px-4 text-right">
                <span class="text-sm text-gray-600">
                    {{ s.total_ht_all > 0 ? s.total_ht_all|number_format(2, ',', ' ') ~ ' €' : '—' }}
                </span>
            </td>
            <td class="py-3.5 px-4">
                {% if s.last_invoice_date_computed %}
                    {% set d = s.last_invoice_date_computed %}
                    <span class="text-sm text-gray-600">{{ d|date('d/m/Y') }}</span>
                {% else %}
                    <span class="text-sm text-gray-300">—</span>
                {% endif %}
            </td>
            <td class="py-3.5 px-4 text-right">
                <a href="{{ path('app_supplier_show', {id: s.id}) }}"
                   class="text-gray-300 hover:text-blue-500 transition-colors">
                    <i class="fas fa-eye"></i>
                </a>
            </td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>

{% endif %}
{% endblock %}
