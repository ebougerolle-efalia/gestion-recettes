{% extends 'base.html.twig' %}
{% block title %}{{ supplier.name }}{% endblock %}
{% block page_title %}{{ supplier.name }}{% endblock %}
{% block page_subtitle %}Fournisseur · {{ invoices|length }} facture{{ invoices|length > 1 ? 's' : '' }} · {{ products|length }} produit{{ products|length > 1 ? 's' : '' }}{% endblock %}

{% block page_actions %}
<a href="{{ path('app_supplier_index') }}"
   class="inline-flex items-center gap-1.5 rounded-xl border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50 transition-colors">
    <i class="fas fa-arrow-left text-[10px]"></i> Fournisseurs
</a>
<a href="{{ path('app_invoice_import') }}"
   class="inline-flex items-center gap-1.5 rounded-xl bg-blue-500 hover:bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors">
    <i class="fas fa-file-import text-[10px]"></i> Importer une facture
</a>
{% endblock %}

{% block body %}

{# ── Fiche identité ── #}
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

    <div class="md:col-span-2 rounded-2xl border border-gray-200 bg-white px-6 py-5">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-[#1c2434] flex items-center justify-center flex-shrink-0">
                <i class="fas fa-truck text-white text-lg"></i>
            </div>
            <div class="flex-1">
                <h2 class="text-lg font-bold text-[#1c2434]">{{ supplier.name }}</h2>
                {% if supplier.fullAddress %}
                <p class="text-sm text-gray-500 mt-0.5">
                    <i class="fas fa-map-marker-alt text-[10px] mr-1"></i>{{ supplier.fullAddress }}
                </p>
                {% endif %}
                <div class="flex flex-wrap gap-3 mt-3">
                    {% if supplier.siret %}
                    <span class="text-[11px] bg-gray-50 border border-gray-200 rounded-lg px-2.5 py-1 font-mono text-gray-600">
                        SIRET {{ supplier.siret }}
                    </span>
                    {% endif %}
                    {% if supplier.vatNumber %}
                    <span class="text-[11px] bg-gray-50 border border-gray-200 rounded-lg px-2.5 py-1 font-mono text-gray-600">
                        TVA {{ supplier.vatNumber }}
                    </span>
                    {% endif %}
                    {% if supplier.country %}
                    <span class="text-[11px] bg-blue-50 border border-blue-100 rounded-lg px-2.5 py-1 text-blue-600">
                        {{ supplier.country }}
                    </span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
        <div class="rounded-2xl border border-blue-100 bg-blue-50/40 px-4 py-4 text-center">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-blue-500">Factures</p>
            <p class="text-3xl font-bold text-blue-700 mt-1">{{ invoices|length }}</p>
        </div>
        <div class="rounded-2xl border border-emerald-100 bg-emerald-50/40 px-4 py-4 text-center">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Produits</p>
            <p class="text-3xl font-bold text-emerald-700 mt-1">{{ products|length }}</p>
        </div>
        {% set totalHt = invoices|map(i => i.total_ht)|reduce((carry, v) => carry + v, 0) %}
        <div class="col-span-2 rounded-2xl border border-gray-200 bg-white px-4 py-4 text-center">
            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Total achats HT</p>
            <p class="text-2xl font-bold text-[#1c2434] mt-1">{{ totalHt|number_format(2, ',', ' ') }} €</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    {# ── Historique des factures ── #}
    <div class="rounded-2xl border border-gray-200 bg-white">
        <div class="px-5 py-4 border-b border-gray-100">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-blue-500"></div>
                <h3 class="font-semibold text-[15px] text-[#1c2434]">Factures importées</h3>
            </div>
        </div>
        {% if invoices|length > 0 %}
        <div class="divide-y divide-gray-50">
            {% for inv in invoices %}
            <div class="px-5 py-3.5 flex items-center justify-between gap-3">
                <div>
                    <p class="font-medium text-sm text-[#1c2434]">{{ inv.invoice_id }}</p>
                    <p class="text-[11px] text-gray-400 mt-0.5">
                        <i class="fas fa-calendar text-[9px] mr-1"></i>{{ inv.invoice_date }}
                        · importée le {{ inv.imported_at|date('d/m/Y') }}
                    </p>
                </div>
                <div class="text-right flex-shrink-0">
                    {% if inv.total_ht %}
                    <p class="font-semibold text-sm text-[#1c2434]">{{ inv.total_ht|number_format(2, ',', ' ') }} €</p>
                    <p class="text-[10px] text-gray-400">HT</p>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="px-5 py-8 text-sm text-gray-400 text-center">Aucune facture importée</p>
        {% endif %}
    </div>

    {# ── Produits achetés avec évolution des prix ── #}
    <div class="rounded-2xl border border-gray-200 bg-white">
        <div class="px-5 py-4 border-b border-gray-100">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                <h3 class="font-semibold text-[15px] text-[#1c2434]">Produits & évolution des prix</h3>
            </div>
        </div>
        {% if products|length > 0 %}
        <div class="divide-y divide-gray-50">
            {% for p in products %}
            {% set variation = p.prev_price and p.prev_price > 0
                ? ((p.last_price - p.prev_price) / p.prev_price * 100)|round(1)
                : null %}
            <div class="px-5 py-3.5">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex-1 min-w-0">
                        <a href="{{ path('app_ingredient_show', {id: p.ingredient_id}) }}"
                           class="font-medium text-sm text-[#1c2434] hover:text-blue-600 transition-colors truncate block">
                            {{ p.ingredient_name }}
                        </a>
                        <p class="text-[11px] text-gray-400 mt-0.5">
                            {{ p.purchase_count }} achat{{ p.purchase_count > 1 ? 's' : '' }}
                            · {{ p.base_unit }}
                            · dernier {{ p.last_purchase_date }}
                        </p>
                    </div>
                    <div class="flex-shrink-0 text-right">
                        <p class="font-bold text-sm text-[#1c2434]">{{ p.last_price|number_format(4, ',', ' ') }} €/{{ p.base_unit }}</p>
                        {% if variation is not null %}
                            {% if variation > 5 %}
                            <span class="text-[11px] font-semibold text-red-600">
                                <i class="fas fa-arrow-up text-[9px]"></i> +{{ variation }}%
                            </span>
                            {% elseif variation < -5 %}
                            <span class="text-[11px] font-semibold text-emerald-600">
                                <i class="fas fa-arrow-down text-[9px]"></i> {{ variation }}%
                            </span>
                            {% else %}
                            <span class="text-[11px] text-gray-400">
                                <i class="fas fa-minus text-[9px]"></i> {{ variation > 0 ? '+' : '' }}{{ variation }}%
                            </span>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                {# Sparkline mini (prix min → max) #}
                {% if p.price_min and p.price_max and p.price_min != p.price_max %}
                <div class="mt-2 flex items-center gap-2">
                    <span class="text-[10px] text-gray-400">{{ p.price_min|number_format(2, ',', ' ') }} €</span>
                    <div class="flex-1 h-1 bg-gray-100 rounded-full overflow-hidden">
                        {% set range = p.price_max - p.price_min %}
                        {% set lastPos = range > 0 ? ((p.last_price - p.price_min) / range * 100)|round : 100 %}
                        <div class="h-full rounded-full {{ variation > 5 ? 'bg-red-400' : (variation < -5 ? 'bg-emerald-400' : 'bg-blue-400') }}"
                             style="width: {{ lastPos }}%"></div>
                    </div>
                    <span class="text-[10px] text-gray-400">{{ p.price_max|number_format(2, ',', ' ') }} €</span>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="px-5 py-8 text-sm text-gray-400 text-center">Aucun produit associé</p>
        {% endif %}
    </div>

</div>

{% endblock %}
