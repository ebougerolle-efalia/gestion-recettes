# Environnement de test.
#
# Base SÉPARÉE de celle de développement : les tests fonctionnels naviguent sur
# des données de démonstration et ne doivent jamais toucher un jeu de travail.
#
# Préparation, une fois :
#   createdb recettes_test  (ou via docker compose exec database createdb -U recettes recettes_test)
#   APP_ENV=test php bin/console doctrine:migrations:migrate --no-interaction
#   APP_ENV=test php bin/console app:seed
#   APP_ENV=test php bin/console app:demo-data
APP_ENV=test
APP_DEBUG=1
DATABASE_URL="postgresql://recettes:recettes@127.0.0.1:5433/recettes_test?serverVersion=17&charset=utf8"
